<svg width="1024" height="1024" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#141b26"/>
      <stop offset="0.55" stop-color="#0a0e14"/>
      <stop offset="1" stop-color="#1a0f08"/>
    </linearGradient>
    <linearGradient id="acc" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffb01f"/>
      <stop offset="1" stop-color="#ff5a1f"/>
    </linearGradient>
    <radialGradient id="glow" cx="0.5" cy="0.32" r="0.7">
      <stop offset="0" stop-color="#ff5a1f" stop-opacity="0.30"/>
      <stop offset="1" stop-color="#ff5a1f" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <!-- background -->
  <rect width="1024" height="1024" rx="220" fill="url(#bg)"/>
  <rect width="1024" height="1024" rx="220" fill="url(#glow)"/>

  <!-- football -->
  <g transform="translate(512 430) rotate(-22)">
    <ellipse cx="0" cy="0" rx="232" ry="148" fill="#5a3210"/>
    <ellipse cx="0" cy="0" rx="232" ry="148" fill="none" stroke="#7a4a1c" stroke-width="10"/>
    <ellipse cx="0" cy="0" rx="200" ry="120" fill="none" stroke="#c9a24b" stroke-width="6" opacity="0.5"/>
    <!-- laces -->
    <line x1="-70" y1="0" x2="70" y2="0" stroke="#f4e9d0" stroke-width="14" stroke-linecap="round"/>
    <line x1="-58" y1="-26" x2="-58" y2="26" stroke="#f4e9d0" stroke-width="12" stroke-linecap="round"/>
    <line x1="-20" y1="-26" x2="-20" y2="26" stroke="#f4e9d0" stroke-width="12" stroke-linecap="round"/>
    <line x1="20"  y1="-26" x2="20"  y2="26" stroke="#f4e9d0" stroke-width="12" stroke-linecap="round"/>
    <line x1="58"  y1="-26" x2="58"  y2="26" stroke="#f4e9d0" stroke-width="12" stroke-linecap="round"/>
  </g>

  <!-- DYNASTY HC wordmark -->
  <text x="512" y="730" font-family="Oswald, Arial Narrow, sans-serif" font-weight="700"
        font-size="150" letter-spacing="6" text-anchor="middle" fill="#ffffff">DYNASTY</text>
  <text x="512" y="880" font-family="Oswald, Arial Narrow, sans-serif" font-weight="700"
        font-size="170" letter-spacing="10" text-anchor="middle" fill="url(#acc)">HC</text>
</svg>
