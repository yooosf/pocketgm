<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Dynasty HC">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#0a0e14">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icon-180.png">
<title>DYNASTY HC</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Barlow+Condensed:wght@400;500;600;700&family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0a0e14;
  --bg2:#0f1620;
  --panel:#141d2b;
  --panel2:#1a2535;
  --line:#243043;
  --line2:#2e3c52;
  --txt:#e8edf4;
  --txt2:#9fb0c5;
  --txt3:#647489;
  --accent:#ff5a1f;
  --accent2:#ffb01f;
  --green:#2ecc71;
  --green2:#1e9e57;
  --red:#ff4757;
  --blue:#3ba0ff;
  --gold:#ffd23f;
  --purple:#a974ff;
  --safe:#2ecc71;
  --warm:#ffb01f;
  --hot:#ff8c1f;
  --brink:#ff4757;
  --r:14px;
  --shadow:0 8px 30px rgba(0,0,0,.45);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{
  background:var(--bg);
  color:var(--txt);
  font-family:'Barlow',sans-serif;
  overflow:hidden;
  position:fixed;
  width:100%;
  -webkit-font-smoothing:antialiased;
}
/* time-of-day ambient backdrop (sits behind everything) */
#sky{position:fixed;inset:0;z-index:-2;transition:background 1.2s ease}
#skyglow{position:fixed;left:0;right:0;top:0;height:55%;z-index:-1;pointer-events:none;transition:opacity 1.2s ease,background 1.2s ease}
/* sun/moon orb + stars */
.celestial{position:fixed;z-index:-1;border-radius:50%;transition:all 1.4s ease;pointer-events:none}
.star{position:fixed;z-index:-1;background:#fff;border-radius:50%;pointer-events:none;animation:twinkle 4s ease-in-out infinite}
@keyframes twinkle{0%,100%{opacity:.25}50%{opacity:.9}}

/* daytime palette (lighter, warmer chrome over a bright sky) */
body.tod-day{--bg:#0e151f;--bg2:#131c28;--panel:#18222f;--panel2:#1e2a39;--accent:#ff6a2a;--accent2:#ffc24d;}
body.tod-dawn{--bg:#120f1a;--bg2:#181321;--panel:#1d1726;--panel2:#241c30;--accent:#ff7a3d;--accent2:#ffb05e;}
body.tod-dusk{--bg:#140d14;--bg2:#1a1119;--panel:#201521;--panel2:#281a29;--accent:#ff5a3c;--accent2:#ffa24d;}
body.tod-night{--bg:#080b12;--bg2:#0d121c;--panel:#121a28;--panel2:#172132;--accent:#ff5a1f;--accent2:#ffb01f;}
/* app translucency lets the sky bleed through; day is more open, night more solid */
body.tod-day  #app{background:color-mix(in srgb, var(--bg) 72%, transparent)}
body.tod-dawn #app{background:color-mix(in srgb, var(--bg) 80%, transparent)}
body.tod-dusk #app{background:color-mix(in srgb, var(--bg) 80%, transparent)}
body.tod-night #app{background:color-mix(in srgb, var(--bg) 88%, transparent)}
.condensed{font-family:'Barlow Condensed',sans-serif}
.display{font-family:'Oswald',sans-serif}
#app{height:100%;display:flex;flex-direction:column;max-width:540px;margin:0 auto;position:relative;background:color-mix(in srgb, var(--bg) 82%, transparent)}

/* scroll area */
#screen{flex:1;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;padding-bottom:80px}
#screen::-webkit-scrollbar{width:0}

/* top bar */
#topbar{
  background:linear-gradient(180deg,color-mix(in srgb,var(--bg2) 70%,transparent),color-mix(in srgb,var(--bg) 78%,transparent));
  backdrop-filter:blur(6px);
  border-bottom:1px solid var(--line);
  padding:10px 14px;display:flex;align-items:center;gap:10px;
  position:sticky;top:0;z-index:50;
  padding-top:calc(10px + env(safe-area-inset-top));
}
#topbar .tb-badge{width:38px;height:38px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-family:'Oswald';font-weight:700;font-size:15px;flex-shrink:0;box-shadow:inset 0 0 0 2px rgba(255,255,255,.15)}
#topbar .tb-info{flex:1;min-width:0}
#topbar .tb-title{font-family:'Oswald';font-weight:600;font-size:15px;letter-spacing:.3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#topbar .tb-sub{font-size:11px;color:var(--txt2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#topbar .tb-right{text-align:right;flex-shrink:0}
#topbar .tb-rank{font-family:'Oswald';font-weight:700;font-size:16px;color:var(--accent2)}
#topbar .tb-rec{font-size:11px;color:var(--txt2)}

/* bottom nav */
#nav{
  position:absolute;bottom:0;left:0;right:0;
  background:linear-gradient(0deg,var(--bg2),var(--panel));
  border-top:1px solid var(--line);
  display:flex;z-index:50;
  padding-bottom:env(safe-area-inset-bottom);
}
#nav button{
  flex:1;background:none;border:none;color:var(--txt3);
  padding:8px 2px 10px;font-family:'Barlow Condensed';font-weight:600;
  font-size:10px;letter-spacing:.4px;text-transform:uppercase;cursor:pointer;
  display:flex;flex-direction:column;align-items:center;gap:3px;transition:color .15s;
}
#nav button .ic{font-size:19px;line-height:1}
#nav button.active{color:var(--accent)}
#nav button.active .ic{filter:drop-shadow(0 0 6px rgba(255,90,31,.5))}

/* generic */
.pad{padding:14px}
.row{display:flex;align-items:center;gap:10px}
.col{display:flex;flex-direction:column}
.between{justify-content:space-between}
.center{align-items:center}
.wrap{flex-wrap:wrap}
.gap6{gap:6px}.gap8{gap:8px}.gap12{gap:12px}
.mt6{margin-top:6px}.mt10{margin-top:10px}.mt14{margin-top:14px}.mt20{margin-top:20px}
.mb6{margin-bottom:6px}.mb10{margin-bottom:10px}.mb14{margin-bottom:14px}
.tc{text-align:center}.tr{text-align:right}
.fg{flex:1}
.hide{display:none!important}
.muted,.mut{color:var(--txt2)}.dim{color:var(--txt3)}
.sm{font-size:12px}.xs{font-size:11px}.lg{font-size:18px}.xl{font-size:24px}
.b{font-weight:700}.up{text-transform:uppercase;letter-spacing:.5px}

h2.sec{font-family:'Oswald';font-weight:600;font-size:13px;text-transform:uppercase;letter-spacing:1.2px;color:var(--txt2);margin:18px 0 10px;display:flex;align-items:center;gap:8px}
h2.sec::before{content:'';width:3px;height:14px;background:var(--accent);border-radius:2px}

.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:14px;margin-bottom:12px}
.card.tight{padding:11px}
.subcard{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:11px}

.btn{
  background:var(--accent);color:#fff;border:none;border-radius:10px;
  padding:13px 18px;font-family:'Oswald';font-weight:600;font-size:14px;
  letter-spacing:.5px;text-transform:uppercase;cursor:pointer;transition:transform .08s,filter .15s;
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
}
.btn:active{transform:scale(.97)}
.btn.full{width:100%}
.searchbar.full,select.full,.full-w{width:100%}
.btn.lg{padding:16px;font-size:16px}
.btn.ghost{background:var(--panel2);color:var(--txt);border:1px solid var(--line2)}
.btn.green{background:var(--green2)}
.btn.red{background:var(--red)}
.btn.gold{background:linear-gradient(135deg,var(--accent2),var(--gold));color:#1a1206}
.btn.blue{background:var(--blue)}
.btn.sm{padding:8px 12px;font-size:12px;border-radius:8px}
.btn:disabled{opacity:.4;cursor:not-allowed}
.btn.outline{background:transparent;border:1.5px solid var(--accent);color:var(--accent)}

.chip{display:inline-flex;align-items:center;gap:5px;background:var(--panel2);border:1px solid var(--line2);border-radius:20px;padding:4px 11px;font-size:11px;font-weight:600;color:var(--txt2)}
.chip.accent{border-color:var(--accent);color:var(--accent)}
.chip.green{border-color:var(--green2);color:var(--green)}
.chip.red{border-color:var(--red);color:var(--red)}
.chip.gold{border-color:var(--gold);color:var(--gold)}

.pill{padding:3px 8px;border-radius:6px;font-size:10px;font-weight:700;font-family:'Barlow Condensed';text-transform:uppercase;letter-spacing:.5px;display:inline-block}

.stars{color:var(--gold);letter-spacing:1px;font-size:13px}
.stars .e{color:var(--line2)}

/* OVR ring */
.ovr{width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Oswald';font-weight:700;font-size:16px;flex-shrink:0;position:relative}
.ovr.sm{width:34px;height:34px;font-size:13px}

/* attribute bar */
.attr{margin-bottom:7px}
.attr .lbl{display:flex;justify-content:space-between;font-size:11px;margin-bottom:3px;color:var(--txt2)}
.attr .lbl b{color:var(--txt);font-family:'Oswald'}
.bar{height:6px;background:var(--bg);border-radius:4px;overflow:hidden}
.bar>div{height:100%;border-radius:4px;transition:width .4s}

/* avatar badge */
.av{border-radius:9px;display:flex;align-items:center;justify-content:center;font-family:'Oswald';font-weight:700;flex-shrink:0;color:#fff;box-shadow:inset 0 0 0 2px rgba(255,255,255,.12)}
.pavatar{position:relative;flex-shrink:0;border-radius:12px;overflow:visible}
.pavatar svg{display:block;border-radius:12px;box-shadow:inset 0 0 0 2px rgba(255,255,255,.10)}
.pavatar-badge{position:absolute;right:-4px;bottom:-4px;min-width:18px;height:18px;padding:0 3px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-family:'Oswald';font-weight:700;font-size:11px;color:#06121f;border:2px solid var(--panel);line-height:1}

/* meter */
.meter{height:10px;border-radius:6px;background:var(--bg);overflow:hidden;position:relative}
.meter>div{height:100%;transition:width .5s}

/* list item */
.li{display:flex;align-items:center;gap:11px;padding:11px;background:var(--panel);border:1px solid var(--line);border-radius:11px;margin-bottom:8px;cursor:pointer;transition:border-color .15s,background .15s}
.li:active{background:var(--panel2)}
.li.sel{border-color:var(--accent);background:rgba(255,90,31,.07)}

/* tabs */
.tabs{display:flex;gap:6px;background:var(--panel);border:1px solid var(--line);border-radius:11px;padding:4px;margin-bottom:12px;overflow-x:auto}
.tabs::-webkit-scrollbar{height:0}
.tabs button{flex:1;white-space:nowrap;background:none;border:none;color:var(--txt2);padding:9px 12px;font-family:'Barlow Condensed';font-weight:600;font-size:13px;text-transform:uppercase;letter-spacing:.5px;border-radius:8px;cursor:pointer}
.tabs button.active{background:var(--accent);color:#fff}

/* modal */
#modal-wrap{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:200;display:none;align-items:flex-end;justify-content:center;backdrop-filter:blur(3px)}
#modal-wrap.show{display:flex}
#modal{background:var(--bg2);border:1px solid var(--line2);border-radius:18px 18px 0 0;width:100%;max-width:540px;max-height:88vh;overflow-y:auto;padding:18px;animation:slideUp .25s ease}
#modal::-webkit-scrollbar{width:0}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.modal-grab{width:40px;height:4px;background:var(--line2);border-radius:3px;margin:0 auto 14px}

/* fullscreen cutscene */
#cut{position:fixed;inset:0;z-index:300;display:none;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:30px;padding-top:calc(30px + env(safe-area-inset-top));padding-bottom:calc(30px + env(safe-area-inset-bottom));overflow:hidden;background-color:var(--bg)}
#cut .av,#cut .pavatar,#cut .ovr,#cut svg{margin-left:auto;margin-right:auto}
#cut .card,#cut .subcard,#cut .statbox{margin-left:auto;margin-right:auto}
#cut.show{display:flex;animation:fadeIn .4s}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}

/* toast */
#toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:var(--panel2);border:1px solid var(--line2);color:var(--txt);padding:11px 18px;border-radius:30px;font-size:13px;font-weight:600;z-index:400;opacity:0;transition:opacity .3s,transform .3s;pointer-events:none;box-shadow:var(--shadow);max-width:90%;text-align:center}
#toast.show{opacity:1;transform:translateX(-50%) translateY(-6px)}

/* news */
.news{padding:11px;border-left:3px solid var(--line2);background:var(--panel);border-radius:0 10px 10px 0;margin-bottom:8px}
.news.big{border-left-color:var(--accent)}
.news.good{border-left-color:var(--green)}
.news.bad{border-left-color:var(--red)}
.news .nh{font-family:'Oswald';font-weight:600;font-size:13px;margin-bottom:3px}
.news .nb{font-size:12px;color:var(--txt2);line-height:1.4}

.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}

.statbox{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:11px;text-align:center}
.statbox .v{font-family:'Oswald';font-weight:700;font-size:22px;line-height:1}
.statbox .l{font-size:10px;color:var(--txt2);text-transform:uppercase;letter-spacing:.5px;margin-top:4px}

table.tbl{width:100%;border-collapse:collapse;font-size:12px}
table.tbl th{text-align:left;color:var(--txt3);font-weight:600;font-size:10px;text-transform:uppercase;letter-spacing:.5px;padding:7px 6px;border-bottom:1px solid var(--line)}
table.tbl td{padding:8px 6px;border-bottom:1px solid var(--line)}
table.tbl tr.me td{background:rgba(255,90,31,.08)}
table.tbl tr:active td{background:var(--panel2)}

.searchbar{width:100%;background:var(--panel2);border:1px solid var(--line2);border-radius:10px;padding:11px 14px;color:var(--txt);font-family:'Barlow';font-size:14px;margin-bottom:10px}
.searchbar:focus{outline:none;border-color:var(--accent)}

select.sel{background:var(--panel2);border:1px solid var(--line2);color:var(--txt);border-radius:9px;padding:9px 12px;font-family:'Barlow';font-size:13px;font-weight:600}

.divider{height:1px;background:var(--line);margin:14px 0}

.bignum{font-family:'Oswald';font-weight:700;line-height:.95;font-size:22px}

/* slider */
input[type=range]{-webkit-appearance:none;width:100%;height:6px;background:var(--bg);border-radius:4px;outline:none}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;border-radius:50%;background:var(--accent);cursor:pointer;box-shadow:0 0 0 4px rgba(255,90,31,.2)}

.fade-in{animation:fadeIn .3s}
.confetti{position:absolute;width:10px;height:10px;top:-20px;animation:fall linear forwards}
@keyframes fall{to{transform:translateY(110vh) rotate(720deg);opacity:.3}}

.flash-good{animation:flashGood .6s}
@keyframes flashGood{0%,100%{background:var(--panel)}50%{background:rgba(46,204,113,.2)}}
</style>
</head>
<body>
<div id="sky"></div>
<div id="skyglow"></div>
<div id="app">
  <div id="topbar"></div>
  <div id="screen"></div>
  <div id="nav"></div>
</div>
<div id="modal-wrap"><div id="modal"></div></div>
<div id="cut"></div>
<div id="toast"></div>

<script>
/* ============================================================================
   DYNASTY HC — College Football Coach Career Simulator
   Single-file build. Vanilla JS. localStorage save.
   ============================================================================ */

/* ---------------------------------------------------------------------------
   SECTION A — CONFIG (all tunable balance constants)
   --------------------------------------------------------------------------- */
const CONFIG = {
  VERSION: '1.0',
  SAVE_KEY: 'dynastyHC_save_v1',

  // Money (real 2025-26 rules)
  REVSHARE_CAP_BASE: 20.5,        // $M per school, 2025-26
  REVSHARE_CAP_GROWTH: 0.04,      // ~4% annually
  FOOTBALL_SHARE_MIN: 0.62,       // football gets ~62-78% of cap
  FOOTBALL_SHARE_MAX: 0.78,
  NIL_DEAL_CLEAR_THRESHOLD: 0.6,  // $600k+ deals (in $M units = 0.6) get compliance flagged
  START_YEAR: 2026,

  // Roster (post-House)
  ROSTER_LIMIT: 105,
  ROSTER_MIN: 85,

  // Playoff
  PLAYOFF_TEAMS: 12,              // easily changeable to 14/16
  P4_AUTO_BIDS: 4,                // 4 highest P4 conf champs
  G6_AUTO_BIDS: 1,                // highest-ranked Group of 6 team
  FIRST_ROUND_BYES: 4,

  // Recruiting
  RECRUITS_PER_CLASS: 360,        // blue-chip relevant pool (abstracted from 3000+)
  RECRUIT_POINTS_BASE: 22,        // weekly recruiting energy
  CLASS_SIZE_TARGET: 22,
  COMMIT_THRESHOLD: 78,           // interest needed to commit

  // Development
  DEV_BASE: 1.0,
  AGE_PEAK: 'JR',

  // Season
  REG_SEASON_GAMES: 12,

  // Coach progression
  REP_START: 25,
};

/* ---------------------------------------------------------------------------
   SECTION B — NAME BANKS (procedural generation)
   --------------------------------------------------------------------------- */
const NAMES = {
  first: ['James','Marcus','Tyler','DeShawn','Jaylen','Cooper','Brayden','Malik','Xavier','Trevon','Cameron','Jordan','Isaiah','Dante','Brock','Carson','Jaxon','Aiden','Lamar','Trey','Devin','Quentin','Damarion','Khalil','Bryce','Hunter','Mason','Elijah','Caleb','Nico','Drake','Jameson','Rashad','Tariq','Donovan','Kendrick','Amari','Zion','Cade','Gavin','Jace','Keon','Demetrius','Tobias','Roman','Silas','Beau','Knox','Ace','Maddox','Cyrus','Ezra','Kai','Reggie','Antoine','Travon','Jalen','Darnell','Marquise','Sincere','Tre','Bo','Will','Jack','Luke','Owen','Grant','Chase','Blake','Connor','Garrett','Logan','Reese','Wyatt','Jaden','Trent','Kobe','Deion'],
  last: ['Williams','Johnson','Carter','Robinson','Jackson','Thompson','Harris','Walker','Brooks','Bennett','Mitchell','Coleman','Sanders','Bryant','Foster','Reed','Hayes','Parker','Russell','Griffin','Watkins','Dixon','Crawford','Stewart','Jennings','Boyd','Holland','Frazier','Spencer','Ferguson','Pierce','McCoy','Mosley','Whitfield','Lattimore','Beckham','Devonte','Okafor','Adeyemi','Nwosu','Tanaka','Lombardi','Castillo','Vasquez','Mendez','Kowalski','Petrov','Anderson','Webb','Maddox','Sterling','Vance','Holloway','Greenwood','Ashby','Calloway','Drummond','Easton','Fairfield','Galloway','Hartwell','Kingsley','Lockhart','Marsh','Nash','Prescott','Quincy','Rhodes','Slade','Tate','Underwood','Voss','Wexler','York','Ziegler','Beckett','Cromwell','Delaney'],
  coachFirst: ['Mike','Nick','Dabo','Kirby','Lincoln','Brian','Dan','Lane','Hugh','Matt','Bret','Mario','Kalen','Sherrone','Ryan','Curt','Jeff','Steve','Bill','Tom','Chip','Gus','Sonny','Josh','Luke','Pete','Jimbo','Kyle','Shane','Willie','Manny','Scott','Dave','Chad','Eli','Vance','Troy','Hank','Buddy','Skip'],
  coachLast: ['Saban','Swinney','Riley','Smart','Day','Kelly','Lanning','Kiffin','Freeze','Rhule','DeBoer','Cristobal','Moore','Stoops','Norvell','Drinkwitz','Lashlee','Whittingham','Beamer','Fickell','Leach','Holgorsen','Malzahn','Venables','Brohm','Campbell','Heupel','Sumlin','Tucker','Aranda','Pittman','Allen','Hartman','Boone','Galloway','Mercer','Whitlock','Sterns','Vincent','Boatright'],
};

const CITIES = ['Easthaven','Westridge','Clarendon','Fairmont','Brookside','Lakeport','Summit','Granger','Millbrook','Cedar Falls','Crestline','Ironton','Harborview','Pinecrest','Stonebridge','Mapleton','Riverton','Oakdale','Lawson','Bridgeport','Kingsport','Marshall','Carthage','Auburn Hills','Greenville','Springvale','Dover','Brighton','Hartwell','Calhoun','Tremont','Belmont','Vandalia','Sutton','Galloway','Whitfield','Roanwood','Castleton','Ashford','Norwich','Pemberton','Drayton','Hollow Creek','Aurora','Tallgrass','Red Rock','Coldwater','Saltmarsh','Goldcoast','Bayou City'];

const MASCOTS = ['Wolves','Thunder','Pioneers','Hawks','Titans','Miners','Cyclones','Aviators','Mariners','Ironmen','Stallions','Raptors','Outlaws','Bobcats','Grizzlies','Mustangs','Vikings','Rangers','Cougars','Bulldogs','Wildcats','Eagles','Panthers','Lumberjacks','Bison','Sentinels','Knights','Crusaders','Hurricanes','Cardinals','Falcons','Lions','Tigers','Bears','Rams','Spartans','Gators','Razorbacks','Volunteers','Sooners','Cornhuskers','Buckeyes','Wolverines','Aggies','Longhorns','Badgers','Hoosiers','Terrapins','Demons','Phoenix','Dragons','Vipers','Cobras','Scorpions','Mavericks','Comets','Blazers','Storm','Force','Surge'];

/* color palettes for teams [primary, secondary] */
const PALETTES = [
  ['#9e1b32','#ffffff'],['#0b2265','#c4972a'],['#154734','#fb4f14'],['#4d1979','#ffc72c'],
  ['#bb0000','#000000'],['#003087','#ffcc00'],['#522d80','#cfb87c'],['#841617','#ebebeb'],
  ['#018749','#ffc425'],['#00274c','#ffcb05'],['#990000','#cccccc'],['#e87722','#161616'],
  ['#0c2340','#f56600'],['#7a0019','#ffcc33'],['#003594','#ce1126'],['#582c83','#b3a369'],
  ['#0021a5','#fa4616'],['#b3995d','#000000'],['#c8102e','#a2aaad'],['#13294b','#e84a27'],
  ['#005030','#f47920'],['#00843d','#000000'],['#2c1a4a','#e87500'],['#8b0000','#ffd700'],
  ['#1d428a','#ffc72c'],['#660015','#999999'],['#003f87','#cf4520'],['#00563f','#c5b783'],
  ['#bf2f38','#003366'],['#41b6e6','#13294b'],['#0033a0','#bcaa76'],['#6a2c3e','#d4bf91'],
];

const ARCHETYPES = {
  QB:['Pro-Style QB','Dual-Threat QB','Field General','Scrambler'],
  RB:['Power Back','Elusive Back','Receiving Back','Workhorse'],
  WR:['Deep Threat','Possession WR','Slot Specialist','Physical WR'],
  TE:['Receiving TE','Blocking TE','Move TE'],
  OL:['Pass Protector','Road Grader','Athletic OL'],
  DL:['Edge Rusher','Run Stuffer','Power DL','Speed Rusher'],
  LB:['Coverage LB','Thumper','Blitzing LB','Sideline-to-Sideline'],
  CB:['Lockdown CB','Slot CB','Press CB','Ballhawk'],
  S:['Free Safety','Strong Safety','Hybrid S'],
  K:['Power Kicker','Accurate Kicker'],
};
const POSITIONS = ['QB','RB','WR','TE','OL','DL','LB','CB','S','K'];
const POS_COUNT = {QB:3,RB:4,WR:7,TE:3,OL:9,DL:8,LB:6,CB:5,S:4,K:2}; // ideal depth ~51 base, fills to roster

const RECRUIT_PERSONALITIES = ['Loyal','Mercurial','Hype-Chaser','Family-First','Money-Motivated','Hometown-Hero'];
const DEV_TRAITS = ['Early Bloomer','Late Bloomer','Steady','Bust Risk','Hidden Gem','Steady','Steady']; // weighted
const MOTIVATIONS = ['Playing Time','Winning','NIL Money','Develop for NFL','Proximity','Academics','Coaching Stability','Conference Prestige','Facilities'];

const BACKSTORY = {
  origin:['grew up in a tight-knit football town','was raised by a single mother who worked two jobs','comes from a family of athletes','moved three times before high school','was homeschooled until 9th grade','grew up on a farm','is the youngest of five siblings','starred in three sports at his high school','was a varsity starter as a freshman','transferred to a powerhouse program for his junior year'],
  adversity:['overcame a torn ACL as a sophomore','was barely recruited until a breakout junior season','battled through his parents\' divorce','lost a close friend and dedicates every game to him','was told he was too small to play at the next level','grew six inches between his sophomore and senior years','rehabbed a broken leg for nine months','went from a zero-star afterthought to a national name'],
  why:['wants to be the first in his family to go to college','dreams of one day reaching the NFL','plays with a chip on his shoulder','wants to win a state title before he graduates','idolizes a former player from his hometown','is driven by recruiters who counted him out','wants to make his grandparents proud'],
};

const COACH_ARCHETYPES = [
  {id:'off',name:'Offensive Guru',desc:'Recruits skill players better; offense develops faster.',tilt:{Offense:18,Recruiting:6,PlayerDev:4}},
  {id:'def',name:'Defensive Mastermind',desc:'Defense develops faster; great at flipping recruits late.',tilt:{Defense:18,Recruiting:8}},
  {id:'players',name:"Player's Coach",desc:'Better development & morale; lower transfer-out rate.',tilt:{PlayerDev:14,Motivation:10,Discipline:6}},
  {id:'ceo',name:'CEO / Program Builder',desc:'Better fundraising, facilities, NIL & staff hires.',tilt:{Fundraising:18,MediaSavvy:8}},
  {id:'savant',name:'Recruiting Savant',desc:'Huge recruiting boost; weaker in-game tactics early.',tilt:{Recruiting:22,ScoutingEye:10,GameMgmt:-8}},
  {id:'disc',name:'Disciplinarian',desc:'Fewer incidents; slower but stickier development.',tilt:{Discipline:18,Defense:6,Motivation:6}},
];

const COACH_TRAITS = [
  {id:'riverboat',name:'Riverboat Gambler',icon:'🎲',desc:'Aggressive on 4th downs — high risk, high reward.'},
  {id:'closer',name:'Recruiting Closer',icon:'🤝',desc:'Big boost to landing recruits who visit.'},
  {id:'portal',name:'Portal King',icon:'🔁',desc:'Edge in transfer portal bidding.'},
  {id:'clock',name:'Clock Wizard',icon:'⏱️',desc:'Superb late-game clock & timeout management.'},
  {id:'hothead',name:'Hot Head',icon:'🔥',desc:'More sideline penalties and media incidents.'},
  {id:'loyal',name:'Loyal',icon:'🛡️',desc:'Less likely to be poached; AD trusts you more.'},
  {id:'merc',name:'Mercenary',icon:'💼',desc:'More job offers come your way.'},
  {id:'genius',name:'Genius Schemer',icon:'🧠',desc:'Teams overperform their talent.'},
  {id:'burnout',name:'Burnout Risk',icon:'🪫',desc:'Stats decay if you grind seasons without a title.'},
  {id:'developer',name:'Developer',icon:'📈',desc:'Players develop noticeably faster.'},
];

/* ---------------------------------------------------------------------------
   SECTION C — UTILITY FUNCTIONS
   --------------------------------------------------------------------------- */
let SEED = Date.now() % 2147483647;
function rng(){ SEED = (SEED*16807) % 2147483647; return (SEED-1)/2147483646; }
function rnd(a,b){ return a + rng()*(b-a); }
function rndi(a,b){ return Math.floor(rnd(a,b+1)); }
function pick(arr){ return arr[Math.floor(rng()*arr.length)]; }
function pickN(arr,n){ const c=[...arr],o=[]; for(let i=0;i<n&&c.length;i++){o.push(c.splice(Math.floor(rng()*c.length),1)[0]);} return o; }
function clamp(v,a,b){ return Math.max(a,Math.min(b,v)); }
function shuffle(arr){ const a=[...arr]; for(let i=a.length-1;i>0;i--){const j=Math.floor(rng()*(i+1));[a[i],a[j]]=[a[j],a[i]];} return a; }
function id(){ return Math.random().toString(36).slice(2,10); }
function $(sel){ return document.querySelector(sel); }
function el(tag,cls,html){ const e=document.createElement(tag); if(cls)e.className=cls; if(html!=null)e.innerHTML=html; return e; }
function money(m){ if(m>=1) return '$'+m.toFixed(1)+'M'; return '$'+Math.round(m*1000)+'K'; }
function ordinal(n){ const s=['th','st','nd','rd'],v=n%100; return n+(s[(v-20)%10]||s[v]||s[0]); }
function genName(){ return pick(NAMES.first)+' '+pick(NAMES.last); }
function genCoachName(){ return pick(NAMES.coachFirst)+' '+pick(NAMES.coachLast); }

// normal-ish distribution for ratings
function gauss(mean,sd){ let u=0,v=0; while(u===0)u=rng(); while(v===0)v=rng(); return mean + sd*Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v); }
function ratingFromStars(stars){
  const base={2:58,3:68,4:78,5:88}[stars]||60;
  return clamp(Math.round(gauss(base,5)),40,99);
}
function ovrColor(o){
  if(o>=88)return '#a974ff'; if(o>=80)return 'var(--gold)'; if(o>=72)return 'var(--green)'; if(o>=64)return 'var(--blue)'; return 'var(--txt3)';
}
function starHTML(n){
  let h=''; for(let i=0;i<5;i++)h+= i<n?'★':'<span class="e">★</span>'; return '<span class="stars">'+h+'</span>';
}
function meterColor(v){
  if(v>=70)return 'var(--green)'; if(v>=45)return 'var(--accent2)'; if(v>=25)return 'var(--hot)'; return 'var(--red)';
}
function initials(name){ return name.split(' ').map(w=>w[0]).join('').slice(0,3).toUpperCase(); }

function toast(msg){
  const t=$('#toast'); t.innerHTML=msg; t.classList.add('show');
  clearTimeout(t._t); t._t=setTimeout(()=>t.classList.remove('show'),2200);
}

/* ---------------------------------------------------------------------------
   SECTION D — WORLD GENERATION
   --------------------------------------------------------------------------- */

// 2026 conference structure. Teams-per-conf approximate the real counts.
const CONFERENCES = [
  {id:'sec',name:'SEC',tier:'P4',n:16,prestige:[70,98]},
  {id:'big10',name:'Big Ten',tier:'P4',n:18,prestige:[68,97]},
  {id:'acc',name:'ACC',tier:'P4',n:17,prestige:[58,92]},
  {id:'big12',name:'Big 12',tier:'P4',n:16,prestige:[55,88]},
  {id:'amer',name:'American',tier:'G6',n:14,prestige:[40,68]},
  {id:'mwc',name:'Mountain West',tier:'G6',n:12,prestige:[38,66]},
  {id:'mac',name:'MAC',tier:'G6',n:12,prestige:[34,58]},
  {id:'sun',name:'Sun Belt',tier:'G6',n:14,prestige:[36,62]},
  {id:'cusa',name:'Conference USA',tier:'G6',n:10,prestige:[32,56]},
  {id:'pac',name:'Pac-12',tier:'G6',n:8,prestige:[44,70]},
  {id:'ind',name:'Independent',tier:'IND',n:1,prestige:[80,80]}, // ND-equivalent
];

let usedNames = new Set();
function genTeamName(){
  let nm, tries=0;
  do {
    const city = pick(CITIES);
    const masc = pick(MASCOTS);
    nm = {city, masc, full: city+' '+masc, short: city};
    tries++;
  } while(usedNames.has(nm.full) && tries<50);
  usedNames.add(nm.full);
  return nm;
}

function genCoachActor(prestige){
  const skill = clamp(Math.round(gauss(prestige*0.7+20, 12)),20,96);
  return {
    id:id(), name:genCoachName(),
    rep: skill, skill,
    age: rndi(35,64),
    wins:rndi(0,180), titles:0, confTitles:rndi(0,4),
    tenure: rndi(0,8),
    isPlayer:false,
    treeOf:null,
  };
}

function genPlayer(teamPrestige, forcedPos, classYear){
  const pos = forcedPos || pick(POSITIONS);
  // talent correlates to team prestige
  const starRoll = rng();
  let stars;
  const pf = teamPrestige/100;
  if(starRoll < 0.02+pf*0.12) stars=5;
  else if(starRoll < 0.12+pf*0.30) stars=4;
  else if(starRoll < 0.55+pf*0.20) stars=3;
  else stars=2;
  const ovr = ratingFromStars(stars) - rndi(0,6); // current is below ceiling
  const ceiling = clamp(ovr + rndi(2,18),ovr,99);
  const yr = classYear || pick(['FR','FR','SO','SO','JR','JR','SR']);
  return {
    id:id(), name:genName(), pos, archetype:pick(ARCHETYPES[pos]),
    stars, ovr:clamp(ovr,40,99), ceiling,
    year:yr, redshirt:false,
    age: {FR:18,SO:19,JR:20,SR:21,'RS-FR':19,'RS-SO':20,'RS-JR':21,'RS-SR':22}[yr]||19,
    devTrait: pick(DEV_TRAITS),
    morale: rndi(55,85),
    durability: rndi(50,95),
    nil: 0,
    injury:null,
    personality: pick(['Vocal Leader','Quiet Worker','Hothead','Team Player','Diva','Coachable']),
    starter:false,
    seasonStats:{},
  };
}

function genRoster(prestige){
  const roster=[];
  for(const pos of POSITIONS){
    const n = POS_COUNT[pos] + rndi(0,2);
    for(let i=0;i<n;i++) roster.push(genPlayer(prestige,pos));
  }
  // fill toward roster floor
  while(roster.length < CONFIG.ROSTER_MIN) roster.push(genPlayer(prestige));
  return roster;
}

function buildWorld(){
  usedNames = new Set();
  const teams=[];
  let tid=0;
  for(const conf of CONFERENCES){
    for(let i=0;i<conf.n;i++){
      const prestige = Math.round(rnd(conf.prestige[0],conf.prestige[1]));
      const nm = conf.id==='ind' ? {city:'Notre Dame Valley',masc:'Crusaders',full:'Notre Dame Valley Crusaders',short:'ND Valley'} : genTeamName();
      const pal = pick(PALETTES);
      const t = {
        id:'t'+(tid++), conf:conf.id, confName:conf.name, tier:conf.tier,
        city:nm.city, masc:nm.masc, name:nm.full, short:nm.short,
        abbr: (nm.city.slice(0,2)+nm.masc.slice(0,1)).toUpperCase(),
        prestige,
        colors: pal,
        fanbase: clamp(Math.round(gauss(prestige,15)),20,99),
        facilities: clamp(Math.round(gauss(prestige-5,15)),20,99),
        academics: rndi(40,95),
        nilStrength: clamp(Math.round(gauss(prestige-3,16)),15,99),
        marketSize: rndi(25,99),
        capacity: Math.round(rnd(25,100))*1000,
        weather: pick(['Warm','Cold','Dome','Mild','Snow Belt']),
        histWins: rndi(200,900),
        natTitles: prestige>85 ? rndi(0,7) : (prestige>70?rndi(0,2):0),
        coach: genCoachActor(prestige),
        roster: genRoster(prestige),
        rivals:[],
        // season tracking
        w:0,l:0,cw:0,cl:0,
        apRank:0, cfpRank:0,
        revShareBudget:0, nilBudget:0, spent:0,
      };
      teams.push(t);
    }
  }
  // assign rivals within conference
  for(const conf of CONFERENCES){
    const ct = teams.filter(t=>t.conf===conf.id);
    for(const t of ct){
      const others = ct.filter(o=>o.id!==t.id);
      const nr = Math.min(rndi(1,2), others.length);
      t.rivals = pickN(others,nr).map(o=>o.id);
    }
  }
  return teams;
}

/* ---------------------------------------------------------------------------
   SECTION E — RECRUIT GENERATION
   --------------------------------------------------------------------------- */
function genRecruit(rankSeed){
  // rankSeed 0..1 — lower = better
  let stars;
  if(rankSeed<0.03) stars=5; else if(rankSeed<0.18) stars=4; else if(rankSeed<0.6) stars=3; else stars=2;
  const pos = pick(POSITIONS);
  const trueOvr = clamp(Math.round(ratingFromStars(stars)+gauss(0,4)),45,99);
  const ceiling = clamp(trueOvr+rndi(3,22),trueOvr,99);
  // scouted ranges: wide initially
  const spread = rndi(8,16);
  const homeConf = pick(CONFERENCES.filter(c=>c.id!=='ind'));
  const motivWeights={};
  const ms = shuffle(MOTIVATIONS);
  ms.forEach((m,i)=> motivWeights[m]= clamp(Math.round(gauss(50- i*5,18)),5,99));
  return {
    id:id(), name:genName(), pos, archetype:pick(ARCHETYPES[pos]), stars,
    trueOvr, ceiling,
    scout: 0, // 0..100 how much scouted
    ovrLow: clamp(trueOvr-spread,40,99), ovrHigh: clamp(trueOvr+spread,40,99),
    devTrait: pick(DEV_TRAITS),
    personality: pick(RECRUIT_PERSONALITIES),
    homeState: pick(CITIES), homeConf: homeConf.id,
    motivations: motivWeights,
    dreamSchool: null, // set after world built
    backstory: pick(BACKSTORY.origin)+'. He '+pick(BACKSTORY.adversity)+', and '+pick(BACKSTORY.why)+'.',
    interest: {}, // teamId -> 0..100
    committed: null, // teamId
    signed: false,
    natRank: 0, posRank:0,
    visited: {}, // teamId -> true
  };
}

function genRecruitClass(){
  const pool=[];
  for(let i=0;i<CONFIG.RECRUITS_PER_CLASS;i++){
    pool.push(genRecruit(i/CONFIG.RECRUITS_PER_CLASS));
  }
  // sort by trueOvr to assign national ranks
  pool.sort((a,b)=> b.trueOvr - a.trueOvr || b.ceiling-a.ceiling);
  pool.forEach((r,i)=> r.natRank=i+1);
  // position ranks
  const byPos={};
  pool.forEach(r=>{ byPos[r.pos]=(byPos[r.pos]||0)+1; r.posRank=byPos[r.pos]; });
  return pool;
}

/* ---------------------------------------------------------------------------
   SECTION F — GAME STATE
   --------------------------------------------------------------------------- */
let G = null; // global game state

function newGameState(){
  return {
    version: CONFIG.VERSION,
    year: CONFIG.START_YEAR,
    week: 0,
    phase: 'preseason', // preseason | regular | confchamp | playoff | bowls | awards | carousel | signing | offseason
    teams: [],
    recruits: [],
    coach: null,
    myTeamId: null,
    news: [],
    schedule: [],          // my team's schedule for the season
    allGamesThisWeek: [],
    apPoll: [],            // ordered team ids
    cfpRank: [],
    history: [],           // {year, champ, myRecord, ...}
    natChamps: [],         // past champion team ids per year
    jobSecurity: 50,       // 0-100, higher worse (hot seat)
    adExpectation: null,
    contract: null,
    recruitPoints: CONFIG.RECRUIT_POINTS_BASE,
    board: [],             // recruit ids on my board
    portal: [],            // players in portal
    portalBoard: [],
    careerLog: [],         // jobs held
    allTimeWinsRank: [],
    seed: SEED,
  };
}

/* ---------------------------------------------------------------------------
   SECTION G — SAVE / LOAD
   --------------------------------------------------------------------------- */
function save(){
  if(!G) return;
  G.seed = SEED;
  try{ localStorage.setItem(CONFIG.SAVE_KEY, JSON.stringify(G)); }
  catch(e){ /* localStorage may be unavailable */ }
}
function load(){
  try{
    const raw = localStorage.getItem(CONFIG.SAVE_KEY);
    if(!raw) return false;
    G = JSON.parse(raw);
    SEED = G.seed || SEED;
    return true;
  }catch(e){ return false; }
}
function hasSave(){
  try{ return !!localStorage.getItem(CONFIG.SAVE_KEY); }catch(e){ return false; }
}
function wipeSave(){
  try{ localStorage.removeItem(CONFIG.SAVE_KEY); }catch(e){}
  G=null;
}

// helpers to access state
function myTeam(){ return G.teams.find(t=>t.id===G.myTeamId); }
function teamById(tid){ return G.teams.find(t=>t.id===tid); }
function confById(cid){ return CONFERENCES.find(c=>c.id===cid); }

console.log('DYNASTY HC world+state systems loaded');
</script>

<script>
/* ---------------------------------------------------------------------------
   SECTION H — UI ROUTER / SHELL
   --------------------------------------------------------------------------- */
let CURRENT = 'hub';
const NAV_TABS = [
  {id:'hub',ic:'🏟️',label:'Hub'},
  {id:'team',ic:'📋',label:'Team'},
  {id:'recruit',ic:'🎯',label:'Recruit'},
  {id:'portal',ic:'🔁',label:'Portal'},
  {id:'money',ic:'💰',label:'Money'},
  {id:'schedule',ic:'🏈',label:'Games'},
  {id:'career',ic:'📈',label:'Career'},
  {id:'world',ic:'🌎',label:'World'},
];

function renderNav(){
  const nav=$('#nav'); nav.innerHTML='';
  if(!G || !G.myTeamId){ nav.style.display='none'; return; }
  nav.style.display='flex';
  NAV_TABS.forEach(t=>{
    const b=el('button', CURRENT===t.id?'active':'');
    b.innerHTML=`<span class="ic">${t.ic}</span>${t.label}`;
    b.onclick=()=>go(t.id);
    nav.appendChild(b);
  });
}

function renderTopbar(){
  const tb=$('#topbar');
  if(!G || !G.myTeamId){ tb.style.display='none'; return; }
  tb.style.display='flex';
  const t=myTeam();
  const rank = G.apPoll.indexOf(t.id)+1;
  tb.innerHTML='';
  const badge=el('div','tb-badge');
  badge.style.background=t.colors[0]; badge.style.color=t.colors[1];
  badge.textContent=t.abbr;
  const info=el('div','tb-info',`<div class="tb-title">${t.short} ${t.masc}</div><div class="tb-sub">${G.coach.name} • ${t.confName} • ${G.year}</div>`);
  const right=el('div','tb-right',`<div class="tb-rank">${rank>0&&rank<=25?'#'+rank:'—'}</div><div class="tb-rec">${t.w}-${t.l}</div>`);
  tb.append(badge,info,right);
}

function go(screen){
  CURRENT=screen;
  renderNav(); renderTopbar();
  const s=$('#screen'); s.scrollTop=0;
  s.innerHTML='';
  s.classList.remove('fade-in'); void s.offsetWidth; s.classList.add('fade-in');
  const fn = SCREENS[screen];
  if(fn) fn(s);
  save();
}

const SCREENS = {}; // filled by later sections

/* ---------------------------------------------------------------------------
   MODAL
   --------------------------------------------------------------------------- */
function modal(html, opts={}){
  const w=$('#modal-wrap'), m=$('#modal');
  m.innerHTML='<div class="modal-grab"></div>'+html;
  w.classList.add('show');
  if(!opts.noClose){
    w.onclick=(e)=>{ if(e.target===w) closeModal(); };
  } else { w.onclick=null; }
}
function closeModal(){ $('#modal-wrap').classList.remove('show'); }

/* ---------------------------------------------------------------------------
   CUTSCENE
   --------------------------------------------------------------------------- */
function cutscene(bg, html, opts={}){
  const c=$('#cut');
  c.style.backgroundColor = '#0a0e14';
  c.style.backgroundImage = bg;
  c.innerHTML = html;
  c.classList.add('show');
  if(opts.confetti) spawnConfetti(c);
}
function closeCut(){ const c=$('#cut'); c.classList.remove('show'); c.innerHTML=''; }
function spawnConfetti(container){
  const cols=['#ff5a1f','#ffd23f','#2ecc71','#3ba0ff','#a974ff','#ff4757'];
  for(let i=0;i<60;i++){
    const cf=el('div','confetti');
    cf.style.left=rnd(0,100)+'%';
    cf.style.background=pick(cols);
    cf.style.animationDuration=rnd(1.5,3.5)+'s';
    cf.style.animationDelay=rnd(0,1)+'s';
    cf.style.borderRadius= rng()<.5?'50%':'2px';
    container.appendChild(cf);
  }
}

/* small reusable card pieces */
function teamBadge(t,size=38){
  return `<div class="av" style="width:${size}px;height:${size}px;font-size:${size*0.34}px;background:${t.colors[0]};color:${t.colors[1]}">${t.abbr}</div>`;
}
function coachBadge(name,colors,size=38){
  const c = colors||['#2e3c52','#fff'];
  return `<div class="av" style="width:${size}px;height:${size}px;font-size:${size*0.34}px;background:${c[0]};color:${c[1]}">${initials(name)}</div>`;
}
/* the player's coach uses their custom-built face */
function myCoachAvatar(size=44){
  if(G.coach && G.coach.face){
    return `<div class="pavatar" style="width:${size}px;height:${size}px">${faceSVG('mycoach',size,G.coach.face)}</div>`;
  }
  return coachBadge(G.coach?G.coach.name:'', myTeam()?myTeam().colors:null, size);
}

/* ---------------------------------------------------------------------------
   PROCEDURAL FACES — deterministic cartoon avatar from an id string.
   Same id always yields the same face. Single-file, no image assets.
   --------------------------------------------------------------------------- */
const FACE_SKIN = ['#f8d9c0','#f1c9a5','#e6b98f','#d9a373','#c68642','#a9683b','#8a5a2b','#6b4423','#4a2f1a'];
const FACE_HAIR = ['#1a1a1a','#2b1d12','#3b2614','#5a3210','#7a4a1c','#9c6b2e','#c9a24b','#e8d28a','#b0b0b0','#e5e5e5','#5a2d0c','#222'];
function faceHash(str){
  // deterministic 32-bit hash
  let h=2166136261>>>0;
  str=String(str);
  for(let i=0;i<str.length;i++){ h^=str.charCodeAt(i); h=Math.imul(h,16777619)>>>0; }
  return h>>>0;
}
function faceSVG(seed, size=44, opts){
  const h=faceHash(seed);
  const pick = (arr,shift)=> arr[(h>>>shift)%arr.length];
  const bit = (n)=> (h>>>n)&1;
  const range = (lo,hi,shift)=> lo + ((h>>>shift)%(hi-lo+1));
  const o = opts||{};
  const skin = o.skin!=null ? FACE_SKIN[o.skin%FACE_SKIN.length] : pick(FACE_SKIN, 2);
  const hair = o.hair!=null ? FACE_HAIR[o.hair%FACE_HAIR.length] : pick(FACE_HAIR, 7);
  const hairStyle = o.hairStyle!=null ? o.hairStyle%6 : (h>>>11)%6;   // 0 short,1 buzz,2 afro,3 flat-top,4 bald,5 long
  const facialHair = o.facialHair!=null ? o.facialHair%5 : (h>>>15)%5;  // 0 none,1 stubble,2 mustache,3 goatee,4 full beard
  const eyeType = o.eyeType!=null ? o.eyeType%3 : (h>>>18)%3;
  const browAngle = bit(20)? -3 : 3;
  const mouthType = (h>>>21)%3;
  const search = o.bg || pick(['#2a3340','#26303d','#2e2738','#242c3a','#2c2a33'], 23);
  const skinDark = shadeHex(skin,-22);
  const hairDark = shadeHex(hair,-18);
  const cx=50, cy=52;

  // hair back layer (for long/afro)
  let hairBack='';
  if(hairStyle===5){ hairBack=`<ellipse cx="${cx}" cy="58" rx="30" ry="34" fill="${hair}"/>`; }
  if(hairStyle===2){ hairBack=`<circle cx="${cx}" cy="40" r="30" fill="${hair}"/>`; }

  // ears
  const ears=`<ellipse cx="26" cy="54" rx="5" ry="7" fill="${skin}"/><ellipse cx="74" cy="54" rx="5" ry="7" fill="${skin}"/>`;

  // head
  const head=`<path d="M30 44 Q30 24 50 24 Q70 24 70 44 L70 56 Q70 74 50 76 Q30 74 30 56 Z" fill="${skin}"/>
              <path d="M34 64 Q50 78 66 64 L66 70 Q50 80 34 70 Z" fill="${skinDark}" opacity=".25"/>`;

  // hair front
  let hairFront='';
  if(hairStyle===0) hairFront=`<path d="M28 46 Q26 22 50 20 Q74 22 72 46 Q70 34 50 32 Q30 34 28 46 Z" fill="${hair}"/>`;
  else if(hairStyle===1) hairFront=`<path d="M30 42 Q30 26 50 25 Q70 26 70 42 Q66 33 50 32 Q34 33 30 42 Z" fill="${hair}" opacity=".9"/>`;
  else if(hairStyle===2) hairFront=`<circle cx="50" cy="34" r="22" fill="${hair}"/><path d="M30 44 Q30 30 50 30 Q70 30 70 44 Z" fill="${skin}" opacity="0"/>`;
  else if(hairStyle===3) hairFront=`<path d="M28 40 L28 30 Q50 22 72 30 L72 40 Q70 32 50 31 Q30 32 28 40 Z" fill="${hair}"/>`;
  else if(hairStyle===4) hairFront=``; // bald
  else hairFront=`<path d="M28 48 Q24 20 50 20 Q76 20 72 48 Q72 30 50 30 Q28 30 28 48 Z" fill="${hair}"/>`;
  // re-add head over afro so face shows
  if(hairStyle===2) hairFront += `<path d="M31 46 Q31 30 50 30 Q69 30 69 46 L69 56 Q69 72 50 74 Q31 72 31 56 Z" fill="${skin}"/>`;

  // eyebrows
  const brows=`<rect x="36" y="${46+browAngle*0}" width="10" height="2.4" rx="1.2" fill="${hairDark}" transform="rotate(${browAngle} 41 47)"/>
               <rect x="54" y="47" width="10" height="2.4" rx="1.2" fill="${hairDark}" transform="rotate(${-browAngle} 59 47)"/>`;

  // eyes
  let eyes;
  if(eyeType===0) eyes=`<circle cx="41" cy="52" r="2.6" fill="#fff"/><circle cx="41" cy="52" r="1.5" fill="#2a2a2a"/><circle cx="59" cy="52" r="2.6" fill="#fff"/><circle cx="59" cy="52" r="1.5" fill="#2a2a2a"/>`;
  else if(eyeType===1) eyes=`<ellipse cx="41" cy="52" rx="3" ry="2.2" fill="#fff"/><circle cx="41" cy="52" r="1.4" fill="#3a2a1a"/><ellipse cx="59" cy="52" rx="3" ry="2.2" fill="#fff"/><circle cx="59" cy="52" r="1.4" fill="#3a2a1a"/>`;
  else eyes=`<circle cx="41" cy="52" r="1.8" fill="#2a2a2a"/><circle cx="59" cy="52" r="1.8" fill="#2a2a2a"/>`;

  // nose
  const nose=`<path d="M50 54 L48 60 Q50 62 52 60 Z" fill="${skinDark}" opacity=".4"/>`;

  // mouth
  let mouth;
  if(mouthType===0) mouth=`<path d="M44 66 Q50 70 56 66" stroke="${shadeHex(skin,-45)}" stroke-width="1.8" fill="none" stroke-linecap="round"/>`;
  else if(mouthType===1) mouth=`<rect x="45" y="65" width="10" height="2.2" rx="1.1" fill="${shadeHex(skin,-45)}"/>`;
  else mouth=`<path d="M45 65 Q50 67 55 65" stroke="${shadeHex(skin,-45)}" stroke-width="1.8" fill="none" stroke-linecap="round"/>`;

  // facial hair
  let beard='';
  if(facialHair===1){
    // stubble — soft shadow across jaw and chin
    beard=`<path d="M31 55 Q31 74 50 77 Q69 74 69 55 Q67 70 50 73 Q33 70 31 55 Z" fill="${hairDark}" opacity=".32"/>
           <rect x="42" y="60" width="16" height="4" rx="2" fill="${hairDark}" opacity=".3"/>`;
  } else if(facialHair===2){
    // mustache — clear band sitting just above the mouth
    beard=`<path d="M40 61 Q50 58 60 61 Q60 65 54 64 Q50 62.5 46 64 Q40 65 40 61 Z" fill="${hairDark}"/>`;
  } else if(facialHair===3){
    // goatee — mustache + chin patch (soul patch + chin)
    beard=`<path d="M41 61 Q50 58.5 59 61 Q59 64 54 63.5 Q50 62 46 63.5 Q41 64 41 61 Z" fill="${hairDark}"/>
           <path d="M43 69 Q50 71 57 69 Q57 76 50 78 Q43 76 43 69 Z" fill="${hairDark}"/>`;
  } else if(facialHair===4){
    // full beard — wraps the jaw, connects to sideburns
    beard=`<path d="M30 50 Q30 75 50 79 Q70 75 70 50 Q70 64 64 70 Q58 76 50 76 Q42 76 36 70 Q30 64 30 50 Z" fill="${hairDark}"/>
           <path d="M40 61 Q50 58 60 61 Q60 64 54 63.5 Q50 62 46 63.5 Q40 64 40 61 Z" fill="${hairDark}"/>`;
  }

  const svg=`<svg viewBox="0 0 100 100" width="${size}" height="${size}" xmlns="http://www.w3.org/2000/svg">
    <defs><clipPath id="cf${(h%99999)}"><rect width="100" height="100" rx="22"/></clipPath></defs>
    <g clip-path="url(#cf${(h%99999)})">
      <rect width="100" height="100" fill="${search}"/>
      ${hairBack}${ears}${head}${beard}${hairFront}${brows}${eyes}${nose}${mouth}
    </g>
  </svg>`;
  return svg;
}
function shadeHex(hex,amt){
  hex=hex.replace('#','');
  if(hex.length===3) hex=hex.split('').map(c=>c+c).join('');
  let r=parseInt(hex.slice(0,2),16),g=parseInt(hex.slice(2,4),16),b=parseInt(hex.slice(4,6),16);
  r=clamp(r+amt,0,255);g=clamp(g+amt,0,255);b=clamp(b+amt,0,255);
  return '#'+[r,g,b].map(v=>v.toString(16).padStart(2,'0')).join('');
}
/* Avatar = face with a small OVR (or star) badge in the corner. */
function playerAvatar(p, size=44){
  const ovr=Math.round(p.ovr);
  return `<div class="pavatar" style="width:${size}px;height:${size}px">
    ${faceSVG(p.id, size)}
    <div class="pavatar-badge" style="background:${ovrColor(ovr)}">${ovr}</div>
  </div>`;
}
function recruitAvatar(r, size=44){
  const known = r.scout>=85;
  const label = known ? r.trueOvr : r.stars+'★';
  const bg = known ? ovrColor(r.trueOvr) : starColor(r.stars);
  return `<div class="pavatar" style="width:${size}px;height:${size}px">
    ${faceSVG(r.id, size)}
    <div class="pavatar-badge" style="background:${bg};font-size:${size*0.22}px">${label}</div>
  </div>`;
}
function ovrRing(o,size='sm'){
  return `<div class="ovr ${size}" style="background:conic-gradient(${ovrColor(o)} ${Math.round(o*3.6)}deg, var(--line) 0);"><div style="position:absolute;inset:3px;border-radius:50%;background:var(--panel);display:flex;align-items:center;justify-content:center;font-size:${size==='sm'?12:15}px">${Math.round(o)}</div></div>`;
}
function attrBar(label,val,color){
  return `<div class="attr"><div class="lbl"><span>${label}</span><b>${val}</b></div><div class="bar"><div style="width:${val}%;background:${color||ovrColor(val)}"></div></div></div>`;
}

console.log('DYNASTY HC UI shell loaded');
</script>

<script>
/* ---------------------------------------------------------------------------
   SECTION I — START FLOW: TITLE, COACH CREATION, TEAM SELECTION
   --------------------------------------------------------------------------- */
let creation = null; // {name,age,arch,traits[],team}

function showTitle(){
  $('#topbar').style.display='none'; $('#nav').style.display='none';
  const s=$('#screen'); s.scrollTop=0;
  const cont = hasSave();
  s.innerHTML=`
  <div class="pad" style="min-height:100%;display:flex;flex-direction:column;justify-content:center;background:radial-gradient(circle at 50% 30%, rgba(255,90,31,.15), transparent 60%)">
    <div class="tc" style="margin-bottom:8px">
      <div class="display" style="font-size:13px;letter-spacing:6px;color:var(--accent2)">CAREER MODE</div>
      <div class="display" style="font-size:56px;font-weight:700;line-height:.9;letter-spacing:1px;margin-top:6px">DYNASTY<br><span style="color:var(--accent)">HC</span></div>
      <div class="muted mt10" style="font-size:14px;max-width:300px;margin:14px auto 0">Pick any program in the country and build a Hall of Fame coaching career across decades.</div>
    </div>
    <div class="mt20" style="max-width:340px;margin-left:auto;margin-right:auto;width:100%">
      ${cont?`<button class="btn full lg gold" onclick="continueGame()">▶ Continue Career</button>
      <button class="btn full ghost mt10" onclick="confirmNew()">+ New Career</button>`:
      `<button class="btn full lg" onclick="startCreation()">▶ Start New Career</button>`}
    </div>
    <div class="tc dim xs mt20">v${CONFIG.VERSION} • All teams &amp; names are fictional • Real conference structure (2026)</div>
  </div>`;
}

function confirmNew(){
  modal(`<div class="tc"><div class="display lg b">Start a new career?</div><p class="muted mt10">This will erase your current save permanently.</p>
  <div class="row gap8 mt20"><button class="btn ghost fg" onclick="closeModal()">Cancel</button><button class="btn red fg" onclick="wipeSave();closeModal();startCreation()">Erase &amp; Start</button></div></div>`);
}
function continueGame(){
  if(load()){ go('hub'); } else { showTitle(); }
}

function startCreation(){
  creation = {name:'', age:42, arch:'off', traits:[], teamId:null,
    face:{ skin:rndi(0,8), hair:rndi(0,11), hairStyle:rndi(0,5), facialHair:rndi(0,4), eyeType:rndi(0,2) } };
  // generate the world up front so team picker is real
  buildWorldForCreation();
  creationStep1();
}

let WORLD_PREVIEW=null;
function buildWorldForCreation(){
  // Build a temporary world for selection; reuse if starting
  WORLD_PREVIEW = buildWorld();
}

/* ---- STEP 1: identity & archetype ---- */
function creationStep1(){
  $('#topbar').style.display='none'; $('#nav').style.display='none';
  const s=$('#screen'); s.scrollTop=0;
  s.innerHTML=`
  <div class="pad">
    <div class="display b" style="font-size:24px">Create Your Coach</div>
    <div class="muted sm">Step 1 of 3 — Identity</div>

    <div class="tc mt14" style="display:flex;flex-direction:column;align-items:center">
      <div id="facePreview" style="filter:drop-shadow(0 6px 16px rgba(0,0,0,.5))">${faceSVG('coach_preview',96,creation.face)}</div>
      <button class="btn ghost sm mt10" onclick="randomizeFace()">🎲 Randomize Look</button>
    </div>
    <div class="card tight mt10">
      ${faceRow('Skin','skin',9)}
      ${faceRow('Hair Color','hair',12)}
      ${faceRow('Hair Style','hairStyle',6)}
      ${faceRow('Facial Hair','facialHair',5)}
      ${faceRow('Eyes','eyeType',3)}
    </div>

    <h2 class="sec">Name</h2>
    <input class="searchbar" id="cName" placeholder="Coach name…" value="${creation.name}" oninput="creation.name=this.value">
    <button class="btn ghost sm mt6" onclick="creation.name=genCoachName();creationStep1()">🎲 Random Name</button>

    <h2 class="sec">Age — <span id="ageV">${creation.age}</span></h2>
    <input type="range" min="32" max="55" value="${creation.age}" oninput="creation.age=+this.value;document.getElementById('ageV').textContent=this.value">
    <div class="row between dim xs"><span>32 (longer career)</span><span>55 (veteran)</span></div>

    <h2 class="sec">Background Archetype</h2>
    <div id="archList"></div>

    <button class="btn full lg mt20" onclick="toStep2()">Next: Traits →</button>
    <button class="btn full ghost mt10" onclick="showTitle()">← Back</button>
  </div>`;
  const al=$('#archList');
  COACH_ARCHETYPES.forEach(a=>{
    const sel = creation.arch===a.id;
    const d=el('div', 'li'+(sel?' sel':''));
    const tilts = Object.entries(a.tilt).map(([k,v])=>`<span class="chip ${v>0?'green':'red'}" style="padding:2px 7px">${k} ${v>0?'+':''}${v}</span>`).join(' ');
    d.innerHTML=`<div class="fg"><div class="display b" style="font-size:15px">${a.name}</div><div class="muted xs mt6">${a.desc}</div><div class="mt6 row wrap gap6">${tilts}</div></div>`;
    d.onclick=()=>{ creation.arch=a.id; creationStep1(); };
    al.appendChild(d);
  });
}

function faceRow(label, key, count){
  const labels={
    hairStyle:['Short','Buzz','Afro','Flat-top','Bald','Long'],
    facialHair:['Clean','Stubble','Mustache','Goatee','Full Beard'],
    eyeType:['Round','Almond','Narrow'],
  };
  const val = creation.face[key];
  const txt = labels[key]? labels[key][val] : (val+1)+'';
  return `<div class="row between" style="padding:6px 0">
    <span class="sm">${label}</span>
    <div class="row gap8">
      <button class="btn sm outline" onclick="cycleFace('${key}',${count},-1)">‹</button>
      <span class="sm b" style="min-width:74px;text-align:center">${txt}</span>
      <button class="btn sm outline" onclick="cycleFace('${key}',${count},1)">›</button>
    </div>
  </div>`;
}
function cycleFace(key, count, dir){
  creation.face[key] = ((creation.face[key]+dir)%count + count)%count;
  creationStep1();
}
function randomizeFace(){
  creation.face={ skin:rndi(0,8), hair:rndi(0,11), hairStyle:rndi(0,5), facialHair:rndi(0,4), eyeType:rndi(0,2) };
  creationStep1();
}

function toStep2(){
  if(!creation.name.trim()){ toast('Enter a coach name'); return; }
  creationStep2();
}

/* ---- STEP 2: traits ---- */
function creationStep2(){
  const s=$('#screen'); s.scrollTop=0;
  s.innerHTML=`
  <div class="pad">
    <div class="display b" style="font-size:24px">Coaching Traits</div>
    <div class="muted sm">Step 2 of 3 — Pick up to 2 traits (or roll random)</div>
    <div class="chip accent mt10" id="traitCount">${creation.traits.length}/2 selected</div>
    <div id="traitList" class="mt14"></div>
    <button class="btn full lg mt20" onclick="toTeamSelect()">Next: Pick Your Team →</button>
    <button class="btn full ghost mt10" onclick="creationStep1()">← Back</button>
  </div>`;
  const tl=$('#traitList');
  COACH_TRAITS.forEach(tr=>{
    const sel=creation.traits.includes(tr.id);
    const d=el('div','li'+(sel?' sel':''));
    d.innerHTML=`<div class="ovr sm" style="background:${sel?'var(--accent)':'var(--panel2)'};font-size:18px">${sel?'✓':(tr.icon||'')}</div><div class="fg"><div class="display b" style="font-size:14px">${tr.name}</div><div class="muted xs">${tr.desc}</div></div>`;
    d.onclick=()=>{
      if(sel){ creation.traits=creation.traits.filter(x=>x!==tr.id); }
      else { if(creation.traits.length>=2){ toast('Max 2 traits'); return;} creation.traits.push(tr.id); }
      creationStep2();
    };
    tl.appendChild(d);
  });
}

/* ---- STEP 3: TEAM SELECTION (the requested feature) ---- */
let teamFilter = {conf:'all', tier:'all', search:'', sort:'prestige'};
function toTeamSelect(){ teamSelectScreen(); }

function teamSelectScreen(){
  const s=$('#screen'); s.scrollTop=0;
  s.innerHTML=`
  <div class="pad">
    <div class="display b" style="font-size:24px">Choose Your Program</div>
    <div class="muted sm">Step 3 of 3 — Pick any of the ${WORLD_PREVIEW.length} FBS teams to begin your career</div>

    <div class="card tight mt14" style="background:rgba(255,90,31,.06);border-color:var(--accent)">
      <div class="xs muted">💡 Lower-prestige jobs mean lower expectations and a longer climb — but bigger jobs expect titles fast. Classic mode starts you at a Group of 5 school, but you can take any job you want.</div>
    </div>

    <input class="searchbar mt10" id="teamSearch" placeholder="🔍 Search team or city…" value="${teamFilter.search}" oninput="teamFilter.search=this.value;renderTeamList()">

    <div class="row gap6 wrap mt6">
      <select class="sel" id="confSel" onchange="teamFilter.conf=this.value;renderTeamList()">
        <option value="all">All Conferences</option>
        ${CONFERENCES.map(c=>`<option value="${c.id}" ${teamFilter.conf===c.id?'selected':''}>${c.name}</option>`).join('')}
      </select>
      <select class="sel" id="tierSel" onchange="teamFilter.tier=this.value;renderTeamList()">
        <option value="all">All Tiers</option>
        <option value="P4">Power 4</option>
        <option value="G6">Group of 6</option>
        <option value="IND">Independent</option>
      </select>
      <select class="sel" id="sortSel" onchange="teamFilter.sort=this.value;renderTeamList()">
        <option value="prestige">Sort: Prestige ↓</option>
        <option value="prestige_asc">Sort: Prestige ↑</option>
        <option value="name">Sort: Name</option>
        <option value="nil">Sort: NIL Strength</option>
      </select>
    </div>

    <div class="row gap6 mt10">
      <button class="btn ghost sm fg" onclick="quickFilterG5()">🎯 Classic G5 Start</button>
      <button class="btn ghost sm fg" onclick="pickRandomTeam()">🎲 Surprise Me</button>
    </div>

    <div id="teamCount" class="muted xs mt10"></div>
    <div id="teamList" class="mt6"></div>
  </div>`;
  renderTeamList();
}

function quickFilterG5(){ teamFilter={conf:'all',tier:'G6',search:'',sort:'prestige_asc'}; teamSelectScreen(); }
function pickRandomTeam(){
  const t=pick(WORLD_PREVIEW.filter(x=>x.tier==='G6'));
  openTeamConfirm(t.id);
}

function renderTeamList(){
  let list=[...WORLD_PREVIEW];
  if(teamFilter.conf!=='all') list=list.filter(t=>t.conf===teamFilter.conf);
  if(teamFilter.tier!=='all') list=list.filter(t=>t.tier===teamFilter.tier);
  if(teamFilter.search.trim()){
    const q=teamFilter.search.toLowerCase();
    list=list.filter(t=>t.name.toLowerCase().includes(q)||t.city.toLowerCase().includes(q)||t.masc.toLowerCase().includes(q));
  }
  if(teamFilter.sort==='prestige') list.sort((a,b)=>b.prestige-a.prestige);
  else if(teamFilter.sort==='prestige_asc') list.sort((a,b)=>a.prestige-b.prestige);
  else if(teamFilter.sort==='name') list.sort((a,b)=>a.name.localeCompare(b.name));
  else if(teamFilter.sort==='nil') list.sort((a,b)=>b.nilStrength-a.nilStrength);

  const cnt=$('#teamCount'); if(cnt) cnt.textContent=`${list.length} teams`;
  const tl=$('#teamList'); if(!tl) return; tl.innerHTML='';
  list.slice(0,80).forEach(t=>{
    const d=el('div','li');
    const tierTag = {P4:'<span class="pill" style="background:rgba(169,116,255,.2);color:var(--purple)">POWER 4</span>',G6:'<span class="pill" style="background:rgba(59,160,255,.2);color:var(--blue)">G6</span>',IND:'<span class="pill" style="background:rgba(255,210,63,.2);color:var(--gold)">IND</span>'}[t.tier];
    d.innerHTML=`${teamBadge(t,44)}
      <div class="fg">
        <div class="display b" style="font-size:15px">${t.name}</div>
        <div class="row gap6 mt6 wrap"><span class="muted xs">${t.confName}</span> ${tierTag}</div>
        <div class="row gap8 mt6 xs muted"><span>⭐ Prestige ${t.prestige}</span><span>💰 NIL ${t.nilStrength}</span><span>🏟️ ${(t.capacity/1000)}k</span></div>
      </div>`;
    d.onclick=()=>openTeamConfirm(t.id);
    tl.appendChild(d);
  });
  if(list.length>80){ tl.appendChild(el('div','muted xs tc pad','Showing first 80 — refine your search to see more.')); }
}

function expectationFor(t){
  // AD expectations scale with prestige
  if(t.prestige>=86) return {goal:'Compete for the National Title', wins:11, years:2, sec:35};
  if(t.prestige>=78) return {goal:'Win the conference & reach the Playoff', wins:10, years:3, sec:42};
  if(t.prestige>=68) return {goal:'Reach a bowl every year, contend by year 3', wins:8, years:3, sec:48};
  if(t.prestige>=55) return {goal:'Make a bowl game within 2 years', wins:7, years:2, sec:50};
  return {goal:'Show progress — reach a bowl by year 3', wins:6, years:3, sec:55};
}

function openTeamConfirm(tid){
  const t=WORLD_PREVIEW.find(x=>x.id===tid);
  const exp=expectationFor(t);
  const salary = (t.prestige*0.09 + rnd(0.3,1.2)).toFixed(1);
  const years = exp.years+rndi(1,2);
  const cap = computeBudgets(t);
  modal(`
    <div class="tc">
      ${teamBadge(t,64)}
      <div class="display b mt10" style="font-size:22px">${t.name}</div>
      <div class="muted sm">${t.confName} • ${t.city} • ${t.weather}</div>
    </div>
    <div class="grid2 mt14">
      <div class="statbox"><div class="v" style="color:${ovrColor(t.prestige)}">${t.prestige}</div><div class="l">Prestige</div></div>
      <div class="statbox"><div class="v" style="color:${ovrColor(t.nilStrength)}">${t.nilStrength}</div><div class="l">NIL/Booster</div></div>
      <div class="statbox"><div class="v">${t.facilities}</div><div class="l">Facilities</div></div>
      <div class="statbox"><div class="v">${(t.capacity/1000)}k</div><div class="l">Stadium</div></div>
    </div>
    <div class="card tight mt12">
      <div class="row between"><span class="muted sm">💰 Rev-Share Budget (football)</span><b>${money(cap.rev)}</b></div>
      <div class="row between mt6"><span class="muted sm">🤝 NIL Collective Pool</span><b>${money(cap.nil)}</b></div>
    </div>
    <div class="card tight" style="border-color:var(--accent2)">
      <div class="display b sm" style="color:var(--accent2)">📋 THE AD'S EXPECTATIONS</div>
      <div class="sm mt6">"${exp.goal}"</div>
    </div>
    <div class="card tight">
      <div class="row between"><span class="muted sm">Contract Offer</span><b>${years} years</b></div>
      <div class="row between mt6"><span class="muted sm">Salary</span><b>$${salary}M / yr</b></div>
    </div>
    <button class="btn full lg gold mt10" onclick="commitToTeam('${t.id}')">✍️ Accept Job &amp; Start Career</button>
    <button class="btn full ghost mt10" onclick="closeModal()">← Keep Looking</button>
  `);
}

function computeBudgets(t){
  const cap = CONFIG.REVSHARE_CAP_BASE;
  const fShare = CONFIG.FOOTBALL_SHARE_MIN + (t.prestige/100)*(CONFIG.FOOTBALL_SHARE_MAX-CONFIG.FOOTBALL_SHARE_MIN);
  const rev = +(cap*fShare).toFixed(1);
  const nil = +((t.nilStrength/100)*rnd(2,14)).toFixed(1);
  return {rev, nil};
}

function commitToTeam(tid){
  closeModal();
  // finalize the game state from the previewed world
  G = newGameState();
  G.teams = WORLD_PREVIEW;
  G.myTeamId = tid;
  G.recruits = genRecruitClass();
  assignDreamSchools();
  // build coach
  const arch = COACH_ARCHETYPES.find(a=>a.id===creation.arch);
  const baseAttr = {Offense:45,Defense:45,SpecialTeams:45,Recruiting:45,PlayerDev:45,GameMgmt:45,Discipline:45,Motivation:45,ScoutingEye:45,Fundraising:45,MediaSavvy:45};
  for(const [k,v] of Object.entries(arch.tilt)) baseAttr[k]=clamp(baseAttr[k]+v,10,99);
  G.coach = {
    name:creation.name, age:creation.age, arch:creation.arch, archName:arch.name,
    traits:creation.traits.slice(), attr:baseAttr,
    face: creation.face || null,
    rep:CONFIG.REP_START,
    rating:55, lastRatingDelta:0,
    careerWins:0, careerLosses:0, confTitles:0, natTitles:0, playoffApps:0,
    nflDraftees:0, firstRounders:0, recruitTitles:0, coachingTree:[],
    yearsAtJob:0, seasonsCoached:0, retired:false,
  };
  const t=teamById(tid);
  const exp=expectationFor(t);
  G.adExpectation = exp;
  G.jobSecurity = exp.sec;
  G.contract = {years: exp.years+rndi(1,2), yearsLeft: exp.years+rndi(1,2), salary:+(t.prestige*0.09+rnd(0.3,1.2)).toFixed(1), buyout:+(t.prestige*0.05).toFixed(1)};
  G.careerLog.push({team:t.name, teamId:t.id, startYear:G.year});
  // set budgets for all teams
  G.teams.forEach(tm=>{ const b=computeBudgets(tm); tm.revShareBudget=b.rev; tm.nilBudget=b.nil; tm.spent=0; });
  assignNILtoRosters();
  buildSchedule();
  initPolls();
  pushNews('big',`${G.coach.name} hired at ${t.name}`,`${t.short} introduces ${G.coach.name} as head coach. The ${arch.name.toLowerCase()} inherits a program with the AD demanding: "${exp.goal}"`);
  save();
  // welcome cutscene then hub
  hireCutscene(t);
}

function assignDreamSchools(){
  const elite = G.teams.filter(t=>t.prestige>75);
  const mt = G.myTeamId ? myTeam() : null;
  G.recruits.forEach(r=>{
    r.dreamSchool = rng()<0.5 ? pick(elite).id : pick(G.teams.filter(t=>t.conf===r.homeConf)).id;
    // seed baseline interest in YOUR program based on whether he'd naturally want to go there
    if(mt) r.interest[G.myTeamId] = startingInterestInMe(r);
  });
}

/* How interested a recruit ALREADY is in your program before you do anything.
   Driven by genuine fit: dream school, hometown proximity, prestige fit, and his
   own motivations (winning, NIL, playing time, NFL pipeline). Capped by reach. */
function startingInterestInMe(r){
  const t=myTeam();
  const m=r.motivations||{};
  const g=(k)=>(m[k]||0)/100;
  let base = 6; // everyone gives a baseline glance
  if(t.id===r.dreamSchool) base += 38;                       // dream school = huge head start
  if(t.conf===r.homeConf)  base += 14 * (0.5 + g('Proximity')); // local kid, weighted by how much he values home
  base += g('Winning') * (rankOf(t.id)&&rankOf(t.id)<=25 ? (26-rankOf(t.id))*0.5 : 0);
  base += g('NIL Money') * (t.nilStrength*0.12);
  base += g('Conference Prestige') * (t.tier==='P4'?10:2);
  base += g('Develop for NFL') * ((G.coach?G.coach.nflDraftees:0)*0.8);
  base += (t.prestige-50)*0.18;                              // strong programs naturally attract
  // coming off a strong season makes recruits view the program more favorably; a bad one cools it
  const mo = recentRecordMomentum();
  base += mo;                                                // generic buzz from last year's result
  base += g('Winning') * mo * 0.5;                           // winners care even more about your record
  base += rnd(-4,4);
  // never let the head start exceed what's realistic for his star tier at your program
  const cap = recruitInterestCeiling(r);
  return clamp(Math.round(Math.min(base, cap*0.7)), 0, 100);
}

/* Last season's record as a momentum modifier (~ -10 .. +14).
   A great year boosts how recruits perceive the program; a losing year drags it. */
function recentRecordMomentum(){
  if(!G.history || !G.history.length) return 0;
  const last=G.history[G.history.length-1];
  if(!last || !last.myRecord) return 0;
  const [w,l]=String(last.myRecord).split('-').map(Number);
  const games=(w||0)+(l||0);
  if(!games) return 0;
  const pct=(w||0)/games;            // 0..1
  let mo=(pct-0.5)*22;               // .500 = neutral; undefeated ≈ +11; winless ≈ -11
  if(w>=12) mo+=4;                   // elite season bonus (playoff-caliber)
  else if(w>=10) mo+=2;
  if(w<=3) mo-=3;                    // disastrous season extra sting
  return clamp(mo, -12, 16);
}

function assignNILtoRosters(){
  G.teams.forEach(t=>{
    const pool=t.nilBudget;
    const sorted=[...t.roster].sort((a,b)=>b.ovr-a.ovr);
    sorted.forEach((p,i)=>{
      const share = Math.max(0, (sorted.length-i)/ (sorted.length*sorted.length/1.6));
      p.nil = +(pool*share*rnd(0.6,1.3)).toFixed(2);
    });
  });
}

function hireCutscene(t){
  cutscene(`linear-gradient(135deg, ${t.colors[0]}, ${t.colors[0]}cc)`,`
    <div style="animation:fadeIn .8s;display:flex;flex-direction:column;align-items:center">
      ${teamBadge(t,90)}
      <div class="display" style="font-size:13px;letter-spacing:4px;color:${t.colors[1]};margin-top:18px;opacity:.9">WELCOME TO</div>
      <div class="display b" style="font-size:34px;line-height:1;margin-top:4px;color:#fff">${t.name}</div>
      <div style="margin-top:18px">${myCoachAvatar(64)}</div>
      <div style="color:#fff;opacity:.85;margin-top:10px;font-size:15px;text-align:center">Head Coach<br><b style="font-size:20px">${G.coach.name}</b></div>
      <div style="background:rgba(0,0,0,.3);border-radius:12px;padding:14px;margin-top:24px;max-width:300px">
        <div class="xs" style="color:${t.colors[1]};letter-spacing:1px">YOUR MISSION</div>
        <div style="color:#fff;font-size:14px;margin-top:6px">"${G.adExpectation.goal}"</div>
      </div>
      <button class="btn lg gold" style="margin-top:30px" onclick="closeCut();go('hub')">Let's Build a Dynasty →</button>
    </div>
  `);
}

console.log('DYNASTY HC start flow loaded');
</script>

<script>
/* ---------------------------------------------------------------------------
   SECTION J — TEAM STRENGTH, SCHEDULE, POLLS
   --------------------------------------------------------------------------- */
function teamStrength(t){
  // top 30 players by ovr weighted
  const sorted=[...t.roster].filter(p=>!p.injury||p.injury.weeksOut<=0).sort((a,b)=>b.ovr-a.ovr);
  const top=sorted.slice(0,30);
  let off=0,def=0,oc=0,dc=0;
  top.forEach(p=>{
    if(['QB','RB','WR','TE','OL'].includes(p.pos)){ off+=p.ovr; oc++; }
    else if(['DL','LB','CB','S'].includes(p.pos)){ def+=p.ovr; dc++; }
  });
  off= oc?off/oc:60; def= dc?def/dc:60;
  let base=(off+def)/2;
  // coaching bonus
  if(t.id===G.myTeamId){
    base += (G.coach.attr.GameMgmt-50)*0.06;
    base += (G.coach.attr.Motivation-50)*0.03;
    if(G.coach.traits.includes('genius')) base+=2.5;
    // your COACH RATING directly affects how your team plays — a hot, well-respected
    // coach gets more out of his roster; a struggling one less. (~ -3.7 .. +4.4 swing)
    base += ((G.coach.rating||55)-55)*0.10;
  } else {
    base += (t.coach.skill-55)*0.05;
  }
  return {overall:Math.round(base), off:Math.round(off), def:Math.round(def)};
}

function buildSchedule(){
  const t=myTeam();
  const conf=G.teams.filter(x=>x.conf===t.conf && x.id!==t.id);
  const nonconf=G.teams.filter(x=>x.conf!==t.conf && x.tier!=='IND');
  // 9 conf-ish + 3 nonconf (abstracted)
  const opps=[];
  const confGames = pickN(conf, Math.min(9,conf.length));
  const ncGames = pickN(nonconf, 12-confGames.length);
  let games=[...confGames.map(o=>({opp:o.id,conf:true})), ...ncGames.map(o=>({opp:o.id,conf:false}))];
  games=shuffle(games);
  // ensure a rival game late
  games.forEach((g,i)=>{ g.week=i+1; g.home= rng()<0.55; g.played=false; g.result=null; });
  G.schedule=games;
}

function initPolls(){
  // initial AP poll by team strength estimate (prestige + roster)
  const ranked=[...G.teams].filter(t=>t.tier!=='FCS').map(t=>({id:t.id, s:t.prestige*0.6 + teamStrength(t).overall*0.4 + rnd(-4,4)}));
  ranked.sort((a,b)=>b.s-a.s);
  G.apPoll=ranked.map(r=>r.id);
  G.cfpRank=[];
}

function updatePoll(){
  // rank by record + quality
  const scored=G.teams.map(t=>{
    const winPct = (t.w+t.l)>0 ? t.w/(t.w+t.l):0.5;
    const s = winPct*55 + teamStrength(t).overall*0.35 + t.prestige*0.08 - t.l*3 + rnd(-2,2);
    return {id:t.id, s};
  });
  scored.sort((a,b)=>b.s-a.s);
  G.apPoll=scored.map(s=>s.id);
  if(G.week>=8){ G.cfpRank=scored.map(s=>s.id); }
}

function rankOf(tid){ const i=G.apPoll.indexOf(tid); return i>=0?i+1:0; }

/* ---------------------------------------------------------------------------
   SECTION K — GAME SIMULATION ENGINE
   --------------------------------------------------------------------------- */
function simGame(homeId, awayId, opts={}){
  const home=teamById(homeId), away=teamById(awayId);
  const hs=teamStrength(home), as=teamStrength(away);
  let hAdj=hs.overall, aAdj=as.overall;
  // home field
  hAdj += 2.5 + home.fanbase*0.03;
  // rivalry boost (underdog plays up)
  const rivalry = home.rivals.includes(awayId)||away.rivals.includes(homeId);
  // gameplan (only my team)
  let myPlan = opts.plan;
  // momentum/variance
  const variance = opts.playoff? 7 : 11;
  // expected points from strength differential
  function teamScore(off, oppDef, strengthEdge, isMy){
    let base = 17 + (off-65)*0.7 - (oppDef-65)*0.45 + strengthEdge*0.5;
    base += gauss(0, variance);
    if(isMy && myPlan){
      if(myPlan.aggression>60) base += rnd(-3,6);
      if(myPlan.tempo>60) base += rnd(-1,4);
    }
    if(rivalry) base += gauss(0,4);
    return clamp(Math.round(base + (rng()<.5?rndi(0,7):0)),0,75);
  }
  const edge = hAdj-aAdj;
  let hScore = teamScore(hs.off, as.def, edge, homeId===G.myTeamId);
  let aScore = teamScore(as.off, hs.def, -edge, awayId===G.myTeamId);
  // riverboat trait — close-game edge
  if(opts.plan){
    const my = homeId===G.myTeamId?'h':'a';
    if(G.coach.traits.includes('clock') && Math.abs(hScore-aScore)<=7){
      if(my==='h') hScore+=rndi(0,4); else aScore+=rndi(0,4);
    }
  }
  if(hScore===aScore){ if(rng()<.5)hScore+=3; else aScore+=3; } // no ties
  return {homeId, awayId, hScore, aScore, rivalry, winnerId: hScore>aScore?homeId:awayId, loserId: hScore>aScore?awayId:homeId};
}

// generate a simple drive-by-drive feed for watch mode
function genGameFeed(res){
  const home=teamById(res.homeId), away=teamById(res.awayId);
  const feed=[];
  const total=res.hScore+res.aScore;
  let h=0,a=0;
  const events=Math.max(4,Math.round(total/7));
  for(let i=0;i<events;i++){
    const q=Math.min(4,Math.floor(i/events*4)+1);
    const scoringTeam = rng()< res.hScore/(total||1) ? 'h':'a';
    const pts = rng()<.78?7:3;
    if(scoringTeam==='h'&&h<res.hScore){ h+=pts; feed.push({q, txt:`${home.short} ${pts===7?'TOUCHDOWN':'field goal'} — ${pick(home.roster).name.split(' ')[1]}`, h,a}); }
    else if(a<res.aScore){ a+=pts; feed.push({q, txt:`${away.short} ${pts===7?'TOUCHDOWN':'field goal'} — ${pick(away.roster).name.split(' ')[1]}`, h,a}); }
  }
  // reconcile final
  feed.push({q:4, txt:'FINAL', h:res.hScore, a:res.aScore, final:true});
  return feed;
}

function applyGameResult(res){
  const home=teamById(res.homeId), away=teamById(res.awayId);
  const w=teamById(res.winnerId), l=teamById(res.loserId);
  w.w++; l.l++;
  if(home.conf===away.conf){ if(res.winnerId===home.id){home.cw++;away.cl++;}else{away.cw++;home.cl++;} }
  // injuries chance for my team
  if(res.homeId===G.myTeamId||res.awayId===G.myTeamId){ maybeInjury(myTeam()); }
}

function maybeInjury(t){
  if(rng()<0.22){
    const candidates=t.roster.filter(p=>!p.injury&&p.starter);
    if(candidates.length){
      const p=pick(candidates);
      const sev=pick(['Minor','Moderate','Moderate','Severe']);
      const weeks={Minor:rndi(1,2),Moderate:rndi(2,4),Severe:rndi(5,10)}[sev];
      p.injury={type:pick(['hamstring','ankle','shoulder','knee','concussion']),sev,weeksOut:weeks};
      if(t.id===G.myTeamId) pushNews('bad',`Injury: ${p.name}`,`Your ${p.pos} ${p.name} (${p.ovr} OVR) suffered a ${sev.toLowerCase()} ${p.injury.type} — out ~${weeks} week(s).`);
    }
  }
}

/* simulate all OTHER games in the league for the week */
function simLeagueWeek(){
  // pair up unscheduled teams loosely for realism of records
  const playing=G.teams.filter(t=>t.id!==G.myTeamId && t.tier!=='IND');
  const shuffled=shuffle(playing);
  for(let i=0;i+1<shuffled.length;i+=2){
    // bias pairing within conf occasionally
    const res=simGame(shuffled[i].id, shuffled[i+1].id);
    applyGameResult(res);
    // accumulate stats for both AI teams (so national leaderboards are populated)
    accumulateTeamStats(shuffled[i], res.homeId===shuffled[i].id?res.hScore:res.aScore);
    accumulateTeamStats(shuffled[i+1], res.homeId===shuffled[i+1].id?res.hScore:res.aScore);
  }
  // ND-equivalent
  const ind=G.teams.find(t=>t.tier==='IND');
  if(ind){ const opp=pick(G.teams.filter(t=>t.tier!=='IND'&&t.id!==G.myTeamId)); const r=simGame(ind.id,opp.id); applyGameResult(r); accumulateTeamStats(ind, r.homeId===ind.id?r.hScore:r.aScore); accumulateTeamStats(opp, r.homeId===opp.id?r.hScore:r.aScore); }
}

console.log('DYNASTY HC sim engine loaded');
</script>

<script>
/* ---------------------------------------------------------------------------
   SECTION L — NEWS
   --------------------------------------------------------------------------- */
function pushNews(type, headline, body){
  G.news.unshift({type, headline, body, year:G.year, week:G.week});
  if(G.news.length>120) G.news.length=120;
}

/* ---------------------------------------------------------------------------
   SECTION M — HUB SCREEN
   --------------------------------------------------------------------------- */
SCREENS.hub = function(s){
  const t=myTeam();
  const rank=rankOf(t.id);
  const next = G.schedule.find(g=>!g.played);
  const classRank = computeClassRank();
  const js=G.jobSecurity;
  const jsLabel = js<35?'SAFE':js<55?'STABLE':js<70?'WARM':js<85?'HOT SEAT':'ON THE BRINK';
  const jsColor = js<35?'var(--green)':js<55?'var(--blue)':js<70?'var(--accent2)':js<85?'var(--hot)':'var(--red)';

  let phaseBtn='';
  if(G.phase==='preseason') phaseBtn=`<button class="btn full lg gold" onclick="startSeason()">🏈 Start the ${G.year} Season</button>`;
  else if(G.phase==='regular' && next) phaseBtn=`<button class="btn full lg" onclick="go('schedule')">▶ Week ${G.week+1}: ${gameLabel(next)}</button>`;
  else if(G.phase==='regular' && !next) phaseBtn=`<button class="btn full lg gold" onclick="endRegularSeason()">📊 End Regular Season →</button>`;
  else if(G.phase==='confchamp') phaseBtn=`<button class="btn full lg gold" onclick="runConfChamps()">🏆 Conference Championships →</button>`;
  else if(G.phase==='playoff') phaseBtn=`<button class="btn full lg gold" onclick="go('schedule')">🎬 College Football Playoff →</button>`;
  else if(G.phase==='bowls') phaseBtn=`<button class="btn full lg" onclick="runBowls()">🎁 Bowl Season →</button>`;
  else if(G.phase==='awards') phaseBtn=`<button class="btn full lg gold" onclick="runAwards()">🏅 Awards Ceremony →</button>`;
  else if(G.phase==='carousel') phaseBtn=`<button class="btn full lg gold" onclick="startCarousel()">📈 Coaching Carousel →</button>`;
  else if(G.phase==='signing') phaseBtn=`<button class="btn full lg gold" onclick="runSigningDay()">✍️ National Signing Day →</button>`;
  else if(G.phase==='offseason') phaseBtn=`<button class="btn full lg gold" onclick="advanceToNextYear()">⏭️ Advance to ${G.year+1} →</button>`;

  s.innerHTML=`
  <div class="pad">
    <div class="card" style="background:linear-gradient(135deg,${t.colors[0]}22,var(--panel));border-color:${t.colors[0]}55">
      <div class="row between center">
        <div class="row gap12">
          ${teamBadge(t,52)}
          <div>
            <div class="display b lg">${t.short} ${t.masc}</div>
            <div class="muted sm">${t.w}-${t.l}${t.cw+t.cl>0?` (${t.cw}-${t.cl} ${t.confName})`:''} ${rank>0&&rank<=25?` • #${rank}`:''}</div>
          </div>
        </div>
        <div class="tc"><div class="display b xl" style="color:${ovrColor(teamStrength(t).overall)}">${Math.round(teamStrength(t).overall)}</div><div class="dim xs">TEAM</div></div>
      </div>
    </div>

    ${phaseBtn?`<div class="mb14">${phaseBtn}</div>`:''}

    <div class="grid2">
      <div class="card tight">
        <div class="dim xs up">Job Security</div>
        <div class="display b" style="font-size:18px;color:${jsColor}">${jsLabel}</div>
        <div class="meter mt6"><div style="width:${100-js}%;background:${jsColor}"></div></div>
        <div class="dim xs mt6">Yr ${G.coach.yearsAtJob+1} of contract</div>
      </div>
      <div class="card tight">
        <div class="dim xs up">Recruiting Class</div>
        <div class="display b" style="font-size:18px;color:var(--accent2)">#${classRank.rank}</div>
        <div class="dim xs mt6">${classRank.commits} commits • ${classRank.signed} signed</div>
        <button class="btn ghost sm full mt6" onclick="go('recruit')">Open Board</button>
      </div>
    </div>

    <div class="card tight" style="border-color:#ffb01f55">
      <div class="row between"><span class="dim xs up">AD Expectation</span><span class="chip gold" style="padding:2px 8px">${G.year}</span></div>
      <div class="sm mt6">"${G.adExpectation.goal}"</div>
    </div>

    <h2 class="sec">📰 Around the Nation</h2>
    <div id="hubNews"></div>
    <button class="btn ghost sm full" onclick="go('world')">See full news feed →</button>

    <div class="mt20 tc">
      <button class="btn ghost sm" onclick="openSettings()">⚙️ Settings &amp; Save</button>
    </div>
  </div>`;

  const hn=$('#hubNews');
  G.news.slice(0,4).forEach(n=>{
    const d=el('div','news '+(n.type||''));
    d.innerHTML=`<div class="nh">${n.headline}</div><div class="nb">${n.body}</div>`;
    hn.appendChild(d);
  });
  if(!G.news.length) hn.innerHTML='<div class="muted sm tc pad">No news yet. Start your season!</div>';
};

function gameLabel(g){
  const opp=teamById(g.opp);
  const r=rankOf(opp.id);
  return `${g.home?'vs':'@'} ${r>0&&r<=25?'#'+r+' ':''}${opp.short}`;
}

function computeClassRank(){
  const myCommits=G.recruits.filter(r=>r.committed===G.myTeamId);
  const signed=myCommits.filter(r=>r.signed).length;
  // rank classes by sum of star points
  const teamPoints={};
  G.recruits.forEach(r=>{ if(r.committed){ teamPoints[r.committed]=(teamPoints[r.committed]||0)+Math.pow(r.stars,2.5)+r.trueOvr*0.1; } });
  const ranked=Object.entries(teamPoints).sort((a,b)=>b[1]-a[1]).map(e=>e[0]);
  const myRank=ranked.indexOf(G.myTeamId)+1;
  return {rank: myRank>0?myRank:'—', commits:myCommits.length, signed};
}

/* ---------------------------------------------------------------------------
   SECTION N — SETTINGS
   --------------------------------------------------------------------------- */
function openSettings(){
  modal(`
  <div class="display b lg tc mb14">Settings</div>
  <button class="btn ghost full mb10" onclick="save();toast('💾 Game saved')">💾 Save Now</button>
  <button class="btn ghost full mb10" onclick="exportSave()">📤 Export Save (copy)</button>
  <button class="btn ghost full mb10" onclick="importSavePrompt()">📥 Import Save</button>
  <button class="btn red full" onclick="closeModal();confirmQuit()">🚪 Quit to Title (saves)</button>
  <div class="dim xs tc mt14">Coach: ${G.coach.name} • ${G.coach.archName}<br>Career: ${G.coach.careerWins}-${G.coach.careerLosses} • ${G.coach.natTitles} titles</div>
  `);
}
function confirmQuit(){ save(); showTitle(); }
function exportSave(){
  save();
  const data=localStorage.getItem(CONFIG.SAVE_KEY)||JSON.stringify(G);
  modal(`<div class="display b lg tc mb10">Export Save</div><p class="muted sm tc mb10">Copy this text to back up your career.</p><textarea class="searchbar" style="height:140px;font-size:10px" readonly onclick="this.select()">${data}</textarea><button class="btn full mt10" onclick="navigator.clipboard&&navigator.clipboard.writeText(document.querySelector('#modal textarea').value);toast('Copied!')">Copy to Clipboard</button>`);
}
function importSavePrompt(){
  modal(`<div class="display b lg tc mb10">Import Save</div><p class="muted sm tc mb10">Paste an exported save below.</p><textarea class="searchbar" id="impText" style="height:140px;font-size:10px" placeholder="Paste JSON…"></textarea><button class="btn full mt10" onclick="doImport()">Load This Save</button>`);
}
function doImport(){
  try{
    const txt=$('#impText').value.trim();
    const obj=JSON.parse(txt);
    if(!obj.coach||!obj.teams) throw 'bad';
    G=obj; SEED=G.seed||SEED; save(); closeModal(); go('hub'); toast('Save loaded!');
  }catch(e){ toast('Invalid save data'); }
}

console.log('DYNASTY HC hub + news loaded');
</script>

<script>
/* ---------------------------------------------------------------------------
   SECTION O — SEASON FLOW
   --------------------------------------------------------------------------- */
function startSeason(){
  G.phase='regular'; G.week=0;
  // reset records
  G.teams.forEach(t=>{ t.w=0;t.l=0;t.cw=0;t.cl=0;t.apRank=0;t.cfpRank=0; });
  // rebuild this season's schedule (every game fresh & unplayed)
  buildSchedule();
  // heal minor injuries from offseason
  myTeam().roster.forEach(p=>{ if(p.injury&&p.injury.weeksOut<=0)p.injury=null; });
  setDepthChart(myTeam());
  initPolls();
  G.recruitPoints = recruitPointsPerWeek();
  pushNews('big',`${G.year} season kicks off`,`Preseason #${rankOf(myTeam().id)||'NR'} ${myTeam().short}. ${G.adExpectation.goal}`);
  preseasonCutscene();
}

function recruitPointsPerWeek(){
  let p=CONFIG.RECRUIT_POINTS_BASE;
  p += Math.round((G.coach.attr.Recruiting-50)*0.12);
  if(G.coach.traits.includes('closer')) p+=2;
  if(G.coach.arch==='savant') p+=3;
  return clamp(p,6,30);
}

function preseasonCutscene(){
  const t=myTeam();
  cutscene(`linear-gradient(135deg,${t.colors[0]}aa,#0a0e14)`,`
    <div style="animation:fadeIn .6s;display:flex;flex-direction:column;align-items:center">
      <div class="display" style="font-size:14px;letter-spacing:4px;color:var(--accent2)">${G.year} SEASON</div>
      <div class="display b" style="font-size:40px;line-height:1;margin-top:8px;color:#fff">KICKOFF</div>
      <div class="mt14">${teamBadge(t,72)}</div>
      <div class="mt14" style="color:#fff;font-size:15px">Preseason Ranking: <b>${rankOf(t.id)<=25?'#'+rankOf(t.id):'Unranked'}</b></div>
      <button class="btn lg gold mt20" onclick="closeCut();go('schedule')">View Schedule →</button>
    </div>`);
}

/* ---------------------------------------------------------------------------
   SCHEDULE / GAME-DAY SCREEN
   --------------------------------------------------------------------------- */
SCREENS.schedule = function(s){
  const t=myTeam();
  if(G.phase==='playoff'){ return renderPlayoffScreen(s); }
  const next=G.schedule.find(g=>!g.played);
  s.innerHTML=`<div class="pad">
    <div class="display b" style="font-size:22px">${G.year} Schedule</div>
    <div class="muted sm">${t.name} • ${t.w}-${t.l}</div>
    <div id="schedList" class="mt14"></div>
  </div>`;
  const sl=$('#schedList');
  G.schedule.forEach(g=>{
    const opp=teamById(g.opp);
    const isNext = g===next;
    const d=el('div','card tight'+(isNext?'':''));
    if(isNext) d.style.borderColor='var(--accent)';
    let resHTML='';
    if(g.played){
      const won=g.result.winnerId===t.id;
      const myS = g.home?g.result.hScore:g.result.aScore;
      const oppS= g.home?g.result.aScore:g.result.hScore;
      resHTML=`<span class="pill" style="background:${won?'rgba(46,204,113,.2)':'rgba(255,71,87,.2)'};color:${won?'var(--green)':'var(--red)'}">${won?'W':'L'} ${myS}-${oppS}</span>`;
    } else if(isNext){
      resHTML=`<span class="chip accent" style="padding:3px 9px">NEXT</span>`;
    }
    d.innerHTML=`<div class="row between center">
      <div class="row gap10">
        <div class="dim" style="width:28px;font-family:'Oswald'">W${g.week}</div>
        ${teamBadge(opp,36)}
        <div><div class="b sm">${g.home?'vs':'@'} ${opp.short}</div><div class="dim xs">${opp.confName} ${rankOf(opp.id)<=25&&rankOf(opp.id)>0?'• #'+rankOf(opp.id):''}${g.conf?' • Conf':''}${opp.rivals&&opp.rivals.includes(t.id)?' • 🔥RIVAL':''}</div></div>
      </div>
      ${resHTML}
    </div>`;
    if(isNext){ d.style.cursor='pointer'; d.onclick=()=>openGameDay(g); }
    sl.appendChild(d);
  });
  if(next){
    const b=el('button','btn full lg gold mt10','🏈 Play Week '+(G.week+1)+': '+gameLabel(next));
    b.onclick=()=>openGameDay(next);
    sl.appendChild(b);
  } else if(G.phase==='regular'){
    const b=el('button','btn full lg mt10','📊 End Regular Season →');
    b.onclick=()=>endRegularSeason();
    sl.appendChild(b);
  }
};

function openGameDay(g){
  const t=myTeam(), opp=teamById(g.opp);
  const ts=teamStrength(t), os=teamStrength(opp);
  const rivalry = opp.rivals.includes(t.id)||t.rivals.includes(opp.id);
  modal(`
  <div class="tc">
    <div class="display" style="font-size:12px;letter-spacing:3px;color:var(--accent2)">${rivalry?'🔥 RIVALRY GAME':'WEEK '+(G.week+1)}</div>
    <div class="row between center mt14">
      <div class="fg" style="display:flex;flex-direction:column;align-items:center">${teamBadge(t,52)}<div class="b sm mt6">${t.short}</div><div class="dim xs">${t.w}-${t.l}</div></div>
      <div class="display dim">VS</div>
      <div class="fg" style="display:flex;flex-direction:column;align-items:center">${teamBadge(opp,52)}<div class="b sm mt6">${opp.short}</div><div class="dim xs">${opp.w}-${opp.l}</div></div>
    </div>
    <div class="dim xs mt10">${g.home?'🏟️ Home — '+t.city:'✈️ Away @ '+opp.city} • ${t.weather} • Team ${Math.round(ts.overall)} vs ${Math.round(os.overall)}</div>
  </div>
  <h2 class="sec">Gameplan</h2>
  <div class="card tight">
    ${planSlider('tempo','Tempo','Slow','Fast')}
    ${planSlider('aggression','Aggressiveness','Conservative','Aggressive')}
    ${planSlider('blitz','Blitz Frequency','Rare','Heavy')}
    ${planSlider('fourth','4th Down','Punt it','Go for it')}
  </div>
  <div class="grid2 mt10">
    <button class="btn green" onclick="playGame('${g.week}','instant')">⚡ Instant Sim</button>
    <button class="btn" onclick="playGame('${g.week}','watch')">📺 Watch</button>
  </div>
  <button class="btn full lg gold mt10" onclick="playGame('${g.week}','live')">🏈 PLAY LIVE — Call the Plays</button>
  `);
}
function planSlider(id,label,lo,hi){
  return `<div class="mb10"><div class="row between xs muted mb6"><span><b style="color:var(--txt)">${label}</b></span></div>
  <input type="range" min="0" max="100" value="50" id="plan_${id}">
  <div class="row between dim" style="font-size:9px"><span>${lo}</span><span>${hi}</span></div></div>`;
}

function readPlan(){
  return {
    tempo:+($('#plan_tempo')?.value||50),
    aggression:+($('#plan_aggression')?.value||50),
    blitz:+($('#plan_blitz')?.value||50),
    fourth:+($('#plan_fourth')?.value||50),
  };
}

function playGame(week, mode){
  const g=G.schedule.find(x=>x.week==week);
  const plan=readPlan();
  closeModal();
  const homeId = g.home? G.myTeamId : g.opp;
  const awayId = g.home? g.opp : G.myTeamId;
  if(mode==='live'){
    startLiveGame(g, homeId, awayId, plan);
    return;
  }
  const res=simGame(homeId, awayId, {plan});
  if(mode==='instant'){
    finishGame(g,res);
  } else {
    watchGame(g,res);
  }
}

function watchGame(g, res){
  const feed=genGameFeed(res);
  const home=teamById(res.homeId), away=teamById(res.awayId);
  let idx=0;
  const c=$('#cut');
  cutscene(`linear-gradient(160deg,${home.colors[0]}55,#0a0e14 70%)`,`
    <div style="width:100%;max-width:380px">
      <div class="row between center mb14">
        <div class="tc fg">${teamBadge(away,44)}<div class="b xs mt6">${away.short}</div></div>
        <div id="liveScore" class="display b" style="font-size:34px">0 - 0</div>
        <div class="tc fg">${teamBadge(home,44)}<div class="b xs mt6">${home.short}</div></div>
      </div>
      <div id="liveQ" class="chip accent" style="margin:0 auto;display:block;width:fit-content">Q1</div>
      <div id="liveFeed" style="height:200px;overflow-y:auto;margin-top:14px;text-align:left"></div>
      <button id="liveSkip" class="btn ghost full mt14" onclick="skipWatch()">Skip to Final ⏭️</button>
    </div>
  `);
  window._watch={feed,idx:0,g,res,home,away,timer:null};
  advanceWatch();
}
function advanceWatch(){
  const w=window._watch; if(!w) return;
  if(w.idx>=w.feed.length){ endWatch(); return; }
  const ev=w.feed[w.idx++];
  const sc=$('#liveScore'), q=$('#liveQ'), fd=$('#liveFeed');
  if(sc){
    sc.textContent=`${w.g.home?ev.h:ev.a} - ${w.g.home?ev.a:ev.h}`;
    q.textContent= ev.final?'FINAL':'Q'+ev.q;
    if(!ev.final){
      const line=el('div','sm',`<span class="dim xs">Q${ev.q}</span> ${ev.txt}`);
      line.style.padding='6px 0'; line.style.borderBottom='1px solid var(--line)';
      fd.prepend(line);
    }
  }
  if(ev.final){ setTimeout(endWatch,600); return; }
  w.timer=setTimeout(advanceWatch, 850);
}
function skipWatch(){ const w=window._watch; if(w){clearTimeout(w.timer);} endWatch(); }
function endWatch(){
  const w=window._watch; if(!w)return; clearTimeout(w.timer);
  const sc=$('#liveScore'); if(sc) sc.textContent=`${w.g.home?w.res.hScore:w.res.aScore} - ${w.g.home?w.res.aScore:w.res.hScore}`;
  const won=w.res.winnerId===G.myTeamId;
  const sk=$('#liveSkip');
  if(sk){ sk.className='btn full lg '+(won?'green':'red'); sk.textContent= (won?'✅ Victory!':'❌ Defeat')+' — Continue'; sk.onclick=()=>{closeCut();finishGame(w.g,w.res);}; }
  window._watch=null;
}

function finishGame(g, res){
  g.played=true; g.result=res;
  applyGameResult(res);
  // record player stats abstractly
  recordStats(res);
  simLeagueWeek();
  G.week++;
  updatePoll();
  recruitTick(); // recruiting progresses weekly
  portalTick();
  // news for notable result
  const won=res.winnerId===G.myTeamId;
  const opp=teamById(g.opp);
  const myS=g.home?res.hScore:res.aScore, oppS=g.home?res.aScore:res.hScore;
  if(res.rivalry){
    pushNews(won?'good':'bad',`${won?'Rivalry win!':'Rivalry loss'} ${myTeam().short} ${myS}-${oppS} ${opp.short}`,won?`Bragging rights secured. The win cools the hot seat.`:`A bitter loss to a rival. The fans are restless.`);
    G.jobSecurity += won?-6:6;
  } else if((rankOf(opp.id)<=12&&rankOf(opp.id)>0) && won){
    pushNews('good',`UPSET! ${myTeam().short} stuns #${rankOf(opp.id)} ${opp.short}`,`A signature ${myS}-${oppS} win that will turn heads nationally.`);
    G.jobSecurity-=4;
  }
  G.jobSecurity = clamp(G.jobSecurity + (won?-1.5:3), 0, 100);
  updateCoachRating(res, won, myS, oppS, opp);
  // mid-season firing check
  checkMidseasonFiring();
  save();
  gameResultCutscene(g,res);
}

function updateCoachRating(res, won, myS, oppS, opp){
  const c=G.coach;
  const oppRank=rankOf(opp.id);
  const margin=myS-oppS;
  let d=0;
  if(won){
    d = 1.0;                                   // base for any win
    if(oppRank>0 && oppRank<=10) d += 2.2;     // beating a top-10 team
    else if(oppRank>0 && oppRank<=25) d += 1.2;// beating a ranked team
    if(res.rivalry) d += 0.8;                  // rivalry win
    if(margin>=28) d += 0.4;                   // dominant
    // beating a much stronger program means more
    if(opp.prestige > myTeam().prestige+12) d += 1.0;
  } else {
    d = -1.2;                                  // base for any loss
    if(margin<=-28) d -= 1.6;                  // blown out
    if(oppRank===0 || oppRank>40) d -= 1.2;    // losing to an unranked/weak team stings
    if(res.rivalry) d -= 0.8;                  // rivalry loss
    // losing to a much weaker program is bad
    if(opp.prestige < myTeam().prestige-12) d -= 1.2;
  }
  // ratings near the ceiling/floor move less (harder to gain at the top)
  if(d>0 && c.rating>80) d*=0.6;
  if(d<0 && c.rating<35) d*=0.6;
  c.lastRatingDelta = +d.toFixed(1);
  c.rating = clamp(+(c.rating + d).toFixed(1), 1, 99);
}

function recordStats(res){
  // Detailed box-score-style accumulation for every contributing player on both teams.
  // Scales loosely with the game's scoring so big wins produce big stat lines.
  [res.homeId,res.awayId].forEach(tid=>{
    const t=teamById(tid);
    const myPts = tid===res.homeId?res.hScore:res.aScore;
    accumulateTeamStats(t, myPts);
  });
  // decrement injuries each week (player team only)
  myTeam().roster.forEach(p=>{ if(p.injury){ p.injury.weeksOut--; if(p.injury.weeksOut<=0){ pushNews('good',`${p.name} returns`,`Your ${p.pos} is healthy and back in the lineup.`); p.injury=null; } } });
}

function ss(p){ if(!p.seasonStats) p.seasonStats={}; return p.seasonStats; }
function addStat(p,k,v){ const s=ss(p); s[k]=(s[k]||0)+v; }

function accumulateTeamStats(t, teamPts){
  const avail = p => !p.injury || p.injury.weeksOut<=0;
  const top = (pos,n=1)=> t.roster.filter(p=>p.pos===pos&&avail(p)).sort((a,b)=>b.ovr-a.ovr).slice(0,n);
  const off = teamStrength(t).off;
  const scale = clamp(teamPts/24, 0.4, 2.0); // production scales with how much they scored
  const skill = (p)=> (p.ovr-60)/40; // -0.5 .. ~1

  // ---- PASSING (QB1 gets the bulk, QB2 a sliver) ----
  const qbs=top('QB',2);
  qbs.forEach((qb,i)=>{
    const share = i===0?1:0.12;
    const att = Math.round(rndi(22,40)*share*(0.8+skill(qb)*0.3));
    const compPct = clamp(0.55+skill(qb)*0.14+rnd(-0.06,0.06),0.4,0.78);
    const comp = Math.round(att*compPct);
    const yds = Math.round((comp*rnd(9,14))*scale);
    const td = Math.max(0, Math.round((yds/110)*scale + (rng()<skill(qb)?1:0)));
    const ints = rng()<(0.35-skill(qb)*0.2)?rndi(1,2):0;
    if(att>0){
      addStat(qb,'passAtt',att); addStat(qb,'passComp',comp);
      addStat(qb,'passYds',yds); addStat(qb,'passTD',td); addStat(qb,'int',ints);
      addStat(qb,'gp',1);
      // QB rushing
      const ry=Math.round(rnd(-4,40)*(0.5+skill(qb)));
      if(ry>3){ addStat(qb,'rushAtt',rndi(3,9)); addStat(qb,'rushYds',ry); if(rng()<0.3)addStat(qb,'rushTD',1); }
    }
  });

  // ---- RUSHING (RB committee + maybe a WR jet) ----
  const rbs=top('RB',3);
  let rbShare=[0.62,0.28,0.10];
  rbs.forEach((rb,i)=>{
    const car=Math.round(rndi(8,24)*rbShare[i]*(0.7+scale*0.4));
    if(car<2) return;
    const ypc=clamp(rnd(3.4,6.2)+skill(rb)*1.2,2.2,9);
    const yds=Math.round(car*ypc);
    const td=Math.max(0,Math.round((yds/90)*scale+(rng()<skill(rb)*0.6?1:0)));
    addStat(rb,'rushAtt',car); addStat(rb,'rushYds',yds); addStat(rb,'rushTD',td); addStat(rb,'gp',1);
    // RBs catch passes too
    if(rng()<0.6){ const rec=rndi(1,5),recy=Math.round(rec*rnd(5,11)); addStat(rb,'rec',rec); addStat(rb,'recYds',recy); if(rng()<0.15)addStat(rb,'recTD',1); }
  });

  // ---- RECEIVING (WRs + TEs share targets) ----
  const recvs=[...top('WR',4),...top('TE',2)].sort((a,b)=>b.ovr-a.ovr);
  const shares=[0.30,0.22,0.16,0.12,0.12,0.08];
  recvs.forEach((w,i)=>{
    const tgtBase=rndi(14,30);
    const rec=Math.max(0,Math.round(tgtBase*(shares[i]||0.05)*(0.7+skill(w)*0.5)*scale));
    if(rec<1) return;
    const ypr=clamp(rnd(8,17)+skill(w)*3,5,28);
    const yds=Math.round(rec*ypr);
    const td=Math.max(0,Math.round((yds/120)*scale+(rng()<skill(w)*0.5?1:0)));
    addStat(w,'rec',rec); addStat(w,'recYds',yds); addStat(w,'recTD',td); addStat(w,'gp',1);
  });

  // ---- DEFENSE (front 7 + secondary) ----
  const defs=[...top('DL',4),...top('LB',4),...top('CB',3),...top('S',3)];
  defs.forEach(d=>{
    const tk=rndi(2,9);
    addStat(d,'tackles',tk); addStat(d,'gp',1);
    if((d.pos==='DL'||d.pos==='LB') && rng()<0.30+skill(d)*0.2){ addStat(d,'sacks', rng()<0.3?2:1); addStat(d,'tfl',rndi(1,2)); }
    if((d.pos==='CB'||d.pos==='S') && rng()<0.18+skill(d)*0.15){ addStat(d,'intDef',1); }
    if(rng()<0.10+skill(d)*0.1){ addStat(d,'pbu',rndi(1,2)); }
    if(rng()<0.05){ addStat(d,'ff',1); }
  });

  // ---- KICKING ----
  const k=top('K',1)[0];
  if(k){
    const fga=rndi(0,3), fgm=Math.max(0,Math.round(fga*clamp(0.7+skill(k)*0.25,0.5,0.98)));
    const xpa=Math.round(teamPts/9), xpm=Math.max(0,Math.round(xpa*clamp(0.92+skill(k)*0.07,0.8,1)));
    if(fga||xpa){ addStat(k,'fgm',fgm); addStat(k,'fga',fga); addStat(k,'xpm',xpm); addStat(k,'xpa',xpa); addStat(k,'kpts',fgm*3+xpm); addStat(k,'gp',1); }
  }
}

function gameResultCutscene(g, res){
  const won=res.winnerId===G.myTeamId;
  const opp=teamById(g.opp), t=myTeam();
  const myS=g.home?res.hScore:res.aScore, oppS=g.home?res.aScore:res.hScore;
  cutscene(`linear-gradient(160deg,${won?'#1e9e57':'#ff4757'}33,#0a0e14 65%)`,`
    <div style="animation:fadeIn .5s">
      <div class="display b" style="font-size:42px;color:${won?'var(--green)':'var(--red)'}">${won?'WIN':'LOSS'}</div>
      <div class="row between center mt14" style="width:280px">
        <div class="tc fg">${teamBadge(t,44)}<div class="b sm mt6">${t.short}</div></div>
        <div class="display b xl">${myS} - ${oppS}</div>
        <div class="tc fg">${teamBadge(opp,44)}<div class="b sm mt6">${opp.short}</div></div>
      </div>
      <div class="muted sm mt14">Record now ${t.w}-${t.l}</div>
      <button class="btn lg gold mt20" onclick="closeCut();go('hub')">Continue →</button>
      <button class="btn ghost mt10" onclick="closeCut();go('recruit')">🎯 Recruit (${G.recruitPoints} pts) →</button>
    </div>`, {confetti:won&&res.rivalry});
}

function checkMidseasonFiring(){
  if(G.jobSecurity>=100 && G.coach.yearsAtJob>=1 && myTeam().l>=6){
    fireCoach('disastrous start');
  }
}

console.log('DYNASTY HC season + gameday loaded');
</script>
<script>
/* ---------------------------------------------------------------------------
   LIVE GAME — interactive play-calling (PocketGM-style).
   You control offense (run/pass/deep/FG/punt/4th-down); defense auto.
   Outcomes weighted by your O vs their D, key player OVRs, and gameplan.
   Builds a real score; resolves through finishGame() like any other game.
   --------------------------------------------------------------------------- */
let LIVE=null;

function startLiveGame(g, homeId, awayId, plan){
  const home=teamById(homeId), away=teamById(awayId);
  const myIsHome = homeId===G.myTeamId;
  const opp = myIsHome?away:home;
  const me = myIsHome?home:away;
  const ms=teamStrength(me), os=teamStrength(opp);
  LIVE={
    g, homeId, awayId, myIsHome, me, opp, plan,
    msOff:ms.off, msDef:ms.def, osOff:os.off, osDef:os.def,
    myScore:0, oppScore:0,
    qtr:1, clock:15*60, // seconds in quarter
    poss: rng()<0.5?'me':'opp', // who has the ball
    down:1, toGo:10, ballOn:25, // yards from own goal (0..100, 100=opp endzone)
    feed:[], driveStartScore:0, lastResult:'',
    awaitInput:false, over:false,
  };
  pushFeed(`🏈 Kickoff! ${me.short} ${myIsHome?'host':'visit'} ${opp.short}.`, 'big');
  renderLive();
  // if opponent gets the ball first, run their drive
  if(LIVE.poss==='opp'){ setTimeout(()=>oppDrive(), 500); }
  else { LIVE.awaitInput=true; renderLive(); }
}

function pushFeed(txt, type){ LIVE.feed.unshift({txt,type}); if(LIVE.feed.length>40)LIVE.feed.pop(); }
function fmtClock(s){ const m=Math.floor(s/60), ss=s%60; return m+':'+String(ss).padStart(2,'0'); }
function fmtDown(){ const o=['1st','2nd','3rd','4th'][LIVE.down-1]; const yd= LIVE.toGo>=(100-LIVE.ballOn)?'Goal':LIVE.toGo; return `${o} & ${yd}`; }
function fieldPos(){ const own=LIVE.ballOn; return own<50?`Own ${own}`: own>50?`Opp ${100-own}`:'50'; }

function liveTopHTML(){
  const me=LIVE.me, opp=LIVE.opp;
  const myBall=LIVE.poss==='me';
  // field bar (0..100 toward opp endzone)
  const ball=clamp(LIVE.ballOn,0,100);
  const fyTo = clamp(LIVE.ballOn+LIVE.toGo,0,100);
  return `
    <div class="row between center mb6" style="width:100%">
      <div style="display:flex;flex-direction:column;align-items:center;flex:1">${teamBadge(LIVE.myIsHome?me:opp, 40)}<div class="b xs mt6">${(LIVE.myIsHome?me:opp).short}</div></div>
      <div class="tc">
        <div class="display b" style="font-size:30px;line-height:1">${LIVE.myIsHome?LIVE.myScore:LIVE.oppScore} - ${LIVE.myIsHome?LIVE.oppScore:LIVE.myScore}</div>
        <div class="chip accent xs" style="margin-top:4px">Q${LIVE.qtr} · ${fmtClock(LIVE.clock)}</div>
      </div>
      <div style="display:flex;flex-direction:column;align-items:center;flex:1">${teamBadge(LIVE.myIsHome?opp:me, 40)}<div class="b xs mt6">${(LIVE.myIsHome?opp:me).short}</div></div>
    </div>
    <div class="tc sm" style="color:${myBall?'var(--accent2)':'var(--txt2)'}">
      ${myBall?'🟢 '+me.short+' ball':'🔴 '+opp.short+' ball'} · ${fmtDown()} · ${fieldPos()}
    </div>
    <div class="field" style="position:relative;height:14px;border-radius:7px;background:linear-gradient(90deg,#1d3a24,#163018);margin:8px 0;overflow:hidden;border:1px solid var(--line)">
      <div style="position:absolute;left:${ball}%;top:-2px;width:3px;height:18px;background:var(--accent2);box-shadow:0 0 6px var(--accent2)"></div>
      ${myBall?`<div style="position:absolute;left:${fyTo}%;top:0;width:2px;height:14px;background:#ffd23f88"></div>`:''}
    </div>`;
}

function renderLive(){
  const me=LIVE.me;
  let controls='';
  if(LIVE.over){
    const won=LIVE.myScore>LIVE.oppScore;
    controls=`<button class="btn full lg ${won?'green':'red'}" onclick="endLiveGame()">${won?'✅ Victory!':'❌ Defeat'} — Continue →</button>`;
  } else if(LIVE.awaitInput && LIVE.poss==='me'){
    const goalToGo = LIVE.toGo>=(100-LIVE.ballOn);
    const inFGRange = LIVE.ballOn>=55;
    controls=`
      <div class="grid2 gap6">
        <button class="btn" onclick="callPlay('run')">🏃 Run</button>
        <button class="btn" onclick="callPlay('short')">🎯 Short Pass</button>
        <button class="btn" onclick="callPlay('deep')">🚀 Deep Pass</button>
        <button class="btn ${LIVE.down===4?'gold':'outline'}" onclick="callPlay('4th')">💪 ${LIVE.down===4?'Go For It':'Trick Play'}</button>
      </div>
      <div class="grid2 gap6 mt6">
        <button class="btn outline ${inFGRange?'':'dim'}" onclick="callPlay('fg')">🦵 Field Goal${inFGRange?'':' (long)'}</button>
        <button class="btn outline" onclick="callPlay('punt')">👟 Punt</button>
      </div>`;
  } else {
    controls=`<div class="tc mut sm" style="padding:10px">${LIVE.opp.short} on offense…</div>`;
  }
  cutscene(`linear-gradient(160deg,${me.colors[0]}33,#0a0e14 60%)`,`
    <div style="width:100%;max-width:400px">
      ${liveTopHTML()}
      <div id="liveFeed" style="height:150px;overflow-y:auto;text-align:left;margin:10px 0;padding:4px;background:rgba(0,0,0,.2);border-radius:10px">
        ${LIVE.feed.map(f=>`<div class="${f.type==='big'?'b':''} sm" style="padding:5px 7px;border-bottom:1px solid var(--line);${f.type==='score'?'color:var(--accent2)':f.type==='turnover'?'color:var(--red)':''}">${f.txt}</div>`).join('')}
      </div>
      ${controls}
      ${!LIVE.over?`<button class="btn ghost full mt6" onclick="simRestOfGame()">⏭️ Sim Rest of Game</button>`:''}
    </div>
  `);
}

/* key player names for flavor */
function keyGuy(team, posList){
  const p=team.roster.filter(x=>posList.includes(x.pos)&&(!x.injury||x.injury.weeksOut<=0)).sort((a,b)=>b.ovr-a.ovr)[0];
  return p?p.name.split(' ').slice(-1)[0]:'the offense';
}

function callPlay(type){
  if(!LIVE||!LIVE.awaitInput||LIVE.poss!=='me'||LIVE.over) return;
  LIVE.awaitInput=false;
  const me=LIVE.me, opp=LIVE.opp;
  const offEdge=(LIVE.msOff - LIVE.osDef); // + = my offense better
  const plan=LIVE.plan||{};
  const qb=keyGuy(me,['QB']), rb=keyGuy(me,['RB']), wr=keyGuy(me,['WR','TE']);
  let yards=0, turnover=false, txt='', special=null;

  if(type==='punt'){
    pushFeed(`${me.short} punts it away.`,'');
    changePossession(true);
    return;
  }
  if(type==='fg'){
    const dist = (100-LIVE.ballOn)+17;
    let chance = clamp(0.96 - Math.max(0,dist-25)*0.018 + (keyFG(me))*0.003, 0.25, 0.98);
    if(rng()<chance){
      LIVE.myScore+=3; pushFeed(`🦵 ${dist}-yd field goal is GOOD! ${me.short} +3`,'score');
      runClock(6); changePossession(false, true);
    } else {
      pushFeed(`🦵 ${dist}-yd field goal is NO GOOD.`,'turnover');
      runClock(6); changePossession(true);
    }
    return;
  }

  // offensive play resolution
  const aggr = (plan.aggression||50)/100;
  if(type==='run'){
    const base = 4.6 + offEdge*0.09 + gauss(0,3);
    yards=Math.round(base + (rng()<0.14?rndi(8,32):0));
    turnover = rng()<0.010;
    txt = turnover?`💥 FUMBLE! ${rb} coughs it up!`:`🏃 ${rb} runs for ${yards} yd.`;
  } else if(type==='short'){
    const comp = clamp(0.66 + offEdge*0.006, 0.45, 0.92);
    if(rng()<comp){ yards=Math.round(7 + offEdge*0.08 + gauss(0,4) + (rng()<0.12?rndi(10,28):0)); txt=`🎯 ${qb} → ${wr} for ${yards} yd.`; }
    else { yards=0; turnover=rng()<0.025; txt=turnover?`🚨 INTERCEPTED! ${qb}'s pass picked off!`:`Incomplete pass.`; }
  } else if(type==='deep'){
    const comp = clamp(0.44 + offEdge*0.005, 0.24, 0.74);
    if(rng()<comp){ yards=Math.round(24 + offEdge*0.1 + gauss(0,8)); txt=`🚀 DEEP STRIKE! ${qb} → ${wr} for ${yards} yd!`; }
    else { yards=0; turnover=rng()<0.06; txt=turnover?`🚨 INTERCEPTED deep! Picked off!`:`Deep ball falls incomplete.`; }
  } else if(type==='4th'){
    if(LIVE.down===4){
      // go for it
      const base=5+offEdge*0.08+gauss(0,4); yards=Math.round(base);
      txt=`💪 ${me.short} goes for it! ${rb} gets ${yards}.`;
    } else {
      // trick play — boom or bust
      if(rng()<0.5){ yards=Math.round(18+offEdge*0.1+gauss(0,10)); txt=`🎩 Trick play works! ${yards} yd gain!`; }
      else { yards=Math.round(gauss(-2,3)); turnover=rng()<0.1; txt=turnover?`🚨 Trick play blows up — turnover!`:`🎩 Trick play stuffed for ${yards}.`; }
    }
  }

  runClock(type==='deep'?rndi(15,30):rndi(25,42));
  pushFeed(txt, turnover?'turnover':'');

  if(turnover){ changePossession(true); return; }

  // advance ball
  LIVE.ballOn = clamp(LIVE.ballOn + yards, 0, 100);
  LIVE.toGo -= yards;

  // touchdown?
  if(LIVE.ballOn>=100){
    LIVE.myScore+=7; pushFeed(`🏈 TOUCHDOWN ${me.short}! (+7)`,'score');
    runClock(4); changePossession(false, true); return;
  }
  // first down?
  if(LIVE.toGo<=0){
    LIVE.down=1; LIVE.toGo=Math.min(10, 100-LIVE.ballOn);
    pushFeed(`🟢 First down ${me.short}!`,'');
  } else {
    LIVE.down++;
    if(LIVE.down>4){
      pushFeed(`⛔ Turnover on downs.`,'turnover');
      changePossession(true); return;
    }
  }
  checkQuarter();
  LIVE.awaitInput=true; renderLive();
}

function keyFG(team){ const k=team.roster.find(p=>p.pos==='K'); return k?k.ovr:65; }

function changePossession(toOpp, fromScore){
  // reset to a fresh drive for the new offense
  LIVE.down=1; LIVE.toGo=10;
  LIVE.ballOn= fromScore? 25 : (100-LIVE.ballOn); // flip field
  LIVE.ballOn = clamp(LIVE.ballOn,15,35); // realistic-ish start
  if(checkQuarter(true)) return;
  if(toOpp || (LIVE.poss==='me')){ LIVE.poss = LIVE.poss==='me'?'opp':'me'; }
  if(LIVE.poss==='opp'){ renderLive(); setTimeout(()=>oppDrive(),600); }
  else { LIVE.awaitInput=true; renderLive(); }
}

/* opponent's drive — auto-simmed, surfaced as feed */
function oppDrive(){
  if(!LIVE||LIVE.over) return;
  const opp=LIVE.opp, me=LIVE.me;
  const offEdge=(LIVE.osOff - LIVE.msDef); // + = opponent offense stronger than my D
  // base TD chance ~22%, swings with the matchup; strong D suppresses it
  let prob = clamp(0.22 + offEdge*0.010, 0.06, 0.50);
  let fgP  = 0.15;
  const r=rng();
  let scored=false, fg=false, turnover=false;
  if(r<prob){ scored=true; }
  else if(r<prob+fgP){ fg=true; }
  else if(r<prob+fgP+0.15){ turnover=true; }

  const orb=keyGuy(opp,['RB']), oqb=keyGuy(opp,['QB']);
  runClock(rndi(95,185));
  if(scored){ LIVE.oppScore+=7; pushFeed(`${opp.short}: ${oqb} leads a TD drive. (+7)`, 'score'); }
  else if(fg){ LIVE.oppScore+=3; pushFeed(`${opp.short} settles for a field goal. (+3)`, 'score'); }
  else if(turnover){ pushFeed(`🛑 ${me.short} defense forces a turnover!`, ''); }
  else { pushFeed(`${me.short} defense gets a stop. ${opp.short} punts.`, ''); }

  if(checkQuarter(true)){ return; }
  // possession back to me
  LIVE.poss='me'; LIVE.down=1; LIVE.toGo=10; LIVE.ballOn=clamp(rndi(20,32),15,35);
  LIVE.awaitInput=true;
  renderLive();
}

function runClock(sec){
  LIVE.clock -= sec;
  if(LIVE.clock<=0){
    LIVE.clock=0;
  }
}
/* returns true if game ended (and handled) */
function checkQuarter(allowEnd){
  if(LIVE.clock<=0){
    if(LIVE.qtr>=4){
      if(LIVE.myScore===LIVE.oppScore){
        // overtime: quick resolve
        pushFeed('⏱️ OVERTIME!','big');
        const edge=(LIVE.msOff-LIVE.osDef)-(LIVE.osOff-LIVE.msDef);
        if(rng()< clamp(0.5+edge*0.01,0.2,0.8)) LIVE.myScore+=3; else LIVE.oppScore+=3;
      }
      finishLive();
      return true;
    }
    LIVE.qtr++; LIVE.clock=15*60;
    pushFeed(`— End of Q${LIVE.qtr-1} —`,'big');
  }
  return false;
}

function simRestOfGame(){
  if(!LIVE||LIVE.over) return;
  // finish via the standard sim from the CURRENT live score as a baseline,
  // then blend remaining expected points so the live progress counts.
  const remainingFrac = clamp((LIVE.clock + (4-LIVE.qtr)*15*60)/(60*60),0,1);
  const edge=(LIVE.msOff-LIVE.osDef);
  // expected remaining points for each side
  const myRem = Math.max(0, Math.round((14 + edge*0.2)*remainingFrac + gauss(0,5)));
  const opRem = Math.max(0, Math.round((14 - edge*0.2)*remainingFrac + gauss(0,5)));
  LIVE.myScore+=myRem; LIVE.oppScore+=opRem;
  pushFeed(`⏭️ Simulated the rest of the game.`,'big');
  finishLive();
}

function finishLive(){
  if(LIVE.myScore===LIVE.oppScore){ if(rng()<0.5)LIVE.myScore+=3; else LIVE.oppScore+=3; }
  LIVE.over=true; LIVE.awaitInput=false;
  renderLive();
}

function endLiveGame(){
  // build the result object in home/away terms and resolve normally
  const hScore = LIVE.myIsHome?LIVE.myScore:LIVE.oppScore;
  const aScore = LIVE.myIsHome?LIVE.oppScore:LIVE.myScore;
  const res={
    homeId:LIVE.homeId, awayId:LIVE.awayId, hScore, aScore,
    rivalry: LIVE.opp.rivals.includes(LIVE.me.id)||LIVE.me.rivals.includes(LIVE.opp.id),
    winnerId: hScore>aScore?LIVE.homeId:LIVE.awayId,
    loserId: hScore>aScore?LIVE.awayId:LIVE.homeId,
  };
  const g=LIVE.g;
  LIVE=null;
  closeCut();
  finishGame(g,res);
}

console.log('DYNASTY HC live game engine loaded');
</script>

<script>
/* ---------------------------------------------------------------------------
   SECTION P — POSTSEASON
   --------------------------------------------------------------------------- */
function endRegularSeason(){
  G.phase='confchamp';
  updatePoll();
  pushNews('big','Regular season complete',`${myTeam().short} finishes the regular season ${myTeam().w}-${myTeam().l}. Conference championship week is next.`);
  go('hub');
}

// determine conference champions
function getConfChamps(){
  const champs={};
  CONFERENCES.forEach(conf=>{
    if(conf.id==='ind') return;
    const teams=G.teams.filter(t=>t.conf===conf.id).sort((a,b)=> (b.cw-b.cl)-(a.cw-a.cl) || rankOf(a.id)-rankOf(b.id) || (b.w-a.w));
    if(teams.length>=2){
      // championship game between top 2
      const res=simGame(teams[0].id, teams[1].id, {playoff:false});
      champs[conf.id]={champ:res.winnerId, g:[teams[0].id,teams[1].id], res, tier:conf.tier};
    } else if(teams.length){ champs[conf.id]={champ:teams[0].id, tier:conf.tier}; }
  });
  return champs;
}

function runConfChamps(){
  const champs=getConfChamps();
  G._confChamps=champs;
  // apply results
  Object.values(champs).forEach(c=>{ if(c.res) applyGameResult(c.res); });
  updatePoll();
  // did my team play / win?
  let myConf=myTeam().conf;
  const mine=champs[myConf];
  let won=false, played=false;
  if(mine&&mine.g&&mine.g.includes(G.myTeamId)){ played=true; won=mine.champ===G.myTeamId; }
  if(won){ G.coach.confTitles++; G.jobSecurity-=10; pushNews('big',`🏆 ${myTeam().short} wins the ${myTeam().confName}!`,`Conference champions! A massive boost to your resume and recruiting.`); }
  else if(played){ pushNews('bad',`${myTeam().short} falls in conf title game`,`So close. A loss in the championship game.`); }

  // build playoff
  buildPlayoff(champs);
  G.phase='playoff';
  confChampCutscene(champs, won, played);
}

function confChampCutscene(champs, won, played){
  const t=myTeam();
  cutscene(`linear-gradient(160deg,${won?'#ffd23f':'#0f1620'}44,#0a0e14)`,`
    <div style="animation:fadeIn .5s;max-width:340px">
      <div class="display b" style="font-size:30px;color:var(--accent2)">CONFERENCE CHAMPIONSHIPS</div>
      ${won?`<div class="display b mt14" style="font-size:24px;color:var(--gold)">🏆 ${t.confName} CHAMPIONS</div>${teamBadge(t,72)}`:
        played?`<div class="muted mt14">${t.short} came up short in the title game.</div>`:`<div class="muted mt14">${t.short} did not reach the conference title game this year.</div>`}
      <div class="card tight mt20" style="text-align:left">
        ${Object.entries(champs).filter(([k])=>k!=='ind').map(([k,c])=>{const ch=teamById(c.champ);return `<div class="row between sm" style="padding:4px 0"><span class="dim">${confById(k).name}</span><b>${ch.short}</b></div>`;}).join('')}
      </div>
      <button class="btn lg gold mt20" onclick="closeCut();showPlayoffReveal()">📺 Playoff Selection Show →</button>
    </div>`, {confetti:won});
}

/* ---- 12-team Playoff with correct 2026 auto-bid logic ---- */
function buildPlayoff(champs){
  const ranked=[...G.cfpRank];
  const field=[]; const usedIds=new Set();
  // 1) Four highest-ranked P4 conference champions get auto-bids
  const p4Champs=Object.values(champs).filter(c=>c.tier==='P4').map(c=>c.champ);
  p4Champs.sort((a,b)=> ranked.indexOf(a)-ranked.indexOf(b));
  p4Champs.slice(0,CONFIG.P4_AUTO_BIDS).forEach(id=>{ if(!usedIds.has(id)){field.push({id,auto:'P4 Champ'});usedIds.add(id);} });
  // 2) Highest-ranked Group of 6 team (need not be champ)
  const g6=G.teams.filter(t=>t.tier==='G6').sort((a,b)=>ranked.indexOf(a.id)-ranked.indexOf(b.id));
  if(g6.length){ const top=g6[0]; if(!usedIds.has(top.id)){ field.push({id:top.id,auto:'G6 Auto'}); usedIds.add(top.id);} }
  // 3) Independent (ND-equiv) gets a bid if top 12
  const ind=G.teams.find(t=>t.tier==='IND');
  if(ind && ranked.indexOf(ind.id)<12 && !usedIds.has(ind.id)){ field.push({id:ind.id,auto:'IND'}); usedIds.add(ind.id); }
  // 4) Fill remaining at-large by ranking
  for(const tid of ranked){
    if(field.length>=CONFIG.PLAYOFF_TEAMS) break;
    if(!usedIds.has(tid)){ field.push({id:tid,auto:null}); usedIds.add(tid); }
  }
  // seed by ranking
  field.sort((a,b)=> ranked.indexOf(a.id)-ranked.indexOf(b.id));
  field.forEach((f,i)=> f.seed=i+1);
  G.playoff={field, round:'reveal', results:{}, bracket:null};
}

function showPlayoffReveal(){
  const f=G.playoff.field;
  const inField=f.some(x=>x.id===G.myTeamId);
  if(inField){ G.coach.playoffApps++; G.jobSecurity-=8; }
  cutscene(`radial-gradient(circle at 50% 30%, rgba(255,90,31,.2), #0a0e14 70%)`,`
    <div style="animation:fadeIn .5s;width:100%;max-width:400px">
      <div class="display" style="font-size:13px;letter-spacing:4px;color:var(--accent2)">${G.year} COLLEGE FOOTBALL PLAYOFF</div>
      <div class="display b" style="font-size:30px">SELECTION SHOW</div>
      <div style="max-height:300px;overflow-y:auto;text-align:left;margin-top:16px">
        ${f.map(x=>{const t=teamById(x.id);const me=x.id===G.myTeamId;const bye=x.seed<=4;return `<div class="row between center" style="padding:8px;background:${me?'rgba(255,90,31,.12)':'var(--panel)'};border-radius:9px;margin-bottom:5px;border:1px solid ${me?'var(--accent)':'var(--line)'}">
          <div class="row gap8"><span class="display b" style="width:22px;color:var(--accent2)">${x.seed}</span>${teamBadge(t,32)}<div><div class="b sm">${t.short}${me?' ← YOU':''}</div><div class="dim xs">${t.w}-${t.l}${x.auto?' • '+x.auto:''}</div></div></div>
          ${bye?'<span class="chip gold" style="padding:2px 7px">BYE</span>':''}
        </div>`;}).join('')}
      </div>
      <button class="btn lg gold mt14" onclick="closeCut();startPlayoffRounds()">${inField?'🏈 Enter the Playoff →':'Continue (you missed it) →'}</button>
    </div>`);
}

function renderPlayoffScreen(s){
  const p=G.playoff;
  if(!p){ s.innerHTML='<div class="pad muted tc">No active playoff.</div>'; return; }
  s.innerHTML=`<div class="pad"><div class="display b" style="font-size:22px">${G.year} CFP Bracket</div><div id="brk" class="mt14"></div></div>`;
  renderBracket($('#brk'));
}

function startPlayoffRounds(){ G.phase='playoff'; runPlayoffRound(); }

function runPlayoffRound(){
  const p=G.playoff;
  if(!p.bracket){
    // round 1: seeds 5-12 play; 1-4 bye. Matchups: 8v9,5v12,7v10,6v11 style
    const f=p.field;
    const seedMap={}; f.forEach(x=>seedMap[x.seed]=x.id);
    p.bracket={
      r1:[ {a:seedMap[8],b:seedMap[9]}, {a:seedMap[5],b:seedMap[12]}, {a:seedMap[7],b:seedMap[10]}, {a:seedMap[6],b:seedMap[11]} ].filter(m=>m.a&&m.b),
      byes:[seedMap[1],seedMap[2],seedMap[3],seedMap[4]],
      round:1
    };
    // sim round 1 (home = higher seed = a)
    p.bracket.r1.forEach(m=>{ const r=simGame(m.a,m.b,{plan:m.a===G.myTeamId||m.b===G.myTeamId?defaultPlan():null,playoff:true}); m.res=r; m.win=r.winnerId; });
  }
  go('schedule');
  setTimeout(()=>advancePlayoff(),100);
}

function defaultPlan(){ return {tempo:50,aggression:55,blitz:50,fourth:55}; }

function advancePlayoff(){
  // present current bracket, let user advance round by round
  modal(playoffModalHTML());
}

function playoffModalHTML(){
  const p=G.playoff, b=p.bracket;
  let html=`<div class="display b lg tc mb14">${G.year} Playoff — ${roundName(b.round)}</div>`;
  if(b.round===1){
    html+=bracketMatchups(b.r1);
    html+=`<div class="muted xs tc mt10">Top 4 seeds (byes): ${b.byes.map(id=>teamById(id).short).join(', ')}</div>`;
    html+=`<button class="btn full lg gold mt14" onclick="toQuarters()">Advance to Quarterfinals →</button>`;
  } else if(b.round===2){
    html+=bracketMatchups(b.qf);
    html+=`<button class="btn full lg gold mt14" onclick="toSemis()">Advance to Semifinals →</button>`;
  } else if(b.round===3){
    html+=bracketMatchups(b.sf);
    html+=`<button class="btn full lg gold mt14" onclick="toFinal()">Advance to National Championship →</button>`;
  } else if(b.round===4){
    html+=bracketMatchups([b.final]);
    html+=`<button class="btn full lg gold mt14" onclick="finishPlayoff()">🏆 See the Champion →</button>`;
  }
  return html;
}
function roundName(r){ return {1:'First Round',2:'Quarterfinals',3:'Semifinals',4:'National Championship'}[r]; }
function bracketMatchups(games){
  return games.map(m=>{
    const a=teamById(m.a),bt=teamById(m.b);
    const aw=m.win===m.a;
    const meIn = m.a===G.myTeamId||m.b===G.myTeamId;
    return `<div class="card tight" style="${meIn?'border-color:var(--accent)':''}">
      <div class="row between center">
        <div class="row gap8 fg" style="opacity:${aw?1:.5}">${teamBadge(a,30)}<b class="sm">${a.short}</b></div>
        <div class="display b">${m.res?(m.res.homeId===m.a?m.res.hScore:m.res.aScore):'-'}</div>
      </div>
      <div class="row between center mt6">
        <div class="row gap8 fg" style="opacity:${!aw?1:.5}">${teamBadge(bt,30)}<b class="sm">${bt.short}</b></div>
        <div class="display b">${m.res?(m.res.homeId===m.b?m.res.hScore:m.res.aScore):'-'}</div>
      </div>
    </div>`;
  }).join('');
}

function simMatch(a,b){
  if(!a||!b){ // defensive: if a slot is missing, the present team auto-advances
    const present=a||b; return {a:present,b:present,res:null,win:present};
  }
  const r=simGame(a,b,{plan:(a===G.myTeamId||b===G.myTeamId)?defaultPlan():null,playoff:true}); return {a,b,res:r,win:r.winnerId}; }

function toQuarters(){
  const b=G.playoff.bracket;
  const r1w=b.r1.map(m=>m.win);
  // quarters: byes vs r1 winners. seed1 vs lowest remaining, etc. Simplify: 1v(8/9w),4v(5/12w),2v(7/10w),3v(6/11w)
  b.qf=[ simMatch(b.byes[0], r1w[0]), simMatch(b.byes[3], r1w[1]), simMatch(b.byes[1], r1w[2]), simMatch(b.byes[2], r1w[3]) ].filter(m=>m.a&&m.b);
  b.round=2;
  closeModal(); renderBracket($('#brk')); advancePlayoff();
}
function toSemis(){
  const b=G.playoff.bracket;
  const qw=b.qf.map(m=>m.win);
  b.sf=[ simMatch(qw[0],qw[1]), simMatch(qw[2],qw[3]) ];
  b.round=3; closeModal(); renderBracket($('#brk')); advancePlayoff();
}
function toFinal(){
  const b=G.playoff.bracket;
  const sw=b.sf.map(m=>m.win);
  b.final=simMatch(sw[0],sw[1]);
  b.round=4; closeModal(); renderBracket($('#brk')); advancePlayoff();
}

function finishPlayoff(){
  closeModal();
  const b=G.playoff.bracket;
  const champId=b.final.win;
  G.natChamps.push({year:G.year, teamId:champId});
  const champ=teamById(champId);
  const iWon = champId===G.myTeamId;
  if(iWon){ G.coach.natTitles++; G.coach.rep=clamp(G.coach.rep+8,0,100); G.jobSecurity=clamp(G.jobSecurity-20,0,100); }
  // update coach actor wins for AI champ
  if(!iWon) champ.coach.titles++;
  pushNews('big',`🏆 ${champ.name} wins the ${G.year} National Championship!`, iWon?`YOU DID IT. ${G.coach.name} is a national champion!`:`${champ.coach.name} and ${champ.short} are champions.`);
  championshipCutscene(champ, iWon);
}

function championshipCutscene(champ, iWon){
  cutscene(`linear-gradient(160deg,${champ.colors[0]},${champ.colors[0]}aa)`,`
    <div style="animation:fadeIn .6s">
      <div style="font-size:54px">🏆</div>
      <div class="display" style="font-size:13px;letter-spacing:4px;color:${champ.colors[1]}">${G.year} NATIONAL CHAMPIONS</div>
      <div class="display b" style="font-size:32px;color:#fff;line-height:1;margin-top:6px">${champ.name}</div>
      ${teamBadge(champ,80)}
      ${iWon?`<div class="card tight mt20" style="background:rgba(0,0,0,.35);border:none;max-width:280px">
        <div class="xs" style="color:var(--accent2)">YOUR CAREER</div>
        <div class="sm mt6" style="color:#fff">${G.coach.careerWins+myTeam().w}-${G.coach.careerLosses+myTeam().l} • ${G.coach.natTitles} National Title${G.coach.natTitles>1?'s':''} • ${G.coach.confTitles} Conf Titles</div>
      </div>`:`<div class="muted mt14" style="color:#fff;opacity:.85">Your run ends here. There's always next year.</div>`}
      <button class="btn lg gold mt24" onclick="closeCut();afterPlayoff()">Continue →</button>
    </div>`, {confetti:iWon});
}

function renderBracket(container){
  if(!container) return;
  const b=G.playoff.bracket; if(!b){ container.innerHTML=''; return; }
  let html='<h2 class="sec">First Round</h2>'+bracketMatchups(b.r1);
  if(b.qf){ html+='<h2 class="sec">Quarterfinals</h2>'+bracketMatchups(b.qf); }
  if(b.sf){ html+='<h2 class="sec">Semifinals</h2>'+bracketMatchups(b.sf); }
  if(b.final){ html+='<h2 class="sec">National Championship</h2>'+bracketMatchups([b.final]); }
  container.innerHTML=html;
}

function afterPlayoff(){
  G.phase='bowls';
  go('hub');
}

function runBowls(){
  // bowl-eligible teams (6+ wins) not in playoff get a bowl
  const inPlayoff=new Set(G.playoff?G.playoff.field.map(f=>f.id):[]);
  const eligible=G.teams.filter(t=>t.w>=6&&!inPlayoff.has(t.id));
  // my team bowl
  const t=myTeam();
  if(t.w>=6 && !inPlayoff.has(t.id)){
    const opp=pick(eligible.filter(x=>x.id!==t.id&&x.conf!==t.conf))||pick(eligible.filter(x=>x.id!==t.id));
    if(opp){
      const res=simGame(t.id,opp.id);
      applyGameResult(res);
      const won=res.winnerId===t.id;
      pushNews(won?'good':'',`${won?'Bowl win':'Bowl loss'}: ${t.short} ${res.hScore}-${res.aScore} ${opp.short}`,`A ${pick(['Sun','Citrus','Liberty','Gator','Holiday','Vegas','Pinstripe'])} Bowl ${won?'victory caps':'loss ends'} the season.`);
    }
  }
  G.phase='awards';
  go('hub');
}

console.log('DYNASTY HC postseason + playoff loaded');
</script>

<script>
/* ---------------------------------------------------------------------------
   SECTION Q — AWARDS & NFL DRAFT
   --------------------------------------------------------------------------- */
function runAwards(){
  // Heisman-equivalent: best offensive player by stats among ranked teams
  const allP=[];
  G.teams.forEach(t=>t.roster.forEach(p=>{ if(p.ovr>=80) allP.push({p,t}); }));
  const heisman = allP.filter(x=>['QB','RB','WR'].includes(x.p.pos)).sort((a,b)=> (statScore(b.p))-(statScore(a.p)) )[0];
  // Coach of the year
  const coy = G.teams.map(t=>({t, score: t.w*4 + (t.prestige<60?t.w*2:0) })).sort((a,b)=>b.score-a.score)[0];
  const myCOY = coy && coy.t.id===G.myTeamId;
  if(myCOY){ G.coach.rep=clamp(G.coach.rep+4,0,100); }

  // All-Americans from my team
  const myAA=myTeam().roster.filter(p=>p.ovr>=84).slice(0,4);

  modal(`
  <div class="display b lg tc mb14">🏅 ${G.year} Awards</div>
  ${heisman?`<div class="card tight"><div class="dim xs up">🏆 Heisman Trophy</div><div class="row gap10 mt6">${playerAvatar(heisman.p,40)}<div><div class="b">${heisman.p.name}</div><div class="dim xs">${heisman.p.pos} • ${heisman.t.short} • ${heisman.p.ovr} OVR</div></div></div></div>`:''}
  <div class="card tight"><div class="dim xs up">Coach of the Year</div><div class="row gap10 mt6">${myCOY?myCoachAvatar(36):coachBadge(coy.t.coach.name, coy.t.colors,36)}<div><div class="b">${myCOY?G.coach.name+' ← YOU':coy.t.coach.name}</div><div class="dim xs">${coy.t.short} • ${coy.t.w}-${coy.t.l}</div></div></div></div>
  ${myAA.length?`<div class="card tight"><div class="dim xs up">Your All-Americans</div>${myAA.map(p=>`<div class="row between sm mt6"><span>${p.name}</span><b>${p.pos} ${p.ovr}</b></div>`).join('')}</div>`:''}
  <button class="btn full lg gold mt10" onclick="closeModal();runDraftAndAttrition()">📋 NFL Draft &amp; Roster Changes →</button>
  `);
  if(myCOY) pushNews('good',`${G.coach.name} named Coach of the Year`,`National recognition for a standout ${G.year} campaign.`);
}
function statScore(p){ const s=p.seasonStats||{}; return (s.passYds||0)*0.45+(s.passTD||0)*45+(s.rushYds||0)+(s.rushTD||0)*60+(s.recYds||0)+(s.recTD||0)*60+(s.tackles||0)*2+(s.sacks||0)*30+(s.intDef||0)*40+(s.kpts||0)*2-(s.int||0)*25+p.ovr*4; }

function runDraftAndAttrition(){
  const t=myTeam();
  // juniors/seniors with high ovr declare/graduate
  const draftees=[];
  const leaving=[];
  t.roster.forEach(p=>{
    let leaves=false;
    if(p.year==='SR'||p.year==='RS-SR'){ leaves=true; }
    else if((p.year==='JR'||p.year==='RS-JR') && p.ovr>=82 && rng()<0.55){ leaves=true; } // early declare
    if(leaves){
      leaving.push(p);
      if(p.ovr>=78){
        const round = p.ovr>=90?1: p.ovr>=85?rndi(1,2): p.ovr>=80?rndi(2,4):rndi(4,7);
        draftees.push({p,round});
      }
    }
  });
  G.coach.nflDraftees += draftees.length;
  G.coach.firstRounders += draftees.filter(d=>d.round===1).length;
  // remove leaving players
  t.roster = t.roster.filter(p=>!leaving.includes(p));
  G._lastDraft=draftees;
  G._lastLeaving=leaving;
  if(draftees.length){ pushNews('good',`${draftees.length} ${t.short} players drafted`,`${draftees.filter(d=>d.round===1).length} first-rounder(s). Your NFL pipeline strengthens recruiting.`); }

  modal(`
  <div class="display b lg tc mb14">📋 NFL Draft — ${G.year}</div>
  ${draftees.length?draftees.sort((a,b)=>a.round-b.round).map(d=>`<div class="card tight"><div class="row between"><div class="row gap8">${playerAvatar(d.p,40)}<div><div class="b sm">${d.p.name}</div><div class="dim xs">${d.p.pos} • ${d.p.archetype}</div></div></div><span class="pill" style="background:${d.round===1?'rgba(255,210,63,.2)':'rgba(59,160,255,.15)'};color:${d.round===1?'var(--gold)':'var(--blue)'}">RD ${d.round}</span></div></div>`).join(''):'<div class="muted tc pad">No players drafted this year.</div>'}
  <div class="card tight mt10"><div class="dim xs up">Departing (Graduation/Transfer/Draft)</div><div class="sm mt6">${leaving.length} players leave the roster.</div></div>
  <button class="btn full lg gold mt10" onclick="closeModal();startCarousel()">📈 Coaching Carousel →</button>
  `);
}

/* ---------------------------------------------------------------------------
   SECTION R — COACHING CAROUSEL (job offers, firing, hiring)
   --------------------------------------------------------------------------- */
function startCarousel(){
  G.phase='carousel';
  // finalize season into coach career — but only ONCE per year (re-entering the
  // carousel screen from the hub must not double-bank the record or advance the contract)
  if(G._carouselYear !== G.year){
    G._carouselYear = G.year;
    const t=myTeam();
    G.coach.careerWins += t.w;
    G.coach.careerLosses += t.l;
    G.coach.seasonsCoached++;
    G.coach.yearsAtJob++;
    if(G.contract) G.contract.yearsLeft--;

    // AD review: did we meet expectations?
    evaluateJobSecurity();

    // simulate other coaches getting fired/hired
    simWorldCarousel();

    // generate job offers for the player
    G._jobOffers = generateJobOffers();

    // check if fired
    if(G.jobSecurity>=92 && G.coach.yearsAtJob>=G.adExpectation.years){
      fireCoach('failed to meet expectations');
      return;
    }
  }
  if(!G._jobOffers) G._jobOffers = [];
  carouselCutscene();
}

function evaluateJobSecurity(){
  const t=myTeam();
  const exp=G.adExpectation;
  let delta=0;
  const metWins = t.w>=exp.wins;
  if(G.coach.confTitles>0 && G.coach.yearsAtJob<=exp.years) delta-=25;
  if(t.w>=exp.wins) delta-=12; else delta+= (exp.wins-t.w)*4;
  if(t.w<=3) delta+=15;
  // extension if overperforming
  if(metWins && G.jobSecurity+delta<30 && G.contract.yearsLeft<=1){
    G.contract.yearsLeft += rndi(2,4);
    G.contract.salary = +(G.contract.salary*1.2).toFixed(1);
    pushNews('good',`Contract extension for ${G.coach.name}`,`${t.short} rewards you with a new ${G.contract.yearsLeft}-year deal at $${G.contract.salary}M/yr.`);
  }
  G.jobSecurity = clamp(G.jobSecurity+delta, 0, 100);
}

function simWorldCarousel(){
  // some AI coaches get fired and replaced; build coaching tree poaching
  G.teams.forEach(tm=>{
    if(tm.id===G.myTeamId) return;
    const winPct = (tm.w+tm.l)>0? tm.w/(tm.w+tm.l):0.5;
    tm.coach.tenure++;
    // fire bad coaches at high-prestige programs
    const fireChance = (tm.prestige>70? 0.18:0.10) * (winPct<0.4?2.2:winPct<0.5?1.2:0.3);
    if(rng()<fireChance && tm.coach.tenure>=2){
      const old=tm.coach.name;
      tm.coach=genCoachActor(tm.prestige);
      if(tm.prestige>75) pushNews('','Coaching change',`${tm.short} fires ${old} and hires ${tm.coach.name}.`);
    } else {
      tm.coach.wins+=tm.w; tm.coach.confTitles+= (tm.cw>=tm.cl&&tm.w>=10?1:0);
    }
  });
}

function generateJobOffers(){
  const offers=[];
  const rep=G.coach.rep;
  const t=myTeam();
  const success = t.w>=9 || G.coach.confTitles>0 || G.coach.natTitles>0;
  // open jobs = teams that fired their coach this cycle OR random poaching
  const candidates=G.teams.filter(tm=>tm.id!==G.myTeamId && tm.prestige <= rep+35 && tm.prestige >= rep-25);
  let pool = shuffle(candidates);
  // better resume → bigger jobs
  const nOffers = success? rndi(2,4) : (t.w>=7? rndi(0,2): rng()<0.3?1:0);
  let added=0;
  for(const tm of pool){
    if(added>=nOffers) break;
    // poaching: must be a step up or lateral with appeal, and chance gated by rep
    const isUpgrade = tm.prestige > t.prestige+3;
    const wants = (isUpgrade && rng()<0.5) || (rng()<0.25);
    if(!wants) continue;
    if(G.coach.traits.includes('loyal') && rng()<0.4) continue;
    if(G.coach.traits.includes('merc')) {} // more offers naturally pass
    const exp=expectationFor(tm);
    offers.push({
      teamId:tm.id, years: exp.years+rndi(1,3),
      salary:+(tm.prestige*0.1+rnd(0.5,2)).toFixed(1),
      buyout:+(tm.prestige*0.06).toFixed(1),
      expectation:exp,
    });
    added++;
  }
  return offers;
}

function carouselCutscene(){
  const t=myTeam();
  const exp=G.adExpectation;
  const met = t.w>=exp.wins || G.coach.confTitles>0;
  const js=G.jobSecurity;
  const jsLabel = js<35?'SAFE':js<55?'STABLE':js<70?'WARM':js<85?'HOT SEAT':'ON THE BRINK';
  cutscene(`linear-gradient(160deg,${met?'#1e9e57':'#0f1620'}44,#0a0e14)`,`
    <div style="animation:fadeIn .5s;max-width:340px">
      <div class="display" style="font-size:13px;letter-spacing:4px;color:var(--accent2)">END OF SEASON ${G.year}</div>
      <div class="display b" style="font-size:28px">AD REVIEW</div>
      ${teamBadge(t,60)}
      <div class="sm mt14" style="color:#fff">${t.short} finished <b>${t.w}-${t.l}</b></div>
      <div class="card tight mt14" style="text-align:left">
        <div class="row between sm"><span class="dim">Expectation</span><span>${exp.wins}+ wins</span></div>
        <div class="row between sm mt6"><span class="dim">Result</span><span style="color:${met?'var(--green)':'var(--red)'}">${met?'✅ Met':'❌ Missed'}</span></div>
        <div class="row between sm mt6"><span class="dim">Job Security</span><b style="color:${js<55?'var(--green)':js<85?'var(--accent2)':'var(--red)'}">${jsLabel}</b></div>
      </div>
      <button class="btn lg gold mt20" onclick="closeCut();showJobOffers()">${G._jobOffers.length?`📞 You have ${G._jobOffers.length} job offer(s) →`:'Continue →'}</button>
    </div>`, {confetti:G.coach.confTitles>0&&met});
}

function showJobOffers(){
  if(!G._jobOffers || !G._jobOffers.length){ proceedToSigning(); return; }
  go('career');
  setTimeout(()=>renderJobOffersModal(),100);
}

function renderJobOffersModal(){
  const offers=G._jobOffers;
  modal(`
  <div class="display b lg tc mb6">📞 Job Offers</div>
  <p class="muted sm tc mb14">Other programs want ${G.coach.name}. Stay or make a move?</p>
  ${offers.map((o,i)=>{const tm=teamById(o.teamId);return `
    <div class="card tight">
      <div class="row gap10">${teamBadge(tm,44)}<div class="fg"><div class="display b sm">${tm.name}</div><div class="dim xs">${tm.confName} • Prestige ${tm.prestige} ${tm.prestige>myTeam().prestige?'<span style="color:var(--green)">▲ Upgrade</span>':''}</div></div></div>
      <div class="grid3 mt8">
        <div class="statbox" style="padding:7px"><div class="v" style="font-size:15px">$${o.salary}M</div><div class="l">Salary</div></div>
        <div class="statbox" style="padding:7px"><div class="v" style="font-size:15px">${o.years}y</div><div class="l">Term</div></div>
        <div class="statbox" style="padding:7px"><div class="v" style="font-size:15px">${tm.nilStrength}</div><div class="l">NIL</div></div>
      </div>
      <div class="dim xs mt6">📋 "${o.expectation.goal}"</div>
      <button class="btn full gold mt8" onclick="acceptJob(${i})">Accept ${tm.short} Job →</button>
    </div>`;}).join('')}
  <button class="btn full ghost mt6" onclick="closeModal();stayAndContinue()">🏠 Stay at ${myTeam().short}</button>
  `);
}

function acceptJob(i){
  const o=G._jobOffers[i];
  const oldTeam=myTeam();
  const newTeam=teamById(o.teamId);
  closeModal();
  // buyout note
  pushNews('big',`${G.coach.name} leaves ${oldTeam.short} for ${newTeam.short}`,`A blockbuster move up the ladder. ${oldTeam.short} must now find a new head coach.`);
  // old team gets a new AI coach
  oldTeam.coach=genCoachActor(oldTeam.prestige);
  // switch
  G.myTeamId=o.teamId;
  G.adExpectation=o.expectation;
  G.jobSecurity=o.expectation.sec;
  G.contract={years:o.years,yearsLeft:o.years,salary:o.salary,buyout:o.buyout};
  G.coach.yearsAtJob=0;
  newTeam.coach.isPlayer=true;
  G.careerLog.push({team:newTeam.name,teamId:newTeam.id,startYear:G.year+1});
  jobMoveCutscene(newTeam);
}

function jobMoveCutscene(t){
  cutscene(`linear-gradient(135deg,${t.colors[0]},${t.colors[0]}cc)`,`
    <div style="animation:fadeIn .6s">
      <div class="display" style="font-size:13px;letter-spacing:4px;color:${t.colors[1]}">NEW CHAPTER</div>
      ${teamBadge(t,84)}
      <div class="display b mt10" style="font-size:30px;color:#fff">${t.name}</div>
      <div class="sm mt10" style="color:#fff;opacity:.85">${G.coach.name}, Head Coach</div>
      <button class="btn lg gold mt20" onclick="closeCut();proceedToSigning()">Continue →</button>
    </div>`);
}

function stayAndContinue(){ proceedToSigning(); }

function fireCoach(reason){
  const t=myTeam();
  pushNews('bad',`${G.coach.name} FIRED by ${t.short}`,`After ${reason}, the AD has made a change. Your career hangs in the balance.`);
  // look for a job to fall to (lower prestige)
  const landing = shuffle(G.teams.filter(tm=>tm.id!==G.myTeamId && tm.prestige < t.prestige && tm.prestige < G.coach.rep+10));
  cutscene(`linear-gradient(160deg,#ff475744,#0a0e14)`,`
    <div style="animation:fadeIn .5s;max-width:320px">
      <div style="font-size:48px">📉</div>
      <div class="display b" style="font-size:30px;color:var(--red)">FIRED</div>
      <div class="muted mt14">${t.short} has relieved ${G.coach.name} of duties after ${reason}.</div>
      ${landing.length?`<div class="card tight mt20"><div class="dim xs">A lifeline appears…</div><div class="b mt6">${landing[0].name}</div><div class="dim xs">${landing[0].confName} • wants to interview you</div></div>
      <button class="btn lg gold mt14" onclick="closeCut();takeRebuildJob('${landing[0].id}')">Take the ${landing[0].short} Job →</button>`:''}
      <button class="btn ghost mt10" onclick="closeCut();retireScreen('fired')">Retire from Coaching</button>
    </div>`);
  G.coach.rep=clamp(G.coach.rep-6,0,100);
}
function takeRebuildJob(tid){
  const oldId=G.myTeamId;
  teamById(oldId).coach=genCoachActor(teamById(oldId).prestige);
  const t=teamById(tid);
  G.myTeamId=tid; const exp=expectationFor(t);
  G.adExpectation=exp; G.jobSecurity=exp.sec+10;
  G.contract={years:exp.years+1,yearsLeft:exp.years+1,salary:+(t.prestige*0.08).toFixed(1),buyout:+(t.prestige*0.04).toFixed(1)};
  G.coach.yearsAtJob=0;
  G.careerLog.push({team:t.name,teamId:tid,startYear:G.year+1});
  pushNews('big',`${G.coach.name} hired at ${t.short}`,`A chance at redemption with a rebuild project.`);
  proceedToSigning();
}

console.log('DYNASTY HC awards + carousel loaded');
</script>

<script>
/* ---------------------------------------------------------------------------
   SECTION S — SIGNING DAY, DEVELOPMENT, YEAR ADVANCE
   --------------------------------------------------------------------------- */
function proceedToSigning(){ G.phase='signing'; go('hub'); }

function runSigningDay(){
  // resolve all undecided recruits (AI commits), then sign committed players to teams
  resolveRecruitingClass();
  const myClass=G.recruits.filter(r=>r.committed===G.myTeamId);
  myClass.forEach(r=>r.signed=true);
  // class grade
  const cr=computeClassRank();
  if(cr.rank!=='—' && cr.rank<=10){ G.coach.rep=clamp(G.coach.rep+3,0,100); }
  if(cr.rank!=='—' && cr.rank===1){ G.coach.recruitTitles++; }
  pushNews('big',`✍️ ${myTeam().short} signs ${myClass.length}-man class (#${cr.rank} nationally)`,`Signing Day complete. ${myClass.filter(r=>r.stars>=4).length} blue-chip recruits join the program.`);
  signingDayCutscene(myClass, cr);
}

function resolveRecruitingClass(){
  // AI teams commit recruits based on interest, prestige, AND star-fit.
  G.recruits.forEach(r=>{
    if(r.committed) return;
    const expected=recruitExpectedPrestige(r);
    // build AI interest if not present, capped by how well the team fits the recruit's tier
    G.teams.forEach(t=>{
      if(t.id===G.myTeamId) return; // my interest is player-driven
      if(r.interest[t.id]==null){
        let base = t.prestige*0.45 + (t.conf===r.homeConf?10:0) + (t.id===r.dreamSchool?18:0);
        base += ((r.motivations['NIL Money']||0)/100)*(t.nilStrength*0.18);
        // fit penalty: programs below the recruit's expected prestige can't generate much heat
        const gap = expected - t.prestige;
        if(gap>0) base = Math.min(base, 100 - gap*3.6);
        r.interest[t.id]=clamp(base+rnd(-8,8),0,100);
      }
    });
    // pick best suitor (excluding me — I'm handled separately)
    const entries=Object.entries(r.interest).filter(([tid])=>tid!==G.myTeamId);
    const best=entries.sort((a,b)=>b[1]-a[1])[0];
    if(best && best[1]>=CONFIG.COMMIT_THRESHOLD-rndi(0,12)){
      r.committed=best[0];
    } else if(best && best[1]>=45 && rng()<0.8){
      // commit to a realistic suitor that at least cleared a floor
      r.committed=best[0];
    } else {
      // no strong suitor: drop a star tier expectation and let a fitting program take him,
      // otherwise he goes to a program that actually fits his (now lower) standard
      const fitting=G.teams.filter(t=>t.id!==G.myTeamId && t.prestige>=expected-14);
      if(fitting.length && rng()<0.85){ r.committed=pick(fitting).id; }
      else if(rng()<0.5){ r.committed=pick(G.teams.filter(t=>t.id!==G.myTeamId)).id; }
    }
  });
  // enforce roster-ish caps per team for AI (keep classes reasonable)
  const counts={};
  G.recruits.filter(r=>r.committed).forEach(r=>{
    counts[r.committed]=(counts[r.committed]||0)+1;
    if(r.committed!==G.myTeamId && counts[r.committed]>26){ r.committed=null; }
  });
}

function signingDayCutscene(cls, cr){
  const t=myTeam();
  cls.sort((a,b)=>b.stars-a.stars||b.trueOvr-a.trueOvr);
  cutscene(`radial-gradient(circle at 50% 20%, ${t.colors[0]}55, #0a0e14 70%)`,`
    <div style="animation:fadeIn .6s;width:100%;max-width:380px">
      <div class="display" style="font-size:13px;letter-spacing:4px;color:var(--accent2)">${G.year} SIGNING DAY</div>
      <div class="display b" style="font-size:30px">CLASS OF ${G.year}</div>
      <div class="row gap12 center" style="justify-content:center;margin-top:10px">
        <div class="tc"><div class="display b xl" style="color:var(--accent2)">#${cr.rank}</div><div class="dim xs">NAT'L RANK</div></div>
        <div class="tc"><div class="display b xl">${cls.length}</div><div class="dim xs">SIGNEES</div></div>
        <div class="tc"><div class="display b xl" style="color:var(--gold)">${cls.filter(r=>r.stars>=4).length}</div><div class="dim xs">BLUE CHIPS</div></div>
      </div>
      <div style="max-height:240px;overflow-y:auto;text-align:left;margin-top:14px">
        ${cls.slice(0,20).map(r=>`<div class="row between center" style="padding:7px;background:var(--panel);border-radius:8px;margin-bottom:5px"><div><div class="b sm">${r.name}</div><div class="dim xs">${r.pos} • ${r.archetype}</div></div>${starHTML(r.stars)}</div>`).join('')}
        ${cls.length>20?`<div class="dim xs tc">+${cls.length-20} more</div>`:''}
      </div>
      <button class="btn lg gold mt14" onclick="closeCut();enterOffseason()">Develop the Roster →</button>
    </div>`, {confetti:cr.rank!=='—'&&cr.rank<=5});
}

function enterOffseason(){
  G.phase='offseason';
  openPortalWindow('Winter');
  go('hub');
}

function advanceToNextYear(){
  // 0) AI snaps up remaining portal players before the window closes
  aiPortalRaid();
  const t=myTeam();

  // 1) DEVELOP & AGE the existing roster FIRST (before this year's freshmen arrive,
  //    so incoming recruits stay FR instead of being aged to SO immediately).
  developRoster(t);
  G.teams.forEach(tm=>{ if(tm.id!==G.myTeamId) ageAndDevelopAI(tm); });

  // 2) add this year's signed recruits to MY roster as freshmen
  const incoming=G.recruits.filter(r=>r.committed===G.myTeamId&&r.signed);
  incoming.forEach(r=>{
    t.roster.push({
      id:id(), name:r.name, pos:r.pos, archetype:r.archetype, stars:r.stars,
      ovr:clamp(r.trueOvr-rndi(2,8),40,99), ceiling:r.ceiling, year:'FR', redshirt:false,
      age:18, devTrait:r.devTrait, morale:rndi(60,85), durability:rndi(50,95), nil:0,
      injury:null, personality:pick(['Vocal Leader','Quiet Worker','Team Player','Coachable']),
      starter:false, seasonStats:{},
    });
  });
  // walk-on floor: never let the player's roster collapse below the NCAA minimum.
  // (Recruiting still drives QUALITY; walk-ons are low-rated depth.)
  let walkOns=0;
  while(t.roster.length<CONFIG.ROSTER_MIN){
    const wo=genPlayer(Math.max(20,t.prestige-35));
    wo.ovr=clamp(wo.ovr-rndi(4,10),40,70); wo.stars=Math.min(wo.stars,2); wo.year='FR'; wo.age=18; wo.walkOn=true;
    t.roster.push(wo); walkOns++;
  }
  if(walkOns>0 && incoming.length<10){
    pushNews('','Thin recruiting class',`Only ${incoming.length} signees — ${walkOns} walk-on(s) added to fill the roster. Recruit harder to upgrade the talent.`);
  }
  // AI rosters get their signed recruits too (added as freshmen AFTER their development)
  G.teams.forEach(tm=>{
    if(tm.id===G.myTeamId) return;
    const cls=G.recruits.filter(r=>r.committed===tm.id);
    cls.forEach(r=>{
      tm.roster.push({id:id(),name:r.name,pos:r.pos,archetype:r.archetype,stars:r.stars,ovr:clamp(r.trueOvr-rndi(2,8),40,99),ceiling:r.ceiling,year:'FR',redshirt:false,age:18,devTrait:r.devTrait,morale:rndi(55,80),durability:rndi(50,95),nil:0,injury:null,personality:'Team Player',starter:false,seasonStats:{}});
    });
    // top up if below floor
    while(tm.roster.length<CONFIG.ROSTER_MIN) tm.roster.push(genPlayer(tm.prestige));
  });

  // 3) age coaches, reset season stats
  G.coach.age++;
  G.teams.forEach(tm=>{ tm.roster.forEach(p=>p.seasonStats={}); });

  // 4) burnout trait
  if(G.coach.traits.includes('burnout') && G.coach.natTitles===0 && G.coach.seasonsCoached%4===0 && G.coach.seasonsCoached>0){
    for(const k in G.coach.attr) G.coach.attr[k]=clamp(G.coach.attr[k]-2,10,99);
    pushNews('','Coach showing signs of burnout','The grind is wearing on you. Consider a championship or a break.');
  }

  // 5) new recruiting class & portal
  G.recruits=genRecruitClass();
  assignDreamSchools();
  G.board=[];
  G.portal=[];
  G.portalBoard=[];

  // 6) budgets grow with cap (4% annual)
  const yearsElapsed = (G.year+1)-CONFIG.START_YEAR;
  const cap = CONFIG.REVSHARE_CAP_BASE*Math.pow(1+CONFIG.REVSHARE_CAP_GROWTH, yearsElapsed);
  G.teams.forEach(tm=>{
    const fShare=CONFIG.FOOTBALL_SHARE_MIN+(tm.prestige/100)*(CONFIG.FOOTBALL_SHARE_MAX-CONFIG.FOOTBALL_SHARE_MIN);
    tm.revShareBudget=+(cap*fShare).toFixed(1);
    tm.nilBudget=+((tm.nilStrength/100)*rnd(2,14)).toFixed(1);
    tm.spent=0;
  });
  // fundraising bonus to my team
  const fb=(G.coach.attr.Fundraising-50)*0.02;
  if(fb>0){ t.nilBudget=+(t.nilBudget*(1+fb)).toFixed(1); }

  // 7) occasional realignment
  if(rng()<0.18) doRealignment();

  // 8) advance year
  G.year++;
  G.week=0;
  G.phase='preseason';
  // record history
  const lastChamp=G.natChamps[G.natChamps.length-1];
  G.history.push({year:G.year-1, champ:lastChamp?teamById(lastChamp.teamId).short:'—', myRecord:`${t.w}-${t.l}`, myTeam:t.short});
  pushNews('big',`Welcome to ${G.year}`,`A new season approaches. ${t.short} reloads for another run.`);
  save();
  go('hub');
}

function developRoster(t){
  t.roster.forEach(p=>{
    advanceYear(p);
    let growth = developGrowth(p, G.coach.attr.PlayerDev, true);
    p.ovr=clamp(Math.round(p.ovr+growth), 40, p.ceiling);
  });
}
function ageAndDevelopAI(tm){
  // graduate seniors first (they leave the program)
  tm.roster = tm.roster.filter(p=>!(p.year==='SR'||p.year==='RS-SR'));
  // occasional early NFL declaration for AI stars
  tm.roster = tm.roster.filter(p=>!((p.year==='JR'||p.year==='RS-JR') && p.ovr>=86 && rng()<0.35));
  // age & develop the rest
  tm.roster.forEach(p=>{
    advanceYear(p);
    let growth=developGrowth(p, (tm.coach&&tm.coach.skill?tm.coach.skill:60)*0.7, false);
    p.ovr=clamp(Math.round(p.ovr+growth),40,p.ceiling);
  });
}
function advanceYear(p){
  const map={'FR':'SO','SO':'JR','JR':'SR','SR':'SR','RS-FR':'RS-SO','RS-SO':'RS-JR','RS-JR':'RS-SR','RS-SR':'RS-SR'};
  if(p.redshirt && p.year==='FR'){ p.year='RS-FR'; p.redshirt=false; }
  else p.year=map[p.year]||p.year;
  p.age++;
}
function developGrowth(p, devStat, isMine){
  let g=CONFIG.DEV_BASE;
  g += (devStat-50)*0.05;
  // dev trait
  const tr=p.devTrait;
  if(tr==='Early Bloomer') g += (['FR','SO','RS-FR'].includes(p.year)?4:1);
  else if(tr==='Late Bloomer') g += (['JR','SR','RS-JR','RS-SR'].includes(p.year)?4:0.5);
  else if(tr==='Hidden Gem') g+=3;
  else if(tr==='Bust Risk') g+= rng()<0.4?-2:1.5;
  else g+=2;
  // distance to ceiling
  g *= clamp((p.ceiling-p.ovr)/12,0.2,2);
  // peak/regression by age
  if(p.age>=23) g-=2;
  if(isMine && G.coach.traits.includes('developer')) g+=1.5;
  return clamp(g, -3, 8);
}

/* depth chart auto-set */
function setDepthChart(t){
  POSITIONS.forEach(pos=>{
    const players=t.roster.filter(p=>p.pos===pos).sort((a,b)=>b.ovr-a.ovr);
    players.forEach((p,i)=>{ p.starter = i < starterCount(pos); });
  });
}
function starterCount(pos){ return {QB:1,RB:1,WR:3,TE:1,OL:5,DL:4,LB:3,CB:2,S:2,K:1}[pos]||1; }

/* ---------------------------------------------------------------------------
   REALIGNMENT
   --------------------------------------------------------------------------- */
function doRealignment(){
  // a G6 team jumps to a P4 conference
  const climber=pick(G.teams.filter(t=>t.tier==='G6'&&t.prestige>60));
  if(!climber) return;
  const target=pick(CONFERENCES.filter(c=>c.tier==='P4'));
  const oldConf=climber.confName;
  climber.conf=target.id; climber.confName=target.name; climber.tier='P4';
  climber.prestige=clamp(climber.prestige+rndi(3,8),20,99);
  pushNews('big',`🌎 Realignment: ${climber.short} joins the ${target.name}`,`Conference chaos reshapes the map. ${climber.short} leaves the ${oldConf} for a Power 4 home.`);
}

console.log('DYNASTY HC signing + development loaded');
</script>
<script>
/* ---------------------------------------------------------------------------
   SECTION T — RECRUITING ENGINE (weekly tick, scouting, actions, interest)
   --------------------------------------------------------------------------- */

/* How appealing is MY program to a given recruit right now (0..100). */
function myAppeal(r){
  const t=myTeam();
  let a = t.prestige*0.35;
  const m=r.motivations||{};
  const g=(k)=>(m[k]||0)/100;
  const rank=rankOf(t.id); // 0 if unranked
  const winning = rank && rank<=25 ? (26-rank) : 0;
  a += g('Winning') * (winning*0.6 + 8);
  a += g('NIL Money') * (t.nilStrength*0.25);
  a += g('Proximity') * (t.conf===r.homeConf?22:4);
  a += g('Conference Prestige') * (t.tier==='P4'?18:6);
  a += g('Facilities') * (t.facilities*0.18);
  a += g('Academics') * (t.academics*0.16);
  a += g('Develop for NFL') * (G.coach.nflDraftees*1.4 + G.coach.attr.PlayerDev*0.12);
  a += g('Playing Time') * playingTimeAppeal(r,t);
  a += g('Coaching Stability') * (G.coach.yearsAtJob*2.2 + 4);
  if(t.id===r.dreamSchool) a+=14;
  if(isNaN(a)) a=t.prestige*0.35;
  return clamp(Math.round(a),0,100);
}
function playingTimeAppeal(r,t){
  const depth=t.roster.filter(p=>p.pos===r.pos).length;
  return clamp(18-depth*1.6,2,18);
}

/* Coach recruiting power scales the points->interest conversion. */
function recruitPower(){
  let p = 1 + G.coach.attr.Recruiting/100;
  if(G.coach.traits.includes('closer')) p+=0.18;
  if(G.coach.arch==='savant') p+=0.22;
  return p;
}

/* Weekly recruiting progression for AI competition + my committed safety. */
function recruitTick(){
  const pr = G.recruits;
  // only operate on the relevant blue-chip-ish pool for perf
  const pool = pr.filter(r=>!r.signed && r.natRank<=240);
  pool.forEach(r=>{
    if(r.committed){
      // small chance a rival pushes; my commits can wobble if I ignore them
      if(rng()<0.04){
        const rival=pick(G.teams.filter(t=>t.id!==r.committed&&t.prestige>60));
        r.interest[rival.id]=clamp((r.interest[rival.id]||0)+rndi(6,16),0,100);
        if(r.committed===G.myTeamId && (r.interest[rival.id]||0) > (r.interest[G.myTeamId]||0)+10 && rng()<0.5){
          // flip alert away from me
          pushNews('bad',`⚠️ ${r.name} wavering`,`${r.stars}★ ${r.pos} ${r.name} is taking another look at ${rival.short}. Lock him down.`);
        }
      }
      return;
    }
    // AI teams build interest passively
    if(rng()<0.5){
      const t=pick(G.teams.filter(x=>x.id!==G.myTeamId));
      const base = t.prestige*0.05 + (t.conf===r.homeConf?1.5:0) + (t.id===r.dreamSchool?2.5:0);
      r.interest[t.id]=clamp((r.interest[t.id]||0)+base+rnd(0,3),0,100);
    }
    // a recruit may commit to an AI school mid-cycle (creates urgency)
    const entries=Object.entries(r.interest).filter(([tid])=>tid!==G.myTeamId);
    if(entries.length){
      const best=entries.sort((a,b)=>b[1]-a[1])[0];
      if(best[1]>=COMMIT_NOW() && rng()<0.18){
        r.committed=best[0];
        if(G.board.includes(r.id)){
          const t=teamById(best[0]);
          pushNews('bad',`📉 Lost a target`,`${r.stars}★ ${r.name} (${r.pos}) committed to ${t.short}. He was on your board.`);
        }
      }
    }
  });
}
function COMMIT_NOW(){ return CONFIG.COMMIT_THRESHOLD + 6; }

/* Transfer portal weekly trickle during season (small) + window surges handled elsewhere. */
function portalTick(){
  // light in-season chatter; real windows open in offseason
  if(rng()<0.25){
    const t=pick(G.teams.filter(x=>x.id!==G.myTeamId));
    const p=pick(t.roster.filter(pl=>!pl.starter));
    if(p && !G.portal.find(x=>x.id===p.id)){
      // not a full entry yet, just chatter
    }
  }
}

/* ---- Recruiting actions (cost recruitPoints) ---- */
const RECRUIT_ACTIONS = {
  scout:  {label:'Scout',       cost:1, info:'Narrow attribute ranges & reveal motivations'},
  offer:  {label:'Send Offer',  cost:1, info:'Put a scholarship on the table (+interest, enables visits)'},
  call:   {label:'Call',        cost:1, info:'Build the relationship (+interest)'},
  visit:  {label:'Official Visit',cost:3,info:'Big interest swing; game-day boost if ranked & winning'},
  pitch:  {label:'Pitch',       cost:2, info:'Sell a motivation — strong if it matches their priorities'},
  closer: {label:'Hard Sell',   cost:4, info:'Closer move — large swing, best when interest is already high'},
};

function spendPts(n){
  if(G.recruitPoints < n){ toast('Not enough recruiting points this week'); return false; }
  G.recruitPoints -= n;
  return true;
}

function doScout(rid){
  const r=G.recruits.find(x=>x.id===rid); if(!r) return;
  if(r.offered===undefined) r.offered=false;
  if(!spendPts(RECRUIT_ACTIONS.scout.cost)) return;
  r.scout=clamp(r.scout+rndi(22,34),0,100);
  const tight=Math.round(16*(1-r.scout/100))+1;
  r.ovrLow=clamp(r.trueOvr-tight,40,99);
  r.ovrHigh=clamp(r.trueOvr+tight,40,99);
  toast(`Scouted ${r.name} (${r.scout}%)`);
  refreshRecruitModal(rid);
}
function doOffer(rid){
  const r=G.recruits.find(x=>x.id===rid); if(!r) return;
  if(!spendPts(RECRUIT_ACTIONS.offer.cost)) return;
  r.offered=true;
  bumpInterest(r, 14 + myAppeal(r)*0.12);
  toast(`Offered ${r.name}`);
  refreshRecruitModal(rid);
}
function doCall(rid){
  const r=G.recruits.find(x=>x.id===rid); if(!r) return;
  if(!spendPts(RECRUIT_ACTIONS.call.cost)) return;
  bumpInterest(r, 8 + G.coach.attr.Recruiting*0.08);
  toast(`Called ${r.name}`);
  refreshRecruitModal(rid);
}
function doVisit(rid){
  const r=G.recruits.find(x=>x.id===rid); if(!r) return;
  if(!r.offered){ toast('Send an offer before hosting a visit'); return; }
  if(!spendPts(RECRUIT_ACTIONS.visit.cost)) return;
  const t=myTeam(); const rank=rankOf(t.id);
  let swing=12;
  if(rank && rank<=25) swing+=6;
  swing += t.facilities*0.06;
  r.visited[t.id]=true;
  bumpInterest(r, swing);
  toast(`${r.name} visited — interest up`);
  refreshRecruitModal(rid);
}
function openPitch(rid){
  const r=G.recruits.find(x=>x.id===rid); if(!r) return;
  const motivs = r.scout>=40
    ? Object.entries(r.motivations).sort((a,b)=>b[1]-a[1]).map(e=>e[0])
    : shuffle(Object.keys(r.motivations));
  const opts = MOTIVATIONS
    .map(m=>{
      const known=r.scout>=40;
      const w=r.motivations[m]||0;
      const tag = known ? `<span class="mut">${w}</span>` : '';
      return `<div class="li" onclick="doPitch('${rid}','${m}')"><div><b>${m}</b></div>${tag}</div>`;
    }).join('');
  modal(`
    <h3 style="margin:0 0 4px">Pitch — ${r.name}</h3>
    <div class="mut sm mb10">Match the pitch to what he actually wants. Scout him to reveal his motivation weights.</div>
    ${opts}
  `);
}
function doPitch(rid,motiv){
  const r=G.recruits.find(x=>x.id===rid); if(!r) return;
  if(!spendPts(RECRUIT_ACTIONS.pitch.cost)) return;
  const w=r.motivations[motiv]||30;
  const swing = 3 + (w/100)*16; // strong if it matches
  bumpInterest(r, swing);
  closeModal();
  toast(w>=60?`Great pitch! ${r.name} loved it`:w<=30?`Weak pitch — didn't land`:`Pitch landed`);
  refreshRecruitModal(rid);
}
function doCloser(rid){
  const r=G.recruits.find(x=>x.id===rid); if(!r) return;
  if(!spendPts(RECRUIT_ACTIONS.closer.cost)) return;
  const cur=r.interest[G.myTeamId]||0;
  let swing= cur>60 ? rndi(10,20) : rndi(3,9);
  if(G.coach.traits.includes('closer')) swing*=1.4;
  bumpInterest(r, swing);
  // closer can immediately trigger commitment
  toast(`Hard sell on ${r.name}`);
  maybeCommitToMe(r);
  refreshRecruitModal(rid);
}
/* A recruit's star tier expects a certain program prestige. A program far below
   that expectation can only build LIMITED interest — a 5★ will not commit to a
   bad school no matter how hard you recruit. Returns a 0..100 interest ceiling. */
function recruitExpectedPrestige(r){
  // what prestige a recruit of this caliber expects from a suitor.
  // Tuned so 3★ (the bulk) are gettable for most programs, 5★ need elite programs.
  return {5:80, 4:64, 3:46, 2:30}[r.stars] || 40;
}
function recruitInterestCeiling(r){
  const t=myTeam();
  const expected=recruitExpectedPrestige(r);
  let effPrestige = t.prestige;
  // your program looks better if you're ranked, winning, have NIL/NFL pipeline
  const rank=rankOf(t.id);
  if(rank && rank<=25) effPrestige += (26-rank)*0.6;
  effPrestige += Math.min(10, t.nilStrength*0.08);
  effPrestige += Math.min(8, (G.coach?G.coach.nflDraftees:0)*0.8);
  if(t.id===r.dreamSchool) effPrestige += 12;
  effPrestige += recentRecordMomentum() * 0.6; // a strong last season extends your reach; a bad one shrinks it
  const gap = expected - effPrestige; // positive = program is below his expectation
  if(gap<=0) return 100;              // you meet/exceed his standard
  // each point of gap shaves the ceiling; big gaps make him unreachable
  const ceiling = clamp(100 - gap*4.0, 6, 100);
  return Math.round(ceiling);
}

function bumpInterest(r, amt){
  const power=recruitPower();
  const ceiling=recruitInterestCeiling(r);
  const cur=r.interest[G.myTeamId]||0;
  let next=cur+amt*power;
  // can't push past the ceiling; diminishing returns as you approach it
  if(next>ceiling){
    // allow tiny creep so it never feels totally dead, but never reach commit territory
    next = ceiling + Math.min( (next-ceiling)*0.05, Math.max(0, (100-ceiling)*0.15) );
  }
  r.interest[G.myTeamId]=clamp(next,0,100);
  maybeCommitToMe(r);
}
function maybeCommitToMe(r){
  if(r.committed) return;
  const mine=r.interest[G.myTeamId]||0;
  const others=Object.entries(r.interest).filter(([tid])=>tid!==G.myTeamId).map(e=>e[1]);
  const topOther=others.length?Math.max(...others):0;
  const lead = mine - topOther;
  // Effective bar drops the more clearly you're winning the battle.
  // Big lead over the field => recruit commits even in the 60s.
  let bar = CONFIG.COMMIT_THRESHOLD;
  if(lead>=40) bar -= 22;
  else if(lead>=25) bar -= 14;
  else if(lead>=12) bar -= 7;
  if(mine>=bar && mine>=topOther){
    const odds = (mine-bar)/30 + (lead>=25?0.25:0.12);
    if(rng()<clamp(odds,0.05,0.85)){
      r.committed=G.myTeamId;
      pushNews('good',`🎉 COMMIT: ${r.stars}★ ${r.name}`,`${r.pos} ${r.name} (#${r.natRank} nat'l) commits to ${myTeam().short}! Big win for the program.`);
      cutscene(`linear-gradient(135deg,${myTeam().colors[0]},${myTeam().colors[0]}cc)`,`
        <div style="animation:fadeIn .6s">
          <div class="display" style="font-size:13px;letter-spacing:4px;color:${myTeam().colors[1]}">COMMITTED</div>
          <div style="margin:14px auto 8px;width:84px">${faceSVG(r.id,84)}</div>
          <div style="margin:6px 0">${starHTML(r.stars)}</div>
          <div class="display" style="font-size:34px;line-height:1.1">${r.name}</div>
          <div class="mut" style="margin-top:6px">${r.archetype} · ${r.pos} · #${r.natRank} National</div>
          <button class="btn mt20" onclick="closeCut();go('recruit')">Let's go! →</button>
        </div>`);
    }
  }
}

function toggleBoard(rid){
  const i=G.board.indexOf(rid);
  if(i>=0) G.board.splice(i,1); else { if(G.board.length>=40){toast('Board full (40)');return;} G.board.push(rid); }
  save();
  if(CURRENT==='recruit') SCREENS.recruit($('#screen'));
  refreshRecruitModal(rid);
}

console.log('DYNASTY HC recruiting engine loaded');
</script>
<script>
/* ---------------------------------------------------------------------------
   SECTION U — RECRUIT SCREEN (the deepest system)
   --------------------------------------------------------------------------- */
let RECF = {pos:'ALL', sort:'rank', view:'targets', q:''};

SCREENS.recruit = function(root){
  const t=myTeam();
  const committedMine=G.recruits.filter(r=>r.committed===G.myTeamId);
  const classRank=computeClassRank();
  const inCycle = (G.phase==='regular'||G.phase==='preseason'||G.phase==='confchamp'||G.phase==='playoff'||G.phase==='bowls'||G.phase==='awards');

  let pool;
  if(RECF.view==='board') pool=G.board.map(id=>G.recruits.find(r=>r.id===id)).filter(Boolean);
  else if(RECF.view==='committed') pool=committedMine;
  else pool=G.recruits.filter(r=>!r.committed && r.natRank<=300);

  if(RECF.pos!=='ALL') pool=pool.filter(r=>r.pos===RECF.pos);
  if(RECF.q){ const q=RECF.q.toLowerCase(); pool=pool.filter(r=>r.name.toLowerCase().includes(q)); }
  pool=pool.slice();
  if(RECF.sort==='rank') pool.sort((a,b)=>a.natRank-b.natRank);
  else if(RECF.sort==='interest') pool.sort((a,b)=>(b.interest[G.myTeamId]||0)-(a.interest[G.myTeamId]||0));
  else if(RECF.sort==='pos') pool.sort((a,b)=>a.pos.localeCompare(b.pos)||a.posRank-b.posRank);
  pool=pool.slice(0,80);

  const needList = positionNeeds(t);

  root.innerHTML=`
    <div class="card mb10">
      <div class="row between">
        <div>
          <div class="display lg">RECRUITING</div>
          <div class="mut sm">${G.year} class · Signed/committed: ${committedMine.length}/${CONFIG.CLASS_SIZE_TARGET} target</div>
        </div>
        <div class="center">
          <div class="display xl" style="color:var(--accent)">#${classRank.rank}</div>
          <div class="mut xs">CLASS RANK</div>
        </div>
      </div>
      <div class="row between mt10">
        <div class="pill"><span class="ic">⚡</span> ${G.recruitPoints} recruiting pts ${inCycle?'this week':'(cycle paused)'}</div>
        <div class="mut xs">Board: ${G.board.length}/40</div>
      </div>
    </div>

    <div class="card tight mb10">
      <div class="mut xs mb6">POSITION NEEDS</div>
      <div class="row wrap gap6">
        ${needList.map(n=>`<span class="chip ${n.need>=2?'bad':n.need>=1?'gold':''}">${n.pos} <b>${n.have}</b>${n.need>0?` · need ${n.need}`:''}</span>`).join('')}
      </div>
    </div>

    <div class="tabs mb10">
      ${[['targets','Targets'],['board','Board'],['committed','Commits']].map(([v,l])=>
        `<button class="${RECF.view===v?'active':''}" onclick="RECF.view='${v}';SCREENS.recruit($('#screen'))">${l}</button>`).join('')}
    </div>

    <div class="row gap6 mb10">
      <input class="searchbar" style="flex:1" placeholder="Search recruits…" value="${RECF.q}"
        oninput="RECF.q=this.value;clearTimeout(window._rq);window._rq=setTimeout(()=>SCREENS.recruit($('#screen')),250)">
      <select class="sel" onchange="RECF.pos=this.value;SCREENS.recruit($('#screen'))">
        ${['ALL',...POSITIONS].map(p=>`<option ${RECF.pos===p?'selected':''}>${p}</option>`).join('')}
      </select>
      <select class="sel" onchange="RECF.sort=this.value;SCREENS.recruit($('#screen'))">
        <option value="rank" ${RECF.sort==='rank'?'selected':''}>Nat'l Rank</option>
        <option value="interest" ${RECF.sort==='interest'?'selected':''}>My Interest</option>
        <option value="pos" ${RECF.sort==='pos'?'selected':''}>Position</option>
      </select>
    </div>

    <div id="recruit-list">
      ${pool.length?pool.map(r=>recruitRow(r)).join(''):'<div class="card center mut">No recruits match.</div>'}
    </div>
  `;
};

function recruitRow(r){
  const mine=Math.round(r.interest[G.myTeamId]||0);
  const onBoard=G.board.includes(r.id);
  const commit = r.committed ? (r.committed===G.myTeamId?'<span class="chip good">★ YOURS</span>':`<span class="chip red">→ ${teamById(r.committed).abbr}</span>`) : '';
  const ovrTxt = r.scout>=85? r.trueOvr : `${r.ovrLow}–${r.ovrHigh}`;
  return `<div class="li" onclick="openRecruit('${r.id}')">
    ${recruitAvatar(r,44)}
    <div style="flex:1;min-width:0">
      <div class="row gap6"><b style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${r.name}</b>${onBoard?'<span class="ic">📌</span>':''}</div>
      <div class="mut xs">${starHTML(r.stars)} · #${r.natRank} · ${r.archetype}</div>
      <div class="meter" style="margin-top:5px"><div style="width:${mine}%;background:${meterColor(mine)}"></div></div>
    </div>
    <div class="center" style="min-width:54px">
      <div class="b sm">${ovrTxt}</div>
      <div class="mut xs">OVR</div>
      ${commit}
    </div>
  </div>`;
}

function starColor(s){ return s>=5?'#ff5a1f':s===4?'#ffb01f':s===3?'#3a9bdc':'#5a6472'; }

function positionNeeds(t){
  return POSITIONS.map(pos=>{
    const have=t.roster.filter(p=>p.pos===pos).length;
    const want={QB:3,RB:4,WR:7,TE:3,OL:9,DL:7,LB:6,CB:5,S:4,K:2}[pos]||3;
    return {pos, have, need:Math.max(0,want-have)};
  }).sort((a,b)=>b.need-a.need);
}

function openRecruit(rid){
  refreshRecruitModal(rid, true);
}
function refreshRecruitModal(rid, forceOpen){
  const r=G.recruits.find(x=>x.id===rid); if(!r) return;
  const isOpen=$('#modal-wrap').classList.contains('show');
  if(!isOpen && !forceOpen) return;
  const mine=Math.round(r.interest[G.myTeamId]||0);
  const onBoard=G.board.includes(r.id);
  const scouted=r.scout>=40;
  const t=myTeam();
  const appeal=myAppeal(r);

  // top competitors
  const comps=Object.entries(r.interest).filter(([tid,v])=>tid!==G.myTeamId&&v>15)
    .sort((a,b)=>b[1]-a[1]).slice(0,3)
    .map(([tid,v])=>`<span class="chip">${teamById(tid).abbr} ${Math.round(v)}</span>`).join('') || '<span class="mut xs">No major competition yet</span>';

  const motivHTML = Object.entries(r.motivations).sort((a,b)=>b[1]-a[1]).map(([m,w])=>{
    const show = scouted;
    return `<div class="attr"><div class="lbl"><span>${m}</span><span>${show?w:'??'}</span></div>
      <div class="bar"><div style="width:${show?w:30}%;background:${show?meterColor(w):'#3a4150'}"></div></div></div>`;
  }).join('');

  const committedElsewhere = r.committed && r.committed!==G.myTeamId;
  const committedMine = r.committed===G.myTeamId;

  const actions = committedMine ? `<div class="card good center">★ Committed to ${t.short}. Keep an eye out for flip attempts.</div>`
    : `<div class="grid3 gap6">
        ${actionBtn('scout',rid)}
        ${actionBtn('offer',rid, r.offered)}
        ${actionBtn('call',rid)}
        ${actionBtn('visit',rid, false, !r.offered)}
        ${actionBtn('pitch',rid)}
        ${actionBtn('closer',rid)}
      </div>`;

  modal(`
    <div class="row between mb6">
      <div class="row gap8">
        ${recruitAvatar(r,56)}
        <div>
          <div class="display lg" style="line-height:1">${r.name}</div>
          <div class="mut sm">${starHTML(r.stars)} · #${r.natRank} nat'l · ${r.pos}${r.posRank} · ${r.archetype}</div>
        </div>
      </div>
      <button class="btn sm ${onBoard?'gold':'ghost'}" onclick="toggleBoard('${rid}')">${onBoard?'📌 On Board':'+ Board'}</button>
    </div>

    ${committedElsewhere?`<div class="card red center mb10">Committed to ${teamById(r.committed).name}</div>`:''}

    <div class="grid2 gap6 mb10">
      <div class="statbox"><div class="bignum">${r.scout>=85?r.trueOvr:`${r.ovrLow}–${r.ovrHigh}`}</div><div class="lbl">OVR ${r.scout>=85?'':'(range)'}</div></div>
      <div class="statbox"><div class="bignum" style="color:${meterColor(mine)}">${mine}</div><div class="lbl">My Interest</div></div>
    </div>

    <div class="subcard mb10">
      <div class="row between sm"><span class="mut">Hometown</span><b>${r.homeState}</b></div>
      <div class="row between sm"><span class="mut">Dream school</span><b>${r.scout>=40?(teamById(r.dreamSchool)?.short||'—'):'??'}</b></div>
      <div class="row between sm"><span class="mut">Personality</span><b>${r.scout>=40?r.personality:'??'}</b></div>
      <div class="row between sm"><span class="mut">Dev trait</span><b>${r.scout>=70?r.devTrait:'??'}</b></div>
      <div class="row between sm"><span class="mut">Scouted</span><b>${r.scout}%</b></div>
      <div class="row between sm"><span class="mut">Your appeal to him</span><b style="color:${meterColor(appeal)}">${appeal}</b></div>
      <div class="row between sm"><span class="mut">Realistic interest cap</span><b style="color:${meterColor(recruitInterestCeiling(r))}">${recruitInterestCeiling(r)<100?recruitInterestCeiling(r):'No limit'}</b></div>
    </div>
    ${recruitInterestCeiling(r)<CONFIG.COMMIT_THRESHOLD?`<div class="card center mb10" style="border-color:var(--red)"><b class="sm">⚠️ Out of your league</b><div class="mut xs mt6">A ${r.stars}★ won't commit to a program at your level right now. Win big, build NIL & facilities, and your reach grows.</div></div>`:''}

    <div class="mut xs mb6">MOTIVATIONS ${scouted?'':'(scout to reveal)'}</div>
    <div class="mb10">${motivHTML}</div>

    <div class="mut xs mb6">COMPETITION</div>
    <div class="row wrap gap6 mb10">${comps}</div>

    <div class="mut xs mb6">BACKSTORY</div>
    <div class="news mb10" style="font-style:italic">${r.backstory}</div>

    <div class="mut xs mb6">ACTIONS · ${G.recruitPoints} pts left</div>
    ${actions}
  `);
}
function actionBtn(key,rid,done,disabled){
  const a=RECRUIT_ACTIONS[key];
  const fnMap={scout:'doScout',offer:'doOffer',call:'doCall',visit:'doVisit',pitch:'openPitch',closer:'doCloser'};
  const dis = disabled || G.recruitPoints<a.cost;
  return `<button class="btn sm ${done?'good':'outline'}" ${dis?'disabled style="opacity:.4"':''}
    onclick="${fnMap[key]}('${rid}')" title="${a.info}">
    ${a.label}<br><span class="xs mut">${a.cost} pt${a.cost>1?'s':''}</span></button>`;
}

console.log('DYNASTY HC recruit screen loaded');
</script>
<script>
/* ---------------------------------------------------------------------------
   SECTION V — TEAM SCREEN (roster · depth · development) + MONEY SCREEN
   --------------------------------------------------------------------------- */
let TEAMF = {pos:'ALL', sort:'ovr', view:'roster'};

SCREENS.team = function(root){
  const t=myTeam();
  setDepthChart(t);
  const str=teamStrength(t);
  let roster=t.roster.slice();
  if(TEAMF.pos!=='ALL') roster=roster.filter(p=>p.pos===TEAMF.pos);
  if(TEAMF.sort==='ovr') roster.sort((a,b)=>b.ovr-a.ovr);
  else if(TEAMF.sort==='pos') roster.sort((a,b)=>POSITIONS.indexOf(a.pos)-POSITIONS.indexOf(b.pos)||b.ovr-a.ovr);
  else if(TEAMF.sort==='year') roster.sort((a,b)=>yearOrder(a.year)-yearOrder(b.year)||b.ovr-a.ovr);
  else if(TEAMF.sort==='nil') roster.sort((a,b)=>b.nil-a.nil);

  const avgMorale=Math.round(t.roster.reduce((s,p)=>s+p.morale,0)/t.roster.length);

  root.innerHTML=`
    <div class="card mb10">
      <div class="row gap8">
        ${teamBadge(t,52)}
        <div style="flex:1">
          <div class="display lg" style="line-height:1">${t.name}</div>
          <div class="mut sm">${t.confName} · ${t.tier} · ${t.roster.length}/${CONFIG.ROSTER_LIMIT} roster</div>
        </div>
      </div>
      <div class="grid3 gap6 mt10">
        <div class="statbox"><div class="v" style="color:${ovrColor(str.overall)}">${str.overall}</div><div class="l">Team OVR</div></div>
        <div class="statbox"><div class="v" style="color:${ovrColor(str.off)}">${str.off}</div><div class="l">Offense</div></div>
        <div class="statbox"><div class="v" style="color:${ovrColor(str.def)}">${str.def}</div><div class="l">Defense</div></div>
      </div>
      <div class="row between mt10 sm">
        <span class="mut">Team morale / culture</span>
        <b style="color:${meterColor(avgMorale)}">${avgMorale}</b>
      </div>
      <div class="meter mt6"><div style="width:${avgMorale}%;background:${meterColor(avgMorale)}"></div></div>
    </div>

    <div class="tabs mb10">
      ${[['roster','Roster'],['depth','Depth Chart']].map(([v,l])=>
        `<button class="${TEAMF.view===v?'active':''}" onclick="TEAMF.view='${v}';SCREENS.team($('#screen'))">${l}</button>`).join('')}
    </div>

    ${TEAMF.view==='depth' ? depthChartHTML(t) : `
      <div class="row gap6 mb10">
        <select class="sel" style="flex:1" onchange="TEAMF.pos=this.value;SCREENS.team($('#screen'))">
          ${['ALL',...POSITIONS].map(p=>`<option ${TEAMF.pos===p?'selected':''}>${p}</option>`).join('')}
        </select>
        <select class="sel" style="flex:1" onchange="TEAMF.sort=this.value;SCREENS.team($('#screen'))">
          <option value="ovr" ${TEAMF.sort==='ovr'?'selected':''}>By OVR</option>
          <option value="pos" ${TEAMF.sort==='pos'?'selected':''}>By Position</option>
          <option value="year" ${TEAMF.sort==='year'?'selected':''}>By Class</option>
          <option value="nil" ${TEAMF.sort==='nil'?'selected':''}>By NIL $</option>
        </select>
      </div>
      ${roster.map(p=>playerRow(p)).join('')}
    `}
  `;
};

function yearOrder(y){ return {'FR':0,'RS-FR':1,'SO':2,'RS-SO':3,'JR':4,'RS-JR':5,'SR':6,'RS-SR':7}[y]??3; }

function playerRow(p){
  const inj = p.injury ? `<span class="chip red">🩹 ${p.injury.weeks}w</span>` : '';
  return `<div class="li" onclick="openPlayer('${p.id}')">
    ${playerAvatar(p,44)}
    <div style="flex:1;min-width:0">
      <div class="row gap6"><b>${p.name}</b>${p.starter?'<span class="chip gold xs">ST</span>':''}${inj}</div>
      <div class="mut xs">${p.pos} · ${p.year} · ${p.archetype} · ${starHTML(p.stars)}</div>
    </div>
    <div class="center" style="min-width:50px">
      <div class="sm b">${money(p.nil)}</div>
      <div class="mut xs">NIL</div>
    </div>
  </div>`;
}

function depthChartHTML(t){
  return POSITIONS.map(pos=>{
    const players=t.roster.filter(p=>p.pos===pos).sort((a,b)=>(b.starter-a.starter)||b.ovr-a.ovr);
    if(!players.length) return '';
    return `<div class="card tight mb6">
      <div class="row between mb6"><b>${pos}</b><span class="mut xs">${players.length} deep</span></div>
      ${players.slice(0,6).map((p,i)=>`<div class="row between sm" style="padding:3px 0">
        <span>${i===0?'<b style="color:var(--accent)">1.</b>':`${i+1}.`} ${p.name} <span class="mut xs">${p.year}</span></span>
        <b style="color:${ovrColor(p.ovr)}">${p.ovr}</b>
      </div>`).join('')}
    </div>`;
  }).join('');
}

function openPlayer(pid){
  const t=myTeam();
  const p=t.roster.find(x=>x.id===pid); if(!p) return;
  const attrs=playerAttrs(p);
  modal(`
    <div class="row gap8 mb10">
      ${playerAvatar(p,60)}
      <div>
        <div class="display lg" style="line-height:1">${p.name}</div>
        <div class="mut sm">${p.pos} · ${p.year} · ${p.archetype}</div>
        <div class="mut sm">${starHTML(p.stars)} · age ${p.age} · ceiling ${p.ceiling}</div>
      </div>
    </div>
    ${p.injury?`<div class="card red center mb10">🩹 Injured — out ${p.injury.weeks} week(s) (${p.injury.type})</div>`:''}
    <div class="grid3 gap6 mb10">
      <div class="statbox"><div class="v" style="color:${meterColor(p.morale)}">${p.morale}</div><div class="l">Morale</div></div>
      <div class="statbox"><div class="v">${p.durability}</div><div class="l">Durability</div></div>
      <div class="statbox"><div class="v" style="font-size:15px">${p.devTrait.split(' ')[0]}</div><div class="l">Dev Trait</div></div>
    </div>
    <div class="mb10">${attrs.map(a=>attrBar(a.k,a.v)).join('')}</div>
    <div class="subcard mb10">
      <div class="row between sm"><span class="mut">NIL / rev-share</span><b>${money(p.nil)}</b></div>
      <div class="row between sm"><span class="mut">Personality</span><b>${p.personality}</b></div>
      <div class="row between sm"><span class="mut">Depth status</span><b>${p.starter?'Starter':'Rotation/Reserve'}</b></div>
    </div>
    ${seasonStatsHTML(p)}
    ${!p.starter && p.morale<55 ? `<button class="btn outline full" onclick="promiseTime('${pid}')">Promise playing time (+morale)</button>`:''}
  `);
}

function playerAttrs(p){
  // derive flavorful sub-attributes from ovr deterministically
  const base=p.ovr;
  const seed=parseInt(p.id.slice(-4),36)||1;
  const j=(n)=>clamp(base+((seed>>(n*2))%11)-5,38,99);
  const map={
    QB:[['Arm',1],['Accuracy',2],['Mobility',3],['IQ',4]],
    RB:[['Speed',1],['Power',2],['Vision',3],['Hands',4]],
    WR:[['Speed',1],['Hands',2],['Route',3],['Release',4]],
    TE:[['Block',1],['Hands',2],['Speed',3],['Route',4]],
    OL:[['Pass Block',1],['Run Block',2],['Strength',3],['Awareness',4]],
    DL:[['Pass Rush',1],['Run Stop',2],['Strength',3],['Speed',4]],
    LB:[['Tackle',1],['Coverage',2],['Speed',3],['Blitz',4]],
    CB:[['Coverage',1],['Speed',2],['Press',3],['Ball Skills',4]],
    S:[['Coverage',1],['Tackle',2],['Range',3],['IQ',4]],
    K:[['Power',1],['Accuracy',2],['Clutch',3],['Long',4]],
  };
  return (map[p.pos]||[['Athletic',1],['Technique',2],['IQ',3],['Strength',4]]).map(([k,n])=>({k,v:j(n)}));
}

function seasonStatsHTML(p){
  const s=p.seasonStats;
  if(!s||!Object.keys(s).length) return '<div class="subcard mb10"><div class="mut xs mb6">'+G.year+' SEASON</div><div class="sm mut">No stats recorded yet.</div></div>';
  const rows=[];
  const gp=s.gp||0;
  if(s.passAtt){
    const cmp=`${s.passComp||0}/${s.passAtt} (${Math.round((s.passComp||0)/s.passAtt*100)}%)`;
    rows.push(['Passing', `${s.passYds||0} yds`, `${cmp}, ${s.passTD||0} TD, ${s.int||0} INT`]);
  }
  if(s.rushAtt){
    rows.push(['Rushing', `${s.rushYds||0} yds`, `${s.rushAtt} car (${((s.rushYds||0)/s.rushAtt).toFixed(1)} avg), ${s.rushTD||0} TD`]);
  }
  if(s.rec){
    rows.push(['Receiving', `${s.recYds||0} yds`, `${s.rec} rec (${((s.recYds||0)/s.rec).toFixed(1)} avg), ${s.recTD||0} TD`]);
  }
  if(s.tackles){
    const d=[`${s.tackles} tkl`];
    if(s.tfl)d.push(`${s.tfl} TFL`); if(s.sacks)d.push(`${s.sacks} sk`); if(s.intDef)d.push(`${s.intDef} INT`); if(s.pbu)d.push(`${s.pbu} PBU`); if(s.ff)d.push(`${s.ff} FF`);
    rows.push(['Defense', `${s.tackles} tackles`, d.slice(1).join(', ')||'—']);
  }
  if(s.fga||s.xpa){
    rows.push(['Kicking', `${s.kpts||0} pts`, `${s.fgm||0}/${s.fga||0} FG, ${s.xpm||0}/${s.xpa||0} XP`]);
  }
  if(!rows.length) return '';
  return `<div class="subcard mb10">
    <div class="row between mb6"><div class="mut xs">${G.year} SEASON STATS</div><div class="mut xs">${gp} GP</div></div>
    ${rows.map(([cat,big,detail])=>`<div class="row between" style="padding:5px 0;border-top:1px solid var(--line)"><div><b class="sm">${cat}</b><div class="mut xs">${detail}</div></div><div class="b" style="color:var(--accent2)">${big}</div></div>`).join('')}
  </div>`;
}

function promiseTime(pid){
  const p=myTeam().roster.find(x=>x.id===pid); if(!p) return;
  p.morale=clamp(p.morale+rndi(8,16),0,100);
  toast(`Promised ${p.name} a bigger role`);
  save(); openPlayer(pid);
}

/* ---------------------------------------------------------------------------
   MONEY SCREEN — NIL / revenue share / collective
   --------------------------------------------------------------------------- */
SCREENS.money = function(root){
  const t=myTeam();
  const rev=t.revShareBudget, nil=t.nilBudget;
  const total=rev+nil;
  const allocated=t.roster.reduce((s,p)=>s+p.nil,0);
  const remaining=Math.max(0,total-allocated);
  const yearsElapsed=G.year-CONFIG.START_YEAR;
  const capNow=CONFIG.REVSHARE_CAP_BASE*Math.pow(1+CONFIG.REVSHARE_CAP_GROWTH,yearsElapsed);
  const topPaid=t.roster.slice().sort((a,b)=>b.nil-a.nil).slice(0,8);

  root.innerHTML=`
    <div class="card mb10">
      <div class="display lg mb6">MONEY</div>
      <div class="mut sm mb10">House-settlement era: a ~${money(capNow)} school-wide rev-share cap (football gets a slice), plus a booster-funded NIL collective on top.</div>
      <div class="grid2 gap6">
        <div class="statbox"><div class="v" style="color:var(--accent)">${money(rev)}</div><div class="l">Rev-Share (football)</div></div>
        <div class="statbox"><div class="v" style="color:var(--accent2)">${money(nil)}</div><div class="l">NIL Collective</div></div>
      </div>
    </div>

    <div class="card mb10">
      <div class="row between mb6"><b>Player payroll</b><span class="mut sm">${money(allocated)} / ${money(total)}</span></div>
      <div class="meter"><div style="width:${clamp(allocated/total*100,0,100)}%;background:${allocated>total?'var(--bad)':'var(--accent)'}"></div></div>
      <div class="row between mt6 sm"><span class="mut">Remaining to spend</span><b style="color:${remaining>0?'var(--good)':'var(--txt2)'}">${money(remaining)}</b></div>
    </div>

    <div class="card mb10">
      <div class="mut xs mb6">FUNDRAISING (grow next year's pools)</div>
      <div class="grid2 gap6">
        <button class="btn outline" onclick="fundraise('donor')">🤝 Donor Meeting<br><span class="xs mut">Fundraising stat → NIL</span></button>
        <button class="btn outline" onclick="fundraise('booster')">🎟️ Booster Event<br><span class="xs mut">Boost collective</span></button>
      </div>
      <div class="mut xs mt6">Fundraising stat: <b>${G.coach.attr.Fundraising}</b> · NIL strength: <b>${t.nilStrength}</b></div>
    </div>

    <div class="mut xs mb6">TOP EARNERS</div>
    ${topPaid.map(p=>`<div class="li">
      ${playerAvatar(p,40)}
      <div style="flex:1"><b>${p.name}</b><div class="mut xs">${p.pos} · ${p.year}</div></div>
      <b>${money(p.nil)}</b>
    </div>`).join('')}
  `;
};

let _fundUsed={};
function fundraise(kind){
  const key=G.year+'-'+G.week+'-'+kind;
  if(_fundUsed[key]){ toast('Already did that this week'); return; }
  _fundUsed[key]=true;
  const t=myTeam();
  const gain=(G.coach.attr.Fundraising/100)*rnd(0.2,0.8)+0.1;
  if(kind==='donor'){ t.nilStrength=clamp(t.nilStrength+rndi(1,3),0,100); }
  t.nilBudget=+(t.nilBudget+gain).toFixed(2);
  G.coach.attr.Fundraising=clamp(G.coach.attr.Fundraising+0.4,10,99);
  toast(`+${money(gain)} to the collective`);
  save(); SCREENS.money($('#screen'));
}

console.log('DYNASTY HC team + money screens loaded');
</script>
<script>
/* ---------------------------------------------------------------------------
   SECTION W — TRANSFER PORTAL (windows · entries · retention · bidding)
   --------------------------------------------------------------------------- */
function openPortalWindow(season){
  G.portal=[];
  G.portalBoard=[];
  // Every team sends some players to the portal. Buried/unhappy players more likely.
  // Rates kept modest so rosters stay viable and the board stays curated.
  G.teams.forEach(t=>{
    const isMine = t.id===G.myTeamId;
    setDepthChart(t);
    t.roster.forEach(p=>{
      if(['SR','RS-SR'].includes(p.year)) return; // graduating handled elsewhere
      let leaveChance = 0.02;
      if(!p.starter) leaveChance += 0.05;
      if(p.morale<50) leaveChance += 0.08;
      if(p.morale<35) leaveChance += 0.10;
      if(isMine){
        // for the player's team we surface every departure, so keep it meaningful but not punishing
        leaveChance += 0.02;
        if(G.coach.arch==='players') leaveChance*=0.5;     // player's coach retains
        if(G.coach.traits.includes('loyal')) leaveChance*=0.7;
        const lastRec=G.history[G.history.length-1];
        if(lastRec && lastRec.myRecord){ const [w,l]=lastRec.myRecord.split('-').map(Number); if(w<l) leaveChance+=0.05; } // losing season
      } else {
        // cap AI contributions to keep the board manageable
        if(G.portal.filter(e=>!e.wasMine).length>=140) return;
      }
      if(rng()<leaveChance){
        const entry=makePortalEntry(p,t);
        G.portal.push(entry);
        if(isMine){
          entry.wasMine=true;
          pushNews('bad',`🔁 ${p.name} enters the portal`,`Your ${p.pos} ${p.name} (${p.ovr} OVR) has entered the transfer portal.`);
        }
      }
    });
  });
  // Coaching-change exodus: a couple of AI programs that got a new coach bleed talent
  const churned=pickN(G.teams.filter(t=>t.id!==G.myTeamId), 3);
  churned.forEach(t=>{
    pickN(t.roster.filter(p=>!['SR','RS-SR'].includes(p.year)),2).forEach(p=>{
      if(!G.portal.find(x=>x.srcId===p.id)){
        G.portal.push(makePortalEntry(p,t));
      }
    });
  });
  G.portal.sort((a,b)=>b.ovr-a.ovr);
  G.portal.forEach((e,i)=>e.rank=i+1);
  pushNews('big',`🔁 ${season} transfer portal window OPEN`,`${G.portal.length} players entered the portal. Raid for instant-impact talent — but it costs NIL money.`);
}

function makePortalEntry(p,t){
  // remove from source roster so they're actually gone
  if(t){ const i=t.roster.indexOf(p); if(i>=0 && t.id!==G.myTeamId) t.roster.splice(i,1); }
  const askBase = (p.ovr-55)/8;
  return {
    id:id(), srcId:p.id, srcTeam:t?t.id:null, srcAbbr:t?t.abbr:'??',
    name:p.name, pos:p.pos, ovr:p.ovr, stars:p.stars, year:advanceYearLabel(p.year),
    archetype:p.archetype, ceiling:p.ceiling, devTrait:p.devTrait, age:p.age+1,
    ask:+clamp(askBase*rnd(0.7,1.5),0.05,8).toFixed(2), // NIL $M they want
    interest:{}, committed:null, wasMine:false,
    motivations:{nil:rndi(40,95),playingTime:rndi(40,95),winning:rndi(30,90)},
  };
}
function advanceYearLabel(y){ return {'FR':'SO','RS-FR':'RS-SO','SO':'JR','RS-SO':'RS-JR','JR':'SR','RS-JR':'RS-SR'}[y]||y; }

SCREENS.portal = function(root){
  const t=myTeam();
  const open = G.portal.length>0;
  const remaining=Math.max(0, (t.revShareBudget+t.nilBudget) - t.roster.reduce((s,p)=>s+p.nil,0));
  let pool=G.portal.filter(e=>!e.committed || e.committed===G.myTeamId);
  if(PORTF.pos!=='ALL') pool=pool.filter(e=>e.pos===PORTF.pos);
  pool.sort((a,b)=> PORTF.sort==='ovr'? b.ovr-a.ovr : a.ask-b.ask);
  pool=pool.slice(0,60);
  const myAdds=G.portal.filter(e=>e.committed===G.myTeamId);

  root.innerHTML=`
    <div class="card mb10">
      <div class="display lg mb6">TRANSFER PORTAL</div>
      ${open?`<div class="mut sm">${G.portal.filter(e=>!e.committed).length} available · window open. Portal players are pre-developed and want immediate impact + NIL money.</div>`
            :`<div class="mut sm">The portal is quiet right now. Windows open after the season (winter) and in spring.</div>`}
      <div class="row between mt10">
        <span class="pill">💰 ${money(remaining)} to spend</span>
        <span class="mut xs">Added: ${myAdds.length}</span>
      </div>
    </div>

    ${open?`
      <div class="row gap6 mb10">
        <select class="sel" style="flex:1" onchange="PORTF.pos=this.value;SCREENS.portal($('#screen'))">
          ${['ALL',...POSITIONS].map(p=>`<option ${PORTF.pos===p?'selected':''}>${p}</option>`).join('')}
        </select>
        <select class="sel" style="flex:1" onchange="PORTF.sort=this.value;SCREENS.portal($('#screen'))">
          <option value="ovr" ${PORTF.sort==='ovr'?'selected':''}>By OVR</option>
          <option value="ask" ${PORTF.sort==='ask'?'selected':''}>By Asking $</option>
        </select>
      </div>
      ${pool.map(e=>portalRow(e)).join('')}
    `:`<div class="card center mut">No portal activity. Advance the calendar to the next window.</div>`}
  `;
};
let PORTF={pos:'ALL',sort:'ovr'};

function portalRow(e){
  const mine=e.committed===G.myTeamId;
  const comp=Object.entries(e.interest).filter(([tid])=>tid!==G.myTeamId).length;
  return `<div class="li" onclick="openPortal('${e.id}')">
    ${playerAvatar({id:e.srcId||e.id, ovr:e.ovr},44)}
    <div style="flex:1;min-width:0">
      <div class="row gap6"><b>${e.name}</b>${e.wasMine?'<span class="chip red xs">EX-YOURS</span>':''}${mine?'<span class="chip good xs">SIGNED</span>':''}</div>
      <div class="mut xs">${e.pos} · ${e.year} · from ${e.srcAbbr} · ${starHTML(e.stars)}</div>
    </div>
    <div class="center" style="min-width:56px">
      <div class="sm b" style="color:var(--accent2)">${money(e.ask)}</div>
      <div class="mut xs">${comp?comp+' bidding':'asking'}</div>
    </div>
  </div>`;
}

function openPortal(eid){
  const e=G.portal.find(x=>x.id===eid); if(!e) return;
  const t=myTeam();
  const remaining=Math.max(0,(t.revShareBudget+t.nilBudget)-t.roster.reduce((s,p)=>s+p.nil,0));
  const mine=e.committed===G.myTeamId;
  const canAfford=remaining>=e.ask;
  const rank=rankOf(t.id);
  // pitch success odds preview
  let odds = 40 + (canAfford?20:-30) + (rank&&rank<=25?15:0) + (G.coach.attr.Recruiting-50)*0.3;
  odds=clamp(Math.round(odds),5,95);
  modal(`
    <div class="row gap8 mb10">
      ${playerAvatar({id:e.srcId||e.id, ovr:e.ovr},60)}
      <div>
        <div class="display lg" style="line-height:1">${e.name}</div>
        <div class="mut sm">${e.pos} · ${e.year} · ${e.archetype}</div>
        <div class="mut sm">${starHTML(e.stars)} · from ${teamById(e.srcTeam)?.name||e.srcAbbr} · ceiling ${e.ceiling}</div>
      </div>
    </div>
    ${e.wasMine?'<div class="card red center mb10">This is YOUR former player. Win him back?</div>':''}
    ${mine?'<div class="card good center mb10">✓ Committed to your program for next season.</div>':`
    <div class="grid2 gap6 mb10">
      <div class="statbox"><div class="v" style="color:var(--accent2)">${money(e.ask)}</div><div class="l">Asking NIL</div></div>
      <div class="statbox"><div class="v" style="color:${meterColor(odds)}">${odds}%</div><div class="l">Sign Odds</div></div>
    </div>
    <div class="mut xs mb6">He weighs NIL money, playing time, and winning heavily.</div>
    <button class="btn full ${canAfford?'':'outline'}" ${canAfford?'':'disabled style="opacity:.5"'} onclick="bidPortal('${eid}')">
      ${canAfford?`💰 Offer ${money(e.ask)} & Recruit`:'Not enough cap space'}
    </button>`}
  `);
}

function bidPortal(eid){
  const e=G.portal.find(x=>x.id===eid); if(!e||e.committed) return;
  const t=myTeam();
  const rank=rankOf(t.id);
  let odds = 40 + 20 + (rank&&rank<=25?15:0) + (G.coach.attr.Recruiting-50)*0.3;
  if(G.coach.traits.includes('portal')) odds+=18;
  if(e.wasMine) odds+=10;
  odds=clamp(odds,5,95);
  closeModal();
  if(rng()*100<odds){
    // sign: add to roster as the right year
    const p=makeSignedPlayer(e);
    t.roster.push(p);
    e.committed=G.myTeamId;
    pushNews('good',`🔁 PORTAL WIN: ${e.name}`,`${e.pos} ${e.name} (${e.ovr} OVR) transfers to ${t.short}! Instant-impact addition.`);
    toast(`${e.name} is a ${t.short}!`);
  } else {
    // someone else may snag him
    const rival=pick(G.teams.filter(x=>x.id!==G.myTeamId&&x.prestige>55));
    e.committed=rival.id;
    pushNews('bad',`Lost portal target`,`${e.name} chose ${rival.short} over you.`);
    toast(`${e.name} picked another school`);
  }
  save();
  if(CURRENT==='portal') SCREENS.portal($('#screen'));
}

function makeSignedPlayer(e){
  return {
    id:id(), name:e.name, pos:e.pos, archetype:e.archetype,
    stars:e.stars, ovr:e.ovr, ceiling:e.ceiling, year:e.year, redshirt:false,
    age:e.age, devTrait:e.devTrait, morale:rndi(60,85), durability:rndi(50,95),
    nil:e.ask, injury:null, personality:pick(['Vocal Leader','Quiet Worker','Team Player','Coachable']),
    starter:false, seasonStats:{},
  };
}

/* AI teams also raid the portal so it drains realistically */
function aiPortalRaid(){
  G.portal.filter(e=>!e.committed).forEach(e=>{
    if(rng()<0.55){
      const suitor=pick(G.teams.filter(t=>t.id!==G.myTeamId && t.nilBudget>=e.ask*0.8));
      if(suitor){
        e.committed=suitor.id;
        const p=makeSignedPlayer(e);
        if(suitor.roster.length<CONFIG.ROSTER_LIMIT) suitor.roster.push(p);
      }
    }
  });
}

console.log('DYNASTY HC portal loaded');
</script>
<script>
/* ---------------------------------------------------------------------------
   SECTION X — CAREER SCREEN · RETIREMENT/HALL OF FAME · WORLD SCREEN
   --------------------------------------------------------------------------- */
SCREENS.career = function(root){
  const c=G.coach, t=myTeam(), exp=G.adExpectation, ct=G.contract;
  // only fold the current season into totals while it's actually in progress
  // (after the carousel banks it into careerWins, the team record lingers until next startSeason)
  const inSeason = ['preseason','regular','confchamp','playoff','bowls'].includes(G.phase);
  const liveW = c.careerWins + (inSeason ? (t.w||0) : 0);
  const liveL = c.careerLosses + (inSeason ? (t.l||0) : 0);
  const winPct = (liveW+liveL)>0 ? (liveW/(liveW+liveL)*100).toFixed(1) : '0.0';
  const showSeasonTag = inSeason && (t.w||t.l);
  const secLabel=jobSecurityLabel(G.jobSecurity);
  const secColor=jobSecurityColor(G.jobSecurity);

  root.innerHTML=`
    <div class="card mb10">
      <div class="row gap8">
        ${myCoachAvatar(52)}
        <div style="flex:1">
          <div class="display lg" style="line-height:1">${c.name}</div>
          <div class="mut sm">${c.archName} · age ${c.age} · Rep ${Math.round(c.rep)}</div>
          <div class="row wrap gap6 mt6">${c.traits.map(tr=>`<span class="chip xs">${traitName(tr)}</span>`).join('')}</div>
        </div>
        <div class="tc" style="display:flex;flex-direction:column;align-items:center;min-width:64px">
          <div class="ovr lg" style="background:conic-gradient(${ovrColor(c.rating||55)} ${Math.round((c.rating||55)*3.6)}deg, var(--line) 0)"><div style="position:absolute;inset:3px;border-radius:50%;background:var(--panel);display:flex;align-items:center;justify-content:center;font-size:18px">${Math.round(c.rating||55)}</div></div>
          <div class="mut xs mt6">COACH RATING</div>
          ${c.lastRatingDelta?`<div class="xs b" style="color:${c.lastRatingDelta>0?'var(--green)':'var(--red)'}">${c.lastRatingDelta>0?'▲ +'+c.lastRatingDelta:'▼ '+c.lastRatingDelta} last game</div>`:''}
        </div>
      </div>
    </div>

    <div class="card mb10">
      <div class="row between mb6"><b>Job Security</b><span class="chip" style="background:${secColor}22;color:${secColor};border-color:${secColor}">${secLabel}</span></div>
      <div class="meter"><div style="width:${G.jobSecurity}%;background:${secColor}"></div></div>
      <div class="mut xs mt6">AD expects: "${exp?exp.goal:'—'}" (${exp?exp.wins:'?'}+ wins)</div>
    </div>

    <div class="card mb10">
      <div class="mut xs mb6">CURRENT CONTRACT — ${t.name}</div>
      <div class="grid3 gap6">
        <div class="statbox"><div class="v">$${ct?ct.salary:'?'}M</div><div class="l">Salary/yr</div></div>
        <div class="statbox"><div class="v">${ct?ct.yearsLeft:'?'}</div><div class="l">Yrs Left</div></div>
        <div class="statbox"><div class="v">$${ct?ct.buyout:'?'}M</div><div class="l">Buyout</div></div>
      </div>
      <div class="mut xs mt6">${c.yearsAtJob} season(s) at ${t.short}</div>
    </div>

    <div class="card mb10">
      <div class="row between mb6"><div class="mut xs">CAREER RESUME</div>${showSeasonTag?`<div class="mut xs" style="color:var(--accent2)">incl. ${G.year}: ${t.w}-${t.l}</div>`:''}</div>
      <div class="grid3 gap6 mb6">
        <div class="statbox"><div class="v">${liveW}-${liveL}</div><div class="l">Record</div></div>
        <div class="statbox"><div class="v">${winPct}%</div><div class="l">Win %</div></div>
        <div class="statbox"><div class="v" style="color:var(--accent2)">${c.natTitles}</div><div class="l">Nat'l Titles</div></div>
      </div>
      <div class="grid3 gap6">
        <div class="statbox"><div class="v">${c.confTitles}</div><div class="l">Conf Titles</div></div>
        <div class="statbox"><div class="v">${c.playoffApps}</div><div class="l">Playoff Apps</div></div>
        <div class="statbox"><div class="v">${c.nflDraftees}</div><div class="l">NFL Draftees</div></div>
      </div>
    </div>

    ${c.coachingTree && c.coachingTree.length?`
    <div class="card mb10">
      <div class="mut xs mb6">COACHING TREE</div>
      ${c.coachingTree.map(a=>`<div class="row between sm"><span>${a.name}</span><span class="mut">${a.job||'HC'}</span></div>`).join('')}
    </div>`:''}

    <div class="card mb10">
      <div class="mut xs mb6">JOBS HELD</div>
      ${G.careerLog.map((j,i)=>`<div class="row between sm" style="padding:3px 0">
        <span>${i+1}. ${j.team}</span><span class="mut">since ${j.startYear}</span></div>`).join('')}
    </div>

    <div class="card mb10">
      <div class="mut xs mb6">SEASON HISTORY</div>
      ${G.history.length?G.history.slice().reverse().map(h=>`<div class="row between sm" style="padding:3px 0">
        <span>${h.year} · ${h.myTeam} <b>${h.myRecord}</b></span><span class="mut">Champ: ${h.champ}</span></div>`).join('')
        :'<div class="mut sm">No completed seasons yet.</div>'}
    </div>

    <button class="btn outline full" onclick="confirmRetire()">🎓 Retire from Coaching</button>
  `;
};

function jobSecurityLabel(s){ return s<25?'Safe':s<45?'Stable':s<65?'Warm':s<82?'Hot Seat':'On the Brink'; }
function jobSecurityColor(s){ return s<25?'#3ad07a':s<45?'#7ad03a':s<65?'#ffb01f':s<82?'#ff7a1f':'#ff3b3b'; }
function traitName(id){ const tr=COACH_TRAITS.find(x=>x.id===id); return tr?tr.name:id; }

function confirmRetire(){
  modal(`
    <h3 style="margin:0 0 8px">Retire?</h3>
    <div class="mut sm mb14">End your coaching career and review your legacy. This cannot be undone in this save.</div>
    <button class="btn full mb6" onclick="closeModal();retireScreen('retired')">Confirm Retirement</button>
    <button class="btn ghost full" onclick="closeModal()">Keep Coaching</button>
  `);
}

function retireScreen(how){
  const c=G.coach;
  c.retired=true;
  const winPct=(c.careerWins+c.careerLosses)>0?(c.careerWins/(c.careerWins+c.careerLosses)*100).toFixed(1):'0.0';
  // Hall of Fame grade
  let score = c.natTitles*30 + c.confTitles*8 + c.playoffApps*5 + c.careerWins*0.5 + c.nflDraftees*1.5 + parseFloat(winPct)*0.3;
  let tier, blurb;
  if(score>=220){ tier='🏛️ FIRST-BALLOT HALL OF FAMER'; blurb='An all-time legend. Your name belongs on the building.'; }
  else if(score>=140){ tier='⭐ HALL OF FAME'; blurb='A decorated career that defined an era.'; }
  else if(score>=80){ tier='🏅 RESPECTED VETERAN'; blurb='A long, solid career with real highlights.'; }
  else if(score>=35){ tier='📋 JOURNEYMAN'; blurb='You made your mark, job to job.'; }
  else { tier='🚪 SHORT-LIVED'; blurb=how==='fired'?'The carousel claimed you early.':'A brief run on the sidelines.'; }

  const t=teamById(G.myTeamId)||{colors:['#ff5a1f','#ffb01f'],short:'—'};
  cutscene(`linear-gradient(160deg,#0a0e14,#13243b)`,`
    <div style="animation:fadeIn 1s">
      <div class="display" style="font-size:13px;letter-spacing:5px;color:var(--accent2)">CAREER COMPLETE</div>
      <div class="display" style="font-size:30px;margin:10px 0">${c.name}</div>
      <div class="display" style="font-size:20px;color:var(--accent);margin-bottom:18px">${tier}</div>
      <div class="mut sm" style="max-width:320px;margin:0 auto 20px">${blurb}</div>
      <div class="card" style="text-align:left;max-width:340px;margin:0 auto">
        <div class="row between sm"><span class="mut">Career record</span><b>${c.careerWins}-${c.careerLosses} (${winPct}%)</b></div>
        <div class="row between sm"><span class="mut">National titles</span><b>${c.natTitles}</b></div>
        <div class="row between sm"><span class="mut">Conference titles</span><b>${c.confTitles}</b></div>
        <div class="row between sm"><span class="mut">Playoff appearances</span><b>${c.playoffApps}</b></div>
        <div class="row between sm"><span class="mut">NFL draftees developed</span><b>${c.nflDraftees}</b></div>
        <div class="row between sm"><span class="mut">Seasons coached</span><b>${c.seasonsCoached}</b></div>
        <div class="row between sm"><span class="mut">Schools</span><b>${G.careerLog.length}</b></div>
      </div>
      <button class="btn lg mt20" onclick="newCareerFromRetire()">Start a New Career →</button>
    </div>`);
  if(c.natTitles>0||score>=140) spawnConfetti();
  save();
}
function newCareerFromRetire(){
  closeCut();
  wipeSave();
  location.reload();
}

/* ---------------------------------------------------------------------------
   WORLD SCREEN — polls · standings · news · conferences · coaches
   --------------------------------------------------------------------------- */
let WORLDF='poll';
SCREENS.world = function(root){
  root.innerHTML=`
    <div class="card mb10"><div class="display lg">THE LANDSCAPE</div><div class="mut sm">${G.year} · Week ${G.week} · ${G.phase}</div></div>
    <div class="tabs mb10">
      ${[['poll','Top 25'],['conf','Conferences'],['leaders','Stat Leaders'],['coaches','Coaches'],['teams','Edit Teams'],['news','News']].map(([v,l])=>
        `<button class="${WORLDF===v?'active':''}" onclick="WORLDF='${v}';SCREENS.world($('#screen'))">${l}</button>`).join('')}
    </div>
    <div id="world-body">${worldBody()}</div>
  `;
};
function worldBody(){
  if(WORLDF==='poll') return pollHTML();
  if(WORLDF==='conf') return confStandingsHTML();
  if(WORLDF==='leaders') return statLeadersHTML();
  if(WORLDF==='coaches') return coachesHTML();
  if(WORLDF==='teams') return teamsEditorHTML();
  if(WORLDF==='news') return newsFullHTML();
  return '';
}
function pollHTML(){
  const poll=(G.cfpRank&&G.cfpRank.length?G.cfpRank:G.apPoll)||[];
  if(!poll.length) return '<div class="card center mut">Polls release once the season starts.</div>';
  const usingCfp=G.cfpRank&&G.cfpRank.length;
  return `<div class="mut xs mb6">${usingCfp?'CFP COMMITTEE RANKING':'AP TOP 25'}</div>`+
    poll.slice(0,25).map((tid,i)=>{
      const t=teamById(tid); if(!t) return '';
      const mine=tid===G.myTeamId;
      return `<div class="li" style="${mine?'border-color:var(--accent)':''}" onclick="openTeamInfo('${tid}')">
        <div class="center" style="min-width:30px"><b class="${i<4?'gold':''}">${i+1}</b></div>
        ${teamBadge(t,32)}
        <div style="flex:1"><b>${t.short}</b> ${mine?'<span class="chip accent xs">YOU</span>':''}<div class="mut xs">${t.w}-${t.l} · ${t.confName}</div></div>
        <div class="mut sm">${t.abbr}</div>
      </div>`;
    }).join('');
}
function confStandingsHTML(){
  return CONFERENCES.map(c=>{
    const teams=G.teams.filter(t=>t.conf===c.id).sort((a,b)=>(b.cw-b.cl)-(a.cw-a.cl)||(b.w-b.l)-(a.w-a.l));
    if(!teams.length) return '';
    return `<div class="card tight mb6">
      <div class="row between mb6"><b>${c.name}</b><span class="chip xs ${c.tier==='P4'?'gold':''}">${c.tier}</span></div>
      ${teams.slice(0,8).map(t=>`<div class="row between sm" style="padding:2px 0;${t.id===G.myTeamId?'color:var(--accent)':''}" onclick="openTeamInfo('${t.id}')">
        <span>${t.short}</span><span class="mut">${t.cw}-${t.cl} (${t.w}-${t.l})</span></div>`).join('')}
    </div>`;
  }).join('');
}
/* ---------------------------------------------------------------------------
   STAT LEADERS — national leaderboards for every tracked stat.
   --------------------------------------------------------------------------- */
let LEADERCAT='passYds';
const LEADER_CATS=[
  {group:'Passing', items:[
    {k:'passYds',label:'Passing Yards',fmt:v=>v+' yds'},
    {k:'passTD',label:'Passing TDs',fmt:v=>v+' TD'},
    {k:'passComp',label:'Completions',fmt:v=>v},
    {k:'int',label:'Interceptions Thrown',fmt:v=>v,asc:false},
  ]},
  {group:'Rushing', items:[
    {k:'rushYds',label:'Rushing Yards',fmt:v=>v+' yds'},
    {k:'rushTD',label:'Rushing TDs',fmt:v=>v+' TD'},
    {k:'rushAtt',label:'Carries',fmt:v=>v},
  ]},
  {group:'Receiving', items:[
    {k:'recYds',label:'Receiving Yards',fmt:v=>v+' yds'},
    {k:'rec',label:'Receptions',fmt:v=>v},
    {k:'recTD',label:'Receiving TDs',fmt:v=>v+' TD'},
  ]},
  {group:'Defense', items:[
    {k:'tackles',label:'Tackles',fmt:v=>v},
    {k:'sacks',label:'Sacks',fmt:v=>v},
    {k:'tfl',label:'Tackles for Loss',fmt:v=>v},
    {k:'intDef',label:'Interceptions',fmt:v=>v},
    {k:'pbu',label:'Pass Breakups',fmt:v=>v},
    {k:'ff',label:'Forced Fumbles',fmt:v=>v},
  ]},
  {group:'Kicking & Scoring', items:[
    {k:'kpts',label:'Kicking Points',fmt:v=>v+' pts'},
    {k:'fgm',label:'Field Goals Made',fmt:v=>v},
    {k:'allTD',label:'Total Touchdowns',fmt:v=>v+' TD',derive:s=>(s.passTD||0)+(s.rushTD||0)+(s.recTD||0)},
  ]},
];
function leaderCatDef(k){ for(const g of LEADER_CATS){ const it=g.items.find(i=>i.k===k); if(it) return it; } return LEADER_CATS[0].items[0]; }

function statLeadersHTML(){
  const def=leaderCatDef(LEADERCAT);
  // gather every player with this stat
  const rows=[];
  G.teams.forEach(t=>{
    t.roster.forEach(p=>{
      const s=p.seasonStats||{};
      const val = def.derive ? def.derive(s) : (s[LEADERCAT]||0);
      if(val>0) rows.push({p,t,val});
    });
  });
  rows.sort((a,b)=> b.val-a.val);
  const top=rows.slice(0,40);
  const myTeamId=G.myTeamId;

  const catBtns=LEADER_CATS.map(g=>`
    <div class="mut xs mt10 mb4" style="letter-spacing:1px">${g.group.toUpperCase()}</div>
    <div class="row wrap gap6">
      ${g.items.map(it=>`<button class="chip ${LEADERCAT===it.k?'accent':''}" style="cursor:pointer;border:none" onclick="LEADERCAT='${it.k}';document.getElementById('world-body').innerHTML=statLeadersHTML()">${it.label}</button>`).join('')}
    </div>`).join('');

  const list = top.length ? top.map((row,i)=>{
    const mine=row.t.id===myTeamId;
    const s=row.p.seasonStats||{};
    const gp=s.gp||1;
    const perG = (def.k==='passYds'||def.k==='rushYds'||def.k==='recYds') ? ` · ${Math.round(row.val/gp)}/g` : '';
    return `<div class="li" onclick="openLeaderPlayer('${row.t.id}','${row.p.id}')" style="${mine?'border-color:var(--accent)':''}">
      <div class="b" style="min-width:26px;text-align:center;color:${i<3?'var(--accent2)':'var(--txt2)'}">${i+1}</div>
      ${playerAvatar(row.p,40)}
      <div style="flex:1;min-width:0">
        <div class="row gap6"><b style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${row.p.name}</b>${mine?'<span class="chip accent xs">YOU</span>':''}</div>
        <div class="mut xs">${row.p.pos} · ${row.t.short} · ${row.p.year}${perG}</div>
      </div>
      <div class="b" style="color:var(--accent2);text-align:right;min-width:64px">${def.fmt(row.val)}</div>
    </div>`;
  }).join('') : '<div class="card center mut">No stats recorded yet. Play some games!</div>';

  return `
    <div class="card tight mb10">
      <div class="display b" style="font-size:16px">${def.label} — National Leaders</div>
      <div class="mut xs mt2">${G.year} season · top 40</div>
      ${catBtns}
    </div>
    ${list}
  `;
}
function openLeaderPlayer(tid,pid){
  // open the player's detail; if it's my team use the normal modal, else a read-only view
  const t=teamById(tid); if(!t) return;
  const p=t.roster.find(x=>x.id===pid); if(!p) return;
  if(tid===G.myTeamId){ openPlayer(pid); return; }
  modal(`
    <div class="row gap8 mb10">
      ${playerAvatar(p,60)}
      <div><div class="display lg" style="line-height:1">${p.name}</div>
        <div class="mut sm">${p.pos} · ${p.year} · ${p.archetype}</div>
        <div class="mut sm">${teamBadge(t,18)} ${t.name} · ${starHTML(p.stars)}</div>
      </div>
    </div>
    <div class="grid3 gap6 mb10">
      <div class="statbox"><div class="b lg">${p.ovr}</div><div class="mut xs">OVR</div></div>
      <div class="statbox"><div class="b lg">${p.ceiling}</div><div class="mut xs">CEILING</div></div>
      <div class="statbox"><div class="b lg">${t.short}</div><div class="mut xs">TEAM</div></div>
    </div>
    ${seasonStatsHTML(p)}
    <button class="btn ghost full" onclick="closeModal()">Close</button>
  `);
}

function coachesHTML(){
  const coaches=G.teams.map(t=>({t,c:t.coach})).filter(x=>x.c)
    .sort((a,b)=>(b.c.rep||0)-(a.c.rep||0)).slice(0,25);
  return `<div class="mut xs mb6">TOP COACHES BY REPUTATION</div>`+
    `<div class="li" style="border-color:var(--accent)">
      <div class="center" style="min-width:30px"><b>★</b></div>
      ${myCoachAvatar(32)}
      <div style="flex:1"><b>${G.coach.name}</b> <span class="chip accent xs">YOU</span><div class="mut xs">${myTeam().short} · ${G.coach.careerWins}-${G.coach.careerLosses}</div></div>
      <b>${Math.round(G.coach.rep)}</b>
    </div>`+
    coaches.map((x,i)=>`<div class="li" onclick="openTeamInfo('${x.t.id}')">
      <div class="center" style="min-width:30px">${i+1}</div>
      ${coachBadge(x.c.name,x.t.colors,32)}
      <div style="flex:1"><b>${x.c.name}</b><div class="mut xs">${x.t.short} · ${x.c.wins||0} career W</div></div>
      <b>${Math.round(x.c.rep||50)}</b>
    </div>`).join('');
}
let TEAMED_Q='';
function teamsEditorHTML(){
  let teams=G.teams.slice();
  if(TEAMED_Q){ const q=TEAMED_Q.toLowerCase(); teams=teams.filter(t=>t.name.toLowerCase().includes(q)||t.confName.toLowerCase().includes(q)||t.short.toLowerCase().includes(q)); }
  // group by conference for sane ordering
  teams.sort((a,b)=> a.confName.localeCompare(b.confName) || b.prestige-a.prestige);
  const rows = teams.slice(0,140).map(t=>{
    const me = t.id===G.myTeamId;
    return `<div class="li" onclick="openTeamEdit('${t.id}')">
      ${teamBadge(t,36)}
      <div style="flex:1;min-width:0">
        <div class="row gap6"><b style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${t.name}</b>${me?'<span class="chip accent xs">YOU</span>':''}</div>
        <div class="mut xs">${t.confName} · ${t.tier}</div>
      </div>
      <span class="ic">✏️</span>
    </div>`;
  }).join('');
  return `
    <div class="card tight mb10">
      <div class="mut sm">Rename and recolor any team to build the world your way. Edits save with your career.</div>
      <button class="btn outline full sm mt10" onclick="openBulkImport()">📋 Bulk Import (paste a list)</button>
    </div>
    <input class="searchbar mb10" placeholder="Search teams or conferences…" value="${TEAMED_Q}"
      oninput="TEAMED_Q=this.value;clearTimeout(window._teq);window._teq=setTimeout(()=>{document.getElementById('world-body').innerHTML=teamsEditorHTML();},250)">
    ${rows||'<div class="card center mut">No teams match.</div>'}
  `;
}

function openTeamEdit(tid){
  const t=teamById(tid); if(!t) return;
  modal(`
    <div class="row gap8 mb10">
      <div id="teEditBadge">${teamBadge(t,52)}</div>
      <div><div class="display lg" style="line-height:1">Edit Team</div><div class="mut sm">${t.confName} · ${t.tier}</div></div>
    </div>
    <h2 class="sec" style="margin-top:6px">Full Name</h2>
    <input class="searchbar" id="teName" value="${escAttr(t.name)}" placeholder="e.g. Georgia Bulldogs">
    <div class="grid2 gap6 mt10">
      <div><div class="mut xs mb6">SHORT NAME</div><input class="searchbar" id="teShort" value="${escAttr(t.short)}" placeholder="Georgia"></div>
      <div><div class="mut xs mb6">ABBREVIATION</div><input class="searchbar" id="teAbbr" value="${escAttr(t.abbr)}" maxlength="4" placeholder="UGA"></div>
    </div>
    <div class="grid2 gap6 mt10">
      <div><div class="mut xs mb6">PRIMARY COLOR</div><input type="color" id="teC1" value="${t.colors[0]}" style="width:100%;height:40px;border-radius:10px;border:1px solid var(--line);background:var(--panel2)"></div>
      <div><div class="mut xs mb6">SECONDARY COLOR</div><input type="color" id="teC2" value="${t.colors[1]}" style="width:100%;height:40px;border-radius:10px;border:1px solid var(--line);background:var(--panel2)"></div>
    </div>
    <button class="btn full lg mt14" onclick="saveTeamEdit('${tid}')">Save Changes</button>
    <button class="btn ghost full mt6" onclick="closeModal()">Cancel</button>
  `);
  // live badge preview
  const upd=()=>{
    const name=$('#teName').value, abbr=$('#teAbbr').value, c1=$('#teC1').value, c2=$('#teC2').value;
    const b=$('#teEditBadge');
    if(b) b.innerHTML=`<div class="av" style="width:52px;height:52px;font-size:18px;background:${c1};color:${c2}">${(abbr||name.slice(0,3)).toUpperCase()}</div>`;
  };
  ['teName','teAbbr','teC1','teC2'].forEach(id=>{ const e=$('#'+id); if(e) e.oninput=upd; });
}
function escAttr(s){ return String(s||'').replace(/"/g,'&quot;'); }

function saveTeamEdit(tid){
  const t=teamById(tid); if(!t) return;
  const name=$('#teName').value.trim();
  const short=$('#teShort').value.trim();
  const abbr=$('#teAbbr').value.trim().toUpperCase();
  const c1=$('#teC1').value, c2=$('#teC2').value;
  if(!name){ toast('Name cannot be empty'); return; }
  t.name=name;
  t.short=short||name;
  t.abbr=(abbr||name.slice(0,3)).toUpperCase().slice(0,4);
  t.colors=[c1,c2];
  // keep city/masc roughly in sync for any code that reads them
  const parts=name.split(' ');
  t.masc=parts.length>1?parts[parts.length-1]:t.masc;
  t.city=parts.length>1?parts.slice(0,-1).join(' '):name;
  save();
  closeModal();
  toast(`Updated ${t.short}`);
  if(CURRENT==='world'){ document.getElementById('world-body').innerHTML=teamsEditorHTML(); }
}

function openBulkImport(){
  modal(`
    <div class="display lg mb6">Bulk Import Teams</div>
    <div class="mut sm mb10">Paste one team per line. Format (commas):<br>
    <b>Full Name, Short, ABBR, #primary, #secondary</b><br>
    Only the full name is required. Lines fill teams in order, grouped by conference (highest-prestige first). Example:</div>
    <div class="subcard mb10 sm" style="font-family:monospace;white-space:pre-wrap">Georgia Bulldogs, Georgia, UGA, #BA0C2F, #000000
Alabama Crimson Tide, Alabama, BAMA, #9E1B32, #FFFFFF
Ohio State Buckeyes, Ohio St, OSU, #BB0000, #666666</div>
    <textarea class="searchbar" id="bulkBox" style="height:160px;font-family:monospace;font-size:12px" placeholder="Paste your team list here…"></textarea>
    <div class="mut xs mt6">Tip: leave a field blank to keep it auto-generated. You can also scope to one conference below.</div>
    <select class="sel full mt6" id="bulkConf">
      <option value="ALL">Apply across ALL teams (by overall prestige order)</option>
      ${CONFERENCES.map(c=>`<option value="${c.id}">Only ${c.name} (${G.teams.filter(t=>t.conf===c.id).length} teams)</option>`).join('')}
    </select>
    <button class="btn full lg mt14" onclick="doBulkImport()">Apply Import</button>
    <button class="btn ghost full mt6" onclick="closeModal()">Cancel</button>
  `);
}
function doBulkImport(){
  const raw=$('#bulkBox').value.trim();
  const scope=$('#bulkConf').value;
  if(!raw){ toast('Paste some teams first'); return; }
  const lines=raw.split('\n').map(l=>l.trim()).filter(Boolean);
  // target teams, ordered by prestige (so your #1 line lands on the best program in scope)
  let targets = scope==='ALL' ? G.teams.slice() : G.teams.filter(t=>t.conf===scope);
  targets.sort((a,b)=> b.prestige-a.prestige);
  let applied=0;
  lines.forEach((line,i)=>{
    if(i>=targets.length) return;
    const parts=line.split(',').map(s=>s.trim());
    const t=targets[i];
    const name=parts[0];
    if(!name) return;
    t.name=name;
    t.short=parts[1]||name;
    t.abbr=(parts[2]||name.slice(0,3)).toUpperCase().slice(0,4);
    if(parts[3]&&/^#?[0-9a-fA-F]{6}$/.test(parts[3])) t.colors[0]=parts[3].startsWith('#')?parts[3]:'#'+parts[3];
    if(parts[4]&&/^#?[0-9a-fA-F]{6}$/.test(parts[4])) t.colors[1]=parts[4].startsWith('#')?parts[4]:'#'+parts[4];
    const np=name.split(' ');
    t.masc=np.length>1?np[np.length-1]:t.masc;
    t.city=np.length>1?np.slice(0,-1).join(' '):name;
    applied++;
  });
  save();
  closeModal();
  toast(`Imported ${applied} team${applied!==1?'s':''}`);
  if(CURRENT==='world'){ document.getElementById('world-body').innerHTML=teamsEditorHTML(); }
}

function newsFullHTML(){
  if(!G.news.length) return '<div class="card center mut">No news yet.</div>';
  return G.news.slice(0,40).map(n=>`<div class="news ${n.type}">
    <div class="nh">${n.headline}</div><div class="nb">${n.body}</div>
    <div class="mut xs mt6">${n.year} · Wk ${n.week}</div></div>`).join('');
}
function openTeamInfo(tid){
  const t=teamById(tid); if(!t) return;
  const str=teamStrength(t);
  const rank=rankOf(tid);
  modal(`
    <div class="row gap8 mb10">
      ${teamBadge(t,52)}
      <div><div class="display lg" style="line-height:1">${t.name}</div>
      <div class="mut sm">${t.confName} · ${t.tier} ${rank?`· #${rank}`:''}</div>
      <div class="mut sm">HC: ${t.coach?t.coach.name:'—'}</div></div>
    </div>
    <div class="grid3 gap6 mb10">
      <div class="statbox"><div class="v">${t.w}-${t.l}</div><div class="l">Record</div></div>
      <div class="statbox"><div class="v" style="color:${ovrColor(str.overall)}">${str.overall}</div><div class="l">Team OVR</div></div>
      <div class="statbox"><div class="v">${t.prestige}</div><div class="l">Prestige</div></div>
    </div>
    <div class="subcard">
      <div class="row between sm"><span class="mut">Conf record</span><b>${t.cw}-${t.cl}</b></div>
      <div class="row between sm"><span class="mut">NIL strength</span><b>${t.nilStrength}</b></div>
      <div class="row between sm"><span class="mut">Facilities</span><b>${t.facilities}</b></div>
      <div class="row between sm"><span class="mut">Capacity</span><b>${t.capacity.toLocaleString()}</b></div>
      <div class="row between sm"><span class="mut">Roster</span><b>${t.roster.length}</b></div>
    </div>
  `);
}

console.log('DYNASTY HC career + world screens loaded');

/* ---------------------------------------------------------------------------
   BOOT — run on load: resume an existing save, otherwise show the title
   --------------------------------------------------------------------------- */
/* ---------------------------------------------------------------------------
   DAY / NIGHT — picks an atmosphere from the real local clock and paints the
   sky behind the app. Period also tints the chrome via body.tod-* classes.
   --------------------------------------------------------------------------- */
function currentPeriod(){
  const h=new Date().getHours();
  if(h>=5 && h<8)  return 'dawn';
  if(h>=8 && h<17) return 'day';
  if(h>=17 && h<20)return 'dusk';
  return 'night';
}
const SKY = {
  dawn:  { grad:'linear-gradient(180deg,#2a3a6b 0%,#6b5a8a 32%,#d98a6a 62%,#f4b97a 100%)',
           glow:'radial-gradient(circle at 78% 20%, rgba(255,200,140,.55), transparent 55%)', glowOp:.9,
           orb:{x:'78%',y:'15%',size:64,color:'#ffd9a0',glow:'0 0 50px 12px rgba(255,200,140,.55)'}, stars:0 },
  day:   { grad:'linear-gradient(180deg,#3a7bd5 0%,#5a9fe0 45%,#9cc6ef 100%)',
           glow:'radial-gradient(circle at 72% 14%, rgba(255,245,200,.7), transparent 50%)', glowOp:1,
           orb:{x:'74%',y:'12%',size:70,color:'#fff6c8',glow:'0 0 60px 18px rgba(255,240,170,.65)'}, stars:0 },
  dusk:  { grad:'linear-gradient(180deg,#23204a 0%,#5b3a6b 38%,#b14a5a 68%,#e8804a 100%)',
           glow:'radial-gradient(circle at 24% 22%, rgba(255,140,90,.5), transparent 55%)', glowOp:.85,
           orb:{x:'22%',y:'18%',size:60,color:'#ff9a5a',glow:'0 0 50px 14px rgba(255,130,70,.55)'}, stars:8 },
  night: { grad:'linear-gradient(180deg,#05060f 0%,#0a1024 45%,#101a33 100%)',
           glow:'radial-gradient(circle at 80% 16%, rgba(150,170,255,.18), transparent 55%)', glowOp:.7,
           orb:{x:'80%',y:'14%',size:46,color:'#e6ecff',glow:'0 0 34px 8px rgba(200,215,255,.35)'}, stars:40 },
};
function applyTimeOfDay(){
  const p=currentPeriod();
  document.body.classList.remove('tod-dawn','tod-day','tod-dusk','tod-night');
  document.body.classList.add('tod-'+p);
  const cfg=SKY[p];
  const sky=document.getElementById('sky'), glow=document.getElementById('skyglow');
  if(sky) sky.style.background=cfg.grad;
  if(glow){ glow.style.background=cfg.glow; glow.style.opacity=cfg.glowOp; }
  // remove old celestials/stars
  document.querySelectorAll('.celestial,.star').forEach(e=>e.remove());
  // sun/moon orb
  const orb=document.createElement('div');
  orb.className='celestial';
  orb.style.left=cfg.orb.x; orb.style.top=cfg.orb.y;
  orb.style.width=cfg.orb.size+'px'; orb.style.height=cfg.orb.size+'px';
  orb.style.background=cfg.orb.color; orb.style.boxShadow=cfg.orb.glow;
  if(p==='night'){ // moon crater shading
    orb.style.background='radial-gradient(circle at 38% 38%, #f2f5ff, #c9d2ea)';
  }
  document.body.appendChild(orb);
  // stars at night/dusk
  for(let i=0;i<cfg.stars;i++){
    const s=document.createElement('div');
    s.className='star';
    const sz=Math.random()<0.2?2.4:1.4;
    s.style.width=sz+'px'; s.style.height=sz+'px';
    s.style.left=(Math.random()*100)+'%';
    s.style.top=(Math.random()*45)+'%';
    s.style.animationDelay=(Math.random()*4)+'s';
    document.body.appendChild(s);
  }
}

function boot(){
  applyTimeOfDay();
  setInterval(applyTimeOfDay, 5*60*1000); // re-check every 5 min so dusk→night etc. updates live
  try{
    if(hasSave() && load()){
      renderTopbar(); renderNav();
      go(G.phase==='preseason'||G.phase==='offseason'||G.phase==='regular'||!CURRENT?'hub':CURRENT);
    } else {
      showTitle();
    }
  }catch(e){
    console.error('Boot error, showing title:', e);
    showTitle();
  }
}
if(document.readyState==='loading'){
  document.addEventListener('DOMContentLoaded', boot);
} else {
  boot();
}
</script>
</body>
</html>
